---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import FinanceDashboard from '../../components/interactive/FinanceDashboard';
import TradeTimingExplorer from '../../components/interactive/TradeTimingExplorer';
import CongressPortfolioChart from '../../components/interactive/CongressPortfolioChart';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import {
  buildFinanceOverview,
  buildFlaggedMemberRows,
  buildSectorAggregates,
  buildTickerAggregates,
  flattenTickerTrades,
} from '../../../shared/finance-aggregate.mjs';
import { buildSuspiciousTradeCandidates } from '../../../shared/trade-timing.mjs';
import { createTimingAttacher } from '../../../shared/timing-precompute.mjs';
import { loadDataJSON } from '../../../shared/data-loader.mjs';
import { buildCongressPortfolioSeries, BENCHMARK_LABEL } from '../../../shared/portfolio-series.mjs';
import { createPriceCacheReader, decodePriceSeries, BENCHMARK_TICKER } from '../../../shared/price-cache.mjs';

function loadJSON(path: string) {
  const fullPath = join(process.cwd(), 'data', path);
  if (!existsSync(fullPath)) return null;
  try {
    return JSON.parse(readFileSync(fullPath, 'utf-8'));
  } catch {
    return null;
  }
}

const financeData = loadJSON('finances/by-member.json');
const membersIndex = loadJSON('members/index.json')?.members || [];
const base = import.meta.env.BASE_URL;

const overview = financeData
  ? buildFinanceOverview(financeData)
  : {
      totalMembers: 0,
      membersWithTrades: 0,
      totalTrades: 0,
      highSeverityFlags: 0,
      mediumSeverityFlags: 0,
      overlapTrades: 0,
      lastUpdated: null,
      source: null,
    };

const flaggedMembers = financeData ? buildFlaggedMemberRows(financeData, membersIndex) : [];
const sectors = financeData ? buildSectorAggregates(financeData) : [];
const tickers = financeData ? buildTickerAggregates(financeData) : [];
const trades = financeData ? flattenTickerTrades(financeData) : [];

const billsIndex = loadJSON('bills/index.json')?.bills || [];
const billsBySponsor: Record<string, any[]> = {};
for (const bill of billsIndex) {
  const id = bill.sponsor?.bioguideId;
  if (!id) continue;
  if (!billsBySponsor[id]) billsBySponsor[id] = [];
  billsBySponsor[id].push(bill);
}

const attachTiming = createTimingAttacher(loadDataJSON);
const timingCandidates = financeData
  ? buildSuspiciousTradeCandidates(financeData, { limit: 15, billsBySponsor }).map(attachTiming)
  : [];

// Aggregate counterfactual: all disclosed purchases vs S&P 500 vs cash vs
// committee-overlap trades. Prices come from the build-time cache.
let congressPortfolio: any = null;
if (financeData && trades.length > 0) {
  const readPriceCache = createPriceCacheReader(loadDataJSON);
  const decoded = new Map<string, any>();
  const getSeries = (ticker: string) => {
    if (!decoded.has(ticker)) decoded.set(ticker, decodePriceSeries(readPriceCache(ticker)));
    const rows = decoded.get(ticker);
    return rows?.length ? rows : null;
  };
  const built = buildCongressPortfolioSeries(trades, getSeries, {
    benchmarkTicker: BENCHMARK_TICKER,
    names: Object.fromEntries(
      (membersIndex as { bioguideId: string; name: string }[]).map((m) => [m.bioguideId, m.name]),
    ),
    profiles: Object.fromEntries(
      (membersIndex as { bioguideId: string; chamber?: string; party?: string }[]).map((m) => [
        m.bioguideId,
        { chamber: m.chamber || '', party: m.party || '' },
      ]),
    ),
  });
  if (built.ok) congressPortfolio = built;
}

// The dashboard's own sections carry these ids; see FinanceDashboard.
const pageSections = [
  { id: 'congress-portfolio', label: 'Congress vs. the Market', when: congressPortfolio },
  { id: 'trade-timing', label: 'Trade Timing Insights', when: financeData, count: timingCandidates.length },
  { id: 'trading-overview', label: 'Trading Overview', when: financeData },
  { id: 'flagged-members', label: 'Committee Overlap Flags', when: financeData, count: flaggedMembers.length },
  { id: 'trading-by-sector', label: 'Trading by Sector', when: financeData, count: sectors.length },
  { id: 'most-traded-stocks', label: 'Most Traded Stocks', when: financeData, count: tickers.length },
  { id: 'individual-trades', label: 'Individual Trades', when: financeData, count: trades.length },
];
---

<Layout
  title="Congressional Stock Trading"
  description="Aggregate and individual congressional stock trades with committee overlap analysis — potential insider-information conflicts."
>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <PageIndex sections={pageSections} />

    <div class="pb-5 border-b border-ink">
      <p class="eyebrow mb-3">Financial records</p>
      <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">Congressional stock trading</h1>
      <p class="text-[14px] leading-[1.6] text-ink-2 max-w-prose mt-3">
        Aggregate trading activity and individual disclosures across Congress.
        The chart below compares holding cash, trading every disclosed purchase, putting
        the same money in the S&amp;P 500, and trading only in sectors a member&apos;s
        committee oversees. Trades highlighted are that committee overlap —
        a signal worth scrutiny, not proof of wrongdoing.
      </p>
    </div>

    {!financeData ? (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No finance data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run <code class="font-mono text-[12px] bg-rule-2 px-[5px] py-[2px] rounded">npm run fetch:finances</code> to populate trading data.</p>
      </div>
    ) : (
      <>
        {congressPortfolio && (
          <section id="congress-portfolio" data-page-section class="pt-8">
            <CongressPortfolioChart
              portfolio={congressPortfolio}
              benchmarkLabel={BENCHMARK_LABEL}
              baseUrl={base}
              client:load
            />
          </section>
        )}

        <section id="trade-timing" data-page-section class="pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-1">Trade timing insights</h2>
          <p class="text-[12.5px] text-ink-3 mb-4 max-w-prose">
            Compare each flagged trade to alternative timing (30 days earlier/later) and a
            <strong class="text-ink font-semibold"> do nothing </strong> baseline — stay in cash if they didn&apos;t buy, or keep holding if they didn&apos;t sell.
            Each panel includes committee, disclosure, and legislative context.
          </p>
          <TradeTimingExplorer candidates={timingCandidates} baseUrl={base} client:load />
        </section>

        <FinanceDashboard
          overview={overview}
          flaggedMembers={flaggedMembers}
          sectors={sectors}
          tickers={tickers}
          trades={trades}
          baseUrl={base}
          client:load
        />
      </>
    )}
  </div>
</Layout>
