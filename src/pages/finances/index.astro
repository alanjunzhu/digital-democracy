---
import Layout from '../../components/layout/Layout.astro';
import FinanceDashboard from '../../components/interactive/FinanceDashboard';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import {
  buildFinanceOverview,
  buildFlaggedMemberRows,
  buildSectorAggregates,
  buildTickerAggregates,
  flattenTickerTrades,
} from '../../../shared/finance-aggregate.mjs';

function loadJSON(path: string) {
  const fullPath = join(process.cwd(), 'data', path);
  if (!existsSync(fullPath)) return null;
  try {
    return JSON.parse(readFileSync(fullPath, 'utf-8'));
  } catch {
    return null;
  }
}

const financeData = loadJSON('finances/by-member.json');
const membersIndex = loadJSON('members/index.json')?.members || [];
const base = import.meta.env.BASE_URL;

const overview = financeData
  ? buildFinanceOverview(financeData)
  : {
      totalMembers: 0,
      membersWithTrades: 0,
      totalTrades: 0,
      highSeverityFlags: 0,
      mediumSeverityFlags: 0,
      overlapTrades: 0,
      lastUpdated: null,
      source: null,
    };

const flaggedMembers = financeData ? buildFlaggedMemberRows(financeData, membersIndex) : [];
const sectors = financeData ? buildSectorAggregates(financeData) : [];
const tickers = financeData ? buildTickerAggregates(financeData) : [];
const trades = financeData ? flattenTickerTrades(financeData) : [];
---

<Layout
  title="Congressional Stock Trading"
  description="Aggregate and individual congressional stock trades with committee overlap analysis — potential insider-information conflicts."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Congressional Stock Trading</h1>
      <p class="text-gray-500 mt-1 max-w-3xl">
        Aggregate trading activity and individual disclosures across Congress.
        Trades highlighted in red overlap with sectors related to a member&apos;s committee assignments —
        a signal worth scrutiny, not proof of wrongdoing.
      </p>
    </div>

    {!financeData ? (
      <div class="text-center py-16 text-gray-500">
        <p class="text-lg">No finance data available yet.</p>
        <p class="mt-2 text-sm">Run <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">npm run fetch:finances</code> to populate trading data.</p>
      </div>
    ) : (
      <FinanceDashboard
        overview={overview}
        flaggedMembers={flaggedMembers}
        sectors={sectors}
        tickers={tickers}
        trades={trades}
        baseUrl={base}
        client:load
      />
    )}
  </div>
</Layout>
