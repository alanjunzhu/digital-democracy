---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { BillDetail, CommitteeSummary } from '../../lib/types';
import { getBillStage, STAGE_COLORS, BILL_STAGES } from '../../lib/utils';
import { buildCommitteeLookup, normalizeBillCommittees, resolveCommittee } from '../../lib/committees';
import { getBillTextWebUrl, getBillWebUrl } from '../../../shared/congress-urls.mjs';

export function getStaticPaths() {
  const billsDir = join(process.cwd(), 'data', 'bills');
  const paths: { params: { billId: string } }[] = [];

  if (existsSync(billsDir)) {
    const files = readdirSync(billsDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const billId = file.replace('.json', '');
      paths.push({ params: { billId } });
    }
  }

  return paths;
}

const { billId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'bills', `${billId}.json`);
const bill: BillDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const partyColor = (p: string) => {
  if (p === 'D') return 'text-dem';
  if (p === 'R') return 'text-rep';
  return 'text-ind';
};

const billStage = getBillStage(bill.latestAction);

// Build progress pipeline
const progressStages = ['Introduced', 'In Committee', 'Passed One Chamber', 'Passed Both Chambers', 'Signed into Law'] as const;
const currentIndex = progressStages.indexOf(billStage as (typeof progressStages)[number]);

// Cross-link: find votes on this bill, including how the sponsor voted
let billVotes: any[] = [];
try {
  const votesPath = join(process.cwd(), 'data', 'votes', 'index.json');
  if (existsSync(votesPath)) {
    const votesData = JSON.parse(readFileSync(votesPath, 'utf-8'));
    const sponsorId = bill.sponsor?.bioguideId;
    billVotes = (votesData.votes || [])
      .filter((v: any) => v.billId === billId)
      .map((v: any) => {
        let sponsorVote = '';
        const votePath = join(process.cwd(), 'data', 'votes', `${v.voteId}.json`);
        if (sponsorId && existsSync(votePath)) {
          const detail = JSON.parse(readFileSync(votePath, 'utf-8'));
          const mv = (detail.memberVotes || []).find((m: any) => m.bioguideId === sponsorId);
          if (mv?.voteCast) sponsorVote = mv.voteCast;
        }
        return { ...v, sponsorVote };
      });
  }
} catch {}

// Cross-link committee referrals to committee pages. Resolved by systemCode
// so a Senate referral cannot land on the same-named House committee.
let committees: { name: string; committee: CommitteeSummary | null }[] = [];
try {
  const committeesPath = join(process.cwd(), 'data', 'committees', 'index.json');
  const committeeList: CommitteeSummary[] = existsSync(committeesPath)
    ? JSON.parse(readFileSync(committeesPath, 'utf-8')).committees || []
    : [];
  const lookup = buildCommitteeLookup(committeeList);
  committees = normalizeBillCommittees(bill.committees).map(ref => ({
    name: ref.name,
    committee: resolveCommittee(ref, lookup, bill.originChamber),
  }));
} catch {}

// Built from congress/type/number rather than read from the stored record:
// resolutions live under their own congress.gov path, not /house-bill/.
const congressGovUrl = getBillWebUrl(bill.congress, bill.type, bill.number);
const congressGovTextUrl = getBillTextWebUrl(bill.congress, bill.type, bill.number);

const pageSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'summary', label: 'Summary', when: bill.summary },
  { id: 'latest-action', label: 'Latest Action', when: bill.latestAction },
  { id: 'committees', label: 'Committees', when: committees.length, count: committees.length },
  { id: 'subjects', label: 'Subjects', when: bill.subjects?.length, count: bill.subjects?.length },
  { id: 'roll-call-votes', label: 'Roll Call Votes', when: billVotes.length, count: billVotes.length },
  { id: 'action-history', label: 'Action History', when: bill.actions?.length, count: bill.actions?.length },
];
---

<Layout title={`${bill.type} ${bill.number}`} description={bill.title}>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <PageIndex sections={pageSections} />

    <a href={`${base}bills/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3 hover:text-accent">
      &larr; All bills
    </a>

    <!-- Header -->
    <div id="overview" data-page-section class="mt-4 pb-5 border-b border-ink">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="font-mono text-[18px] font-medium text-accent">{bill.type} {bill.number}</span>
        <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">{bill.originChamber}</span>
        <span class="inline-flex items-center gap-[7px] font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink border border-ink-3 rounded px-2 py-1">
          <span class={`w-[5px] h-[5px] rounded-full shrink-0 ${STAGE_COLORS[billStage].dot}`} />
          {billStage}
        </span>
        {bill.policyArea && (
          <span class="text-[11.5px] text-ink-2 border border-rule rounded px-[7px] py-[2px]">
            {bill.policyArea}
          </span>
        )}
      </div>
      <h1 class="font-serif text-[32px] leading-[1.15] font-medium text-pretty mb-5">{bill.title}</h1>

      <!-- Facts rail -->
      <div class="flex flex-wrap gap-x-8 gap-y-2 text-[13px] text-ink-2 mb-4">
        {bill.sponsor && (
          <div>
            <span class="text-ink-3">Sponsor</span>{' '}
            <a href={`${base}members/${bill.sponsor.bioguideId}/`} class="font-semibold text-ink hover:text-accent">
              {bill.sponsor.name}
            </a>
            {bill.sponsor.party && (
              <span class={`ml-1 font-semibold ${partyColor(bill.sponsor.party)}`}>({bill.sponsor.party})</span>
            )}
          </div>
        )}
        {bill.introducedDate && (
          <div><span class="text-ink-3">Introduced</span> <span class="font-mono tabular">{bill.introducedDate}</span></div>
        )}
        <div><span class="text-ink-3">Cosponsors</span> <span class="font-mono tabular">{bill.cosponsors}</span></div>
      </div>

      <div class="flex gap-5">
        {congressGovUrl && (
          <a href={congressGovUrl} target="_blank" rel="noopener" class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline">
            Congress.gov
          </a>
        )}
        {congressGovTextUrl && (
          <a href={congressGovTextUrl} target="_blank" rel="noopener" class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline">
            Full text
          </a>
        )}
      </div>
    </div>

    <!-- Stage tracker -->
    <div class="flex items-center gap-1 py-5 border-b border-rule overflow-x-auto">
      {progressStages.map((s, i) => {
        const isPast = i < currentIndex || (i === currentIndex && billStage !== 'Vetoed');
        const isCurrent = billStage === s;
        return (
          <div class="flex items-center shrink-0">
            {i > 0 && <div class={`w-6 sm:w-10 h-px ${isPast ? 'bg-ink' : 'bg-rule'}`} />}
            <div class={`flex items-center gap-[6px] font-mono text-[10.5px] tracking-[0.04em] uppercase whitespace-nowrap ${isCurrent ? 'text-ink font-semibold' : isPast ? 'text-ink-2' : 'text-ink-3'}`}>
              <span class={`w-[6px] h-[6px] rounded-full shrink-0 ${isPast ? 'bg-ink' : 'bg-rule'}`} />
              {s}
            </div>
          </div>
        );
      })}
      {billStage === 'Vetoed' && (
        <div class="flex items-center shrink-0">
          <div class="w-6 sm:w-10 h-px bg-accent" />
          <div class="flex items-center gap-[6px] font-mono text-[10.5px] tracking-[0.04em] uppercase text-accent font-semibold whitespace-nowrap">
            <span class="w-[6px] h-[6px] rounded-full bg-accent shrink-0" />
            Vetoed
          </div>
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
      <!-- Summary -->
      {bill.summary && (
        <div id="summary" data-page-section class="md:col-span-2 pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Summary</h2>
          <div class="text-[14.5px] leading-[1.65] text-ink-2 prose-sm max-w-prose" set:html={bill.summary} />
        </div>
      )}

      <!-- Latest Action -->
      {bill.latestAction && (
        <div id="latest-action" data-page-section class="pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Latest action</h2>
          <p class="text-[14px] leading-[1.6] text-ink-2">{bill.latestAction}</p>
          {bill.latestActionDate && (
            <p class="font-mono text-[11px] text-ink-3 mt-2">{bill.latestActionDate}</p>
          )}
        </div>
      )}

      <!-- Committees -->
      {committees.length > 0 && (
        <div id="committees" data-page-section class="pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Committee referrals</h2>
          <div>
            {committees.map(({ name, committee }) => (
              <div class="flex items-center gap-3 py-[10px] border-b border-rule last:border-0">
                {committee ? (
                  <a href={`${base}committees/${committee.systemCode}/`} class="text-[13.5px] text-ink hover:text-accent">{name}</a>
                ) : <span class="text-[13.5px] text-ink">{name}</span>}
                {committee?.chamber && (
                  <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3 ml-auto">{committee.chamber}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Subjects -->
      {bill.subjects && bill.subjects.length > 0 && (
        <div id="subjects" data-page-section class="pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Subjects</h2>
          <div class="flex flex-wrap gap-2">
            {bill.subjects.map(s => (
              <span class="text-[11.5px] text-ink-2 border border-rule rounded px-[7px] py-[2px]">
                {s}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Votes on This Bill -->
      {billVotes.length > 0 && (
        <div id="roll-call-votes" data-page-section class="md:col-span-2 pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">
            Roll call votes <span class="font-mono text-[11px] text-ink-3 tabular">{billVotes.length}</span>
          </h2>
          <div>
            {billVotes.map((v: any) => {
              const agreed = v.result === 'Passed' || v.result === 'Agreed to';
              const total = v.totalYea + v.totalNay;
              const yeaPct = total > 0 ? Math.round((v.totalYea / total) * 100) : 50;
              const castLower = String(v.sponsorVote || '').toLowerCase();
              const sponsorTone = ['yea', 'aye'].includes(castLower) ? 'text-yea' : ['nay', 'no'].includes(castLower) ? 'text-accent' : 'text-ink-2';
              return (
                <a href={`${base}votes/${v.voteId}/`} class="grid grid-cols-[minmax(0,1fr)_150px] gap-6 items-start py-4 border-b border-rule hover:border-ink-3">
                  <div class="min-w-0">
                    <p class="text-[14px] leading-[1.4] text-ink line-clamp-1">{v.question}</p>
                    <div class="flex items-center gap-3 mt-[6px]">
                      <span class="font-mono text-[11px] text-ink-3">{v.date}</span>
                      <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">{v.chamber}</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class={`font-mono text-[10.5px] font-semibold tracking-[0.05em] uppercase ${agreed ? 'text-yea' : 'text-accent'}`}>
                        {agreed ? 'Agreed' : 'Rejected'}
                      </span>
                      <span class="font-mono text-[12px] text-ink-2 tabular">{v.totalYea}&ndash;{v.totalNay}</span>
                    </div>
                    <div class="flex h-1 bg-rule mt-[6px]">
                      <div class="h-full bg-yea" style={`width: ${yeaPct}%`}></div>
                      <div class="h-full bg-accent" style={`width: ${100 - yeaPct}%`}></div>
                    </div>
                    {v.sponsorVote && (
                      <div class={`font-mono text-[10.5px] mt-[6px] ${sponsorTone}`}>
                        Sponsor: {v.sponsorVote}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Action History -->
      {bill.actions && bill.actions.length > 0 && (
        <div id="action-history" data-page-section class="md:col-span-2 pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Action history</h2>
          <div>
            {bill.actions.map(a => (
              <div class="flex items-start gap-4 py-[10px] border-b border-rule last:border-0">
                <span class="font-mono text-[11px] text-ink-3 whitespace-nowrap min-w-[86px] tabular">{a.date}</span>
                <span class="text-[13px] leading-[1.5] text-ink-2">{a.text}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
