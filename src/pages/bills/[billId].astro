---
import Layout from '../../components/layout/Layout.astro';
import ChamberBadge from '../../components/shared/ChamberBadge.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { BillDetail, CommitteeSummary } from '../../lib/types';
import { getBillStage, STAGE_COLORS, BILL_STAGES } from '../../lib/utils';
import { buildCommitteeLookup, normalizeBillCommittees, resolveCommittee } from '../../lib/committees';
import { getBillTextWebUrl, getBillWebUrl } from '../../../shared/congress-urls.mjs';

export function getStaticPaths() {
  const billsDir = join(process.cwd(), 'data', 'bills');
  const paths: { params: { billId: string } }[] = [];

  if (existsSync(billsDir)) {
    const files = readdirSync(billsDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const billId = file.replace('.json', '');
      paths.push({ params: { billId } });
    }
  }

  return paths;
}

const { billId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'bills', `${billId}.json`);
const bill: BillDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const partyColor = (p: string) => {
  if (p === 'D') return 'text-blue-700';
  if (p === 'R') return 'text-red-700';
  return 'text-purple-700';
};

const billStage = getBillStage(bill.latestAction);
const stageColor = STAGE_COLORS[billStage];

// Build progress pipeline
const stageIndex = BILL_STAGES.indexOf(billStage);
const progressStages = ['Introduced', 'In Committee', 'Passed One Chamber', 'Passed Both Chambers', 'Signed into Law'] as const;

// Cross-link: find votes on this bill
let billVotes: any[] = [];
try {
  const votesPath = join(process.cwd(), 'data', 'votes', 'index.json');
  if (existsSync(votesPath)) {
    const votesData = JSON.parse(readFileSync(votesPath, 'utf-8'));
    billVotes = (votesData.votes || []).filter((v: any) => v.billId === billId);
  }
} catch {}

// Cross-link committee referrals to committee pages. Resolved by systemCode
// so a Senate referral cannot land on the same-named House committee.
let committees: { name: string; committee: CommitteeSummary | null }[] = [];
try {
  const committeesPath = join(process.cwd(), 'data', 'committees', 'index.json');
  const committeeList: CommitteeSummary[] = existsSync(committeesPath)
    ? JSON.parse(readFileSync(committeesPath, 'utf-8')).committees || []
    : [];
  const lookup = buildCommitteeLookup(committeeList);
  committees = normalizeBillCommittees(bill.committees).map(ref => ({
    name: ref.name,
    committee: resolveCommittee(ref, lookup, bill.originChamber),
  }));
} catch {}

// Built from congress/type/number rather than read from the stored record:
// resolutions live under their own congress.gov path, not /house-bill/.
const congressGovUrl = getBillWebUrl(bill.congress, bill.type, bill.number);
const congressGovTextUrl = getBillTextWebUrl(bill.congress, bill.type, bill.number);
---

<Layout title={`${bill.type} ${bill.number}`} description={bill.title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back link -->
    <a href={`${base}bills/`} class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">
      &larr; All Bills
    </a>

    <!-- Bill Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center gap-3 mb-3">
        <span class="font-mono text-lg font-bold text-blue-700">{bill.type} {bill.number}</span>
        <ChamberBadge chamber={bill.originChamber} />
        <span class={`inline-flex items-center rounded-full text-xs px-2.5 py-1 font-semibold ${stageColor.bg} ${stageColor.text}`}>
          {billStage}
        </span>
        {bill.policyArea && (
          <span class="inline-flex items-center rounded-full text-xs px-2 py-0.5 bg-gray-100 text-gray-600">
            {bill.policyArea}
          </span>
        )}
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-4">{bill.title}</h1>

      {/* Legislative Progress Pipeline */}
      <div class="flex items-center gap-1 mb-4 overflow-x-auto pb-1">
        {progressStages.map((s, i) => {
          const isActive = BILL_STAGES.indexOf(billStage) >= BILL_STAGES.indexOf(s);
          const isCurrent = billStage === s;
          const sc = STAGE_COLORS[s];
          return (
            <div class="flex items-center">
              {i > 0 && (
                <div class={`w-4 sm:w-8 h-0.5 ${isActive ? sc.dot : 'bg-gray-200'}`} />
              )}
              <div class={`flex items-center gap-1 px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium whitespace-nowrap ${
                isCurrent ? `${sc.bg} ${sc.text} ring-2 ring-offset-1 ring-current` :
                isActive ? `${sc.bg} ${sc.text}` : 'bg-gray-100 text-gray-400'
              }`}>
                <span class={`w-1.5 h-1.5 rounded-full ${isActive ? sc.dot : 'bg-gray-300'}`}></span>
                {s}
              </div>
            </div>
          );
        })}
        {billStage === 'Vetoed' && (
          <div class="flex items-center">
            <div class="w-4 sm:w-8 h-0.5 bg-red-400" />
            <div class="flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 ring-2 ring-offset-1 ring-current whitespace-nowrap">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
              Vetoed
            </div>
          </div>
        )}
      </div>

      <div class="flex flex-wrap gap-6 text-sm text-gray-600">
        {bill.sponsor && (
          <div>
            <span class="text-gray-400">Sponsor:</span>{' '}
            <a href={`${base}members/${bill.sponsor.bioguideId}/`} class="text-blue-600 hover:underline font-medium">
              {bill.sponsor.name}
            </a>
            {bill.sponsor.party && (
              <span class={`ml-1 ${partyColor(bill.sponsor.party)}`}>({bill.sponsor.party})</span>
            )}
          </div>
        )}
        {bill.introducedDate && (
          <div>
            <span class="text-gray-400">Introduced:</span> {bill.introducedDate}
          </div>
        )}
        <div>
          <span class="text-gray-400">Cosponsors:</span> {bill.cosponsors}
        </div>
      </div>

      <div class="flex gap-4 mt-4 text-sm">
        {congressGovUrl && (
          <a href={congressGovUrl} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
            Congress.gov
          </a>
        )}
        {congressGovTextUrl && (
          <a href={congressGovTextUrl} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
            Full Text
          </a>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Summary -->
      {bill.summary && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 md:col-span-2">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Summary</h2>
          <div class="text-sm text-gray-700 prose prose-sm max-w-none" set:html={bill.summary} />
        </div>
      )}

      <!-- Latest Action -->
      {bill.latestAction && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Latest Action</h2>
          <p class="text-sm text-gray-700">{bill.latestAction}</p>
          {bill.latestActionDate && (
            <p class="text-xs text-gray-400 mt-1">{bill.latestActionDate}</p>
          )}
        </div>
      )}

      <!-- Committees -->
      {committees.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Committees</h2>
          <ul class="space-y-1 text-sm text-gray-700">
            {committees.map(({ name, committee }) => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                {committee ? (
                  <a href={`${base}committees/${committee.systemCode}/`} class="text-blue-600 hover:underline">{name}</a>
                ) : name}
                {committee?.chamber && (
                  <span class="text-xs text-gray-400">{committee.chamber}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Subjects -->
      {bill.subjects && bill.subjects.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Subjects</h2>
          <div class="flex flex-wrap gap-2">
            {bill.subjects.map(s => (
              <span class="inline-flex items-center rounded-full text-xs px-2 py-1 bg-blue-50 text-blue-700">
                {s}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Votes on This Bill -->
      {billVotes.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 md:col-span-2">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Roll Call Votes ({billVotes.length})</h2>
          <div class="space-y-2">
            {billVotes.map((v: any) => {
              const passed = v.result === 'Passed' || v.result === 'Agreed to';
              return (
                <a href={`${base}votes/${v.voteId}/`} class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 border border-gray-100">
                  <div class={`w-2 h-2 rounded-full ${passed ? 'bg-green-500' : 'bg-red-500'}`}></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-gray-900 line-clamp-1">{v.question}</p>
                    <div class="flex items-center gap-3 mt-0.5 text-xs text-gray-500">
                      <span>{v.date}</span>
                      <span class={`inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium ${v.chamber === 'Senate' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
                        {v.chamber}
                      </span>
                    </div>
                  </div>
                  <div class="text-right text-xs">
                    <span class={`font-semibold ${passed ? 'text-green-600' : 'text-red-600'}`}>{v.result}</span>
                    <div class="text-gray-400 mt-0.5">{v.totalYea}Y - {v.totalNay}N</div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Action History -->
      {bill.actions && bill.actions.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 md:col-span-2">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Action History</h2>
          <div class="space-y-2 text-sm">
            {bill.actions.map(a => (
              <div class="flex items-start gap-3 py-1.5 border-b border-gray-100 last:border-0">
                <span class="text-gray-400 whitespace-nowrap min-w-[90px]">{a.date}</span>
                <span class="text-gray-700">{a.text}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
