---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Bills" description="Browse bills introduced in the US Congress.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Bills</h1>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
      <p class="text-gray-500 text-lg">Bills tracking coming soon.</p>
      <p class="text-gray-400 text-sm mt-2">This section will include searchable bills, status tracking, and sponsor information.</p>
    </div>
  </div>
</Layout>
