---
import Layout from '../components/layout/Layout.astro';
import AnalyticsDashboard from '../components/interactive/AnalyticsDashboard';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import {
  averageAlignmentByParty,
  rankPartyAlignment,
  summarizePartyLineVotes,
} from '../lib/party-alignment';
import { getVoteOutcome } from '../lib/utils';
import { loadRecountedBreakdowns } from '../../shared/policy-data.mjs';

function loadJSON(path: string) {
  try { return JSON.parse(readFileSync(join(process.cwd(), 'data', path), 'utf-8')); }
  catch { return null; }
}

const membersIndex = loadJSON('members/index.json') || { members: [], total: 0 };
const billsIndex = loadJSON('bills/index.json') || { bills: [], total: 0 };
const votesIndex = loadJSON('votes/index.json') || { votes: [], total: 0 };
const committeesIndex = loadJSON('committees/index.json') || { committees: [], total: 0 };
const byMemberVotes = loadJSON('votes/by-member.json')?.members || {};

// Member stats
const members = membersIndex.members;
const stateCount: Record<string, { count: number; democratic: number; republican: number }> = {};
for (const m of members) {
  const bucket = stateCount[m.state] || (stateCount[m.state] = { count: 0, democratic: 0, republican: 0 });
  bucket.count++;
  if (m.party === 'Democratic') bucket.democratic++;
  if (m.party === 'Republican') bucket.republican++;
}
const stateBreakdown = Object.entries(stateCount)
  .map(([state, b]) => ({ state, count: b.count, democratic: b.democratic, republican: b.republican }))
  .sort((a, b) => b.count - a.count);

const memberStats = {
  total: membersIndex.total || members.length,
  senate: members.filter((m: any) => m.chamber === 'Senate').length,
  house: members.filter((m: any) => m.chamber === 'House').length,
  democratic: members.filter((m: any) => m.party === 'Democratic').length,
  republican: members.filter((m: any) => m.party === 'Republican').length,
  independent: members.filter((m: any) => m.party === 'Independent').length,
  stateBreakdown,
};

// Bill stats
const bills = billsIndex.bills;
const policyCount: Record<string, number> = {};
const chamberCount: Record<string, number> = {};
for (const b of bills) {
  if (b.policyArea) policyCount[b.policyArea] = (policyCount[b.policyArea] || 0) + 1;
  chamberCount[b.originChamber] = (chamberCount[b.originChamber] || 0) + 1;
}

const billStats = {
  total: billsIndex.total || bills.length,
  byPolicyArea: Object.entries(policyCount).map(([area, count]) => ({ area, count })).sort((a, b) => b.count - a.count),
  byChamber: Object.entries(chamberCount).map(([chamber, count]) => ({ chamber, count })).sort((a, b) => b.count - a.count),
  recentActivity: [],
};

// Vote stats + party alignment
const votes = votesIndex.votes || [];
const passed = votes.filter((v: any) => getVoteOutcome(v.result) === 'agreed').length;
const failed = votes.filter((v: any) => getVoteOutcome(v.result) === 'rejected').length;
const totalYea = votes.reduce((sum: number, v: any) => sum + (v.totalYea || 0), 0);
const totalNay = votes.reduce((sum: number, v: any) => sum + (v.totalNay || 0), 0);

// The stored partyBreakdown files every House member under `democratic` and
// leaves `republican` at zero, so no House roll call can ever register a
// D-vs-R split — which rendered as a flat "House 0% (0/501)" party-line rate
// and dropped most House members out of the alignment ranking entirely.
// Recount from the individual casts, exactly as the member profile does.
const recountedBreakdowns = loadRecountedBreakdowns();

const voteBreakdownById: Record<string, any> = {};
for (const v of votes) {
  const breakdown = recountedBreakdowns[v.voteId] || v.partyBreakdown;
  if (v.voteId && breakdown) voteBreakdownById[v.voteId] = breakdown;
}

const partyLine = summarizePartyLineVotes(
  votes.map((v: any) => ({ ...v, partyBreakdown: voteBreakdownById[v.voteId] || v.partyBreakdown })),
);
const houseLoyalists = rankPartyAlignment(members, byMemberVotes, voteBreakdownById, { chamber: 'House', limit: 8 });
const senateLoyalists = rankPartyAlignment(members, byMemberVotes, voteBreakdownById, { chamber: 'Senate', limit: 8 });
const houseRebels = rankPartyAlignment(members, byMemberVotes, voteBreakdownById, { chamber: 'House', limit: 8, order: 'asc' });
const senateRebels = rankPartyAlignment(members, byMemberVotes, voteBreakdownById, { chamber: 'Senate', limit: 8, order: 'asc' });
const allRanked = rankPartyAlignment(members, byMemberVotes, voteBreakdownById, { limit: 600 });
const avgByParty = averageAlignmentByParty(allRanked);

const voteStats = {
  total: votesIndex.total || votes.length,
  passed,
  failed,
  partyLineVotes: partyLine.partyLine,
  partyLinePct: partyLine.pct,
  partyLineByChamber: partyLine.byChamber,
  avgYea: votes.length > 0 ? Math.round(totalYea / votes.length) : 0,
  avgNay: votes.length > 0 ? Math.round(totalNay / votes.length) : 0,
  houseLoyalists,
  senateLoyalists,
  houseRebels,
  senateRebels,
  avgByParty,
};

// Committee stats
const committees = committeesIndex.committees;
const committeeStats = {
  total: committeesIndex.total || committees.length,
  house: committees.filter((c: any) => c.chamber === 'House').length,
  senate: committees.filter((c: any) => c.chamber === 'Senate').length,
  joint: committees.filter((c: any) => c.chamber === 'Joint').length,
};

const base = import.meta.env.BASE_URL;
---

<Layout title="Analytics" description="Data visualizations and insights about the US Congress, including party-line votes and voting alignment.">
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="pb-5 border-b border-ink">
      <p class="eyebrow mb-3">Analysis</p>
      <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">Analytics</h1>
      <p class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3 mt-3">
        {membersIndex.congress || 119}th Congress
        {existsSync(join(process.cwd(), 'data', 'votes', 'by-member.json')) && (
          <span> &middot; party alignment from {Object.keys(byMemberVotes).length} voting records</span>
        )}
      </p>
    </div>

    <AnalyticsDashboard
      memberStats={memberStats}
      billStats={billStats}
      voteStats={voteStats}
      committeeStats={committeeStats}
      baseUrl={base}
      client:load
    />
  </div>
</Layout>
