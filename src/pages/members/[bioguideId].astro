---
import Layout from '../../components/layout/Layout.astro';
import PartyBadge from '../../components/shared/PartyBadge.astro';
import ChamberBadge from '../../components/shared/ChamberBadge.astro';
import MemberVoteRow from '../../components/shared/MemberVoteRow.astro';
import MemberTradeRow from '../../components/shared/MemberTradeRow.astro';
import MemberFilingRow from '../../components/shared/MemberFilingRow.astro';
import ExpandableTradeList from '../../components/shared/ExpandableTradeList.astro';
import { tickerQuoteUrl } from '../../../shared/finance-sources.mjs';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import { formatState, formatDate, getBillStage, STAGE_COLORS, BILL_STAGES } from '../../lib/utils';
import type { MemberDetail } from '../../lib/types';
import { partitionFinanceTrades } from '../../../scripts/fetch-finances.mjs';
import { scoreMemberPartyAlignment } from '../../lib/party-alignment';
import { enrichMemberVotes, summariesByVoteId } from '../../../shared/vote-member-index.mjs';

export function getStaticPaths() {
  const membersDir = join(process.cwd(), 'data', 'members');
  const paths: { params: { bioguideId: string } }[] = [];

  if (existsSync(membersDir)) {
    const files = readdirSync(membersDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const bioguideId = file.replace('.json', '');
      paths.push({ params: { bioguideId } });
    }
  }

  return paths;
}

const { bioguideId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'members', `${bioguideId}.json`);
const member: MemberDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const districtLabel = member.chamber === 'House' && member.district
  ? `, District ${member.district}`
  : '';

function localBillExists(id: string) {
  return existsSync(join(process.cwd(), 'data', 'bills', `${id}.json`));
}

function billLink(billId: string) {
  const local = localBillExists(billId);
  return {
    local,
    href: `${base}bills/${billId}/`,
  };
}

function withStage(bills: any[]) {
  return bills.map((b: any) => ({ ...b, stage: getBillStage(b.latestAction) }));
}

// Prefer the member's own sponsored-legislation list (filled by fetch-members).
// Overlay the 500 recently-updated bills when we have a richer local record.
let sponsoredBills: any[] = [];
let billsByStage: Record<string, any[]> = {};
try {
  const stored = Array.isArray(member.sponsoredBills) ? member.sponsoredBills : [];
  let indexById: Record<string, any> = {};
  const billsIndexPath = join(process.cwd(), 'data', 'bills', 'index.json');
  if (existsSync(billsIndexPath)) {
    const billsIndex = JSON.parse(readFileSync(billsIndexPath, 'utf-8'));
    for (const b of billsIndex.bills || []) {
      if (b.billId) indexById[b.billId] = b;
    }
  }
  if (stored.length > 0) {
    sponsoredBills = withStage(stored.map((b: any) => indexById[b.billId] ? { ...b, ...indexById[b.billId] } : b));
  } else {
    sponsoredBills = withStage(
      Object.values(indexById).filter((b: any) => b.sponsor?.bioguideId === bioguideId)
    );
  }

  for (const b of sponsoredBills) {
    if (!billsByStage[b.stage]) billsByStage[b.stage] = [];
    billsByStage[b.stage].push(b);
  }
} catch {}

// Cross-link: find votes for this specific member
let memberVotes: any[] = [];
let voteStats = { total: 0, yea: 0, nay: 0, notVoting: 0, present: 0 };
try {
  const byMemberPath = join(process.cwd(), 'data', 'votes', 'by-member.json');
  const votesIndexPath = join(process.cwd(), 'data', 'votes', 'index.json');
  if (existsSync(byMemberPath) && existsSync(votesIndexPath)) {
    const byMemberData = JSON.parse(readFileSync(byMemberPath, 'utf-8'));
    const votesIndex = JSON.parse(readFileSync(votesIndexPath, 'utf-8'));
    const summaryById = summariesByVoteId(votesIndex.votes || []);
    const myVotes = enrichMemberVotes(byMemberData.members?.[bioguideId] || [], summaryById);
    memberVotes = myVotes.sort((a: any, b: any) => {
      if (a.date !== b.date) return b.date.localeCompare(a.date);
      return b.rollCallNumber - a.rollCallNumber;
    });
    voteStats.total = memberVotes.length;
    for (const v of memberVotes) {
      const cast = (v.voteCast || '').toLowerCase();
      if (cast === 'yea' || cast === 'aye') voteStats.yea++;
      else if (cast === 'nay' || cast === 'no') voteStats.nay++;
      else if (cast === 'not voting') voteStats.notVoting++;
      else if (cast === 'present') voteStats.present++;
    }
  }
} catch {}

// Party alignment: join this member's votes to each roll call's party breakdown
let partyAlignment: { comparable: number; withParty: number; againstParty: number; pct: number | null } = {
  comparable: 0,
  withParty: 0,
  againstParty: 0,
  pct: null,
};
try {
  const votesIndexPath = join(process.cwd(), 'data', 'votes', 'index.json');
  if (existsSync(votesIndexPath) && memberVotes.length > 0) {
    const votesIndex = JSON.parse(readFileSync(votesIndexPath, 'utf-8'));
    const breakdownById: Record<string, any> = {};
    for (const v of votesIndex.votes || []) {
      if (v.voteId && v.partyBreakdown) breakdownById[v.voteId] = v.partyBreakdown;
    }
    partyAlignment = scoreMemberPartyAlignment(memberVotes, breakdownById, member.party);
  }
} catch {}

// Cross-link: committee assignments (from member data or committees index)
let memberCommittees: string[] = [];
let committeeLinks: Record<string, string> = {};
try {
  const committeesPath = join(process.cwd(), 'data', 'committees', 'index.json');
  if (existsSync(committeesPath)) {
    const committeesData = JSON.parse(readFileSync(committeesPath, 'utf-8'));
    // Build name -> systemCode lookup
    for (const c of committeesData.committees || []) {
      if (c.name && c.systemCode) committeeLinks[c.name] = c.systemCode;
    }
  }
  // First try from member's own data
  if (member.committees && member.committees.length > 0) {
    memberCommittees = member.committees;
  }
} catch {}

// Cross-link: financial data (stock trades + conflict analysis)
let financeProfile: any = null;
let stockTrades: any[] = [];
let ptrFilings: any[] = [];
let conflictFlags: any[] = [];
let sectorBreakdown: any[] = [];
try {
  const financePath = join(process.cwd(), 'data', 'finances', 'by-member.json');
  if (existsSync(financePath)) {
    const financeData = JSON.parse(readFileSync(financePath, 'utf-8'));
    financeProfile = financeData.members?.[bioguideId];
    if (financeProfile) {
      const partitioned = partitionFinanceTrades(financeProfile.trades || []);
      stockTrades = partitioned.tickerTrades;
      ptrFilings = partitioned.filings;
      conflictFlags = financeProfile.flags || [];
      sectorBreakdown = financeProfile.summary?.topSectors || [];
      // Override committees with finance-provided ones if available (more accurate)
      if (financeProfile.committees && financeProfile.committees.length > 0) {
        memberCommittees = financeProfile.committees;
      }
    }
  }
} catch {}

const tradesBySector: Record<string, any[]> = {};
for (const t of stockTrades) {
  const sector = t.sector || 'Other';
  if (!tradesBySector[sector]) tradesBySector[sector] = [];
  tradesBySector[sector].push(t);
}
const sectorTradeOrder = Object.keys(tradesBySector).sort(
  (a, b) => (tradesBySector[b]?.length || 0) - (tradesBySector[a]?.length || 0)
);

const tradesByTicker: Record<string, any[]> = {};
for (const t of stockTrades) {
  if (!t.ticker || t.ticker === '--') continue;
  if (!tradesByTicker[t.ticker]) tradesByTicker[t.ticker] = [];
  tradesByTicker[t.ticker].push(t);
}
const topTickers = Object.entries(tradesByTicker)
  .sort(([, a], [, b]) => b.length - a.length)
  .slice(0, 15);

// Group votes by topic for categorized display
let votesByTopic: Record<string, any[]> = {};
const topicOrder: string[] = [];
for (const v of memberVotes) {
  const topic = v.topic || 'Other';
  if (!votesByTopic[topic]) {
    votesByTopic[topic] = [];
    topicOrder.push(topic);
  }
  votesByTopic[topic].push(v);
}
// Sort topics by vote count descending, but keep "Procedural" and "Other" last
topicOrder.sort((a, b) => {
  if (a === 'Procedural' || a === 'Other') return 1;
  if (b === 'Procedural' || b === 'Other') return -1;
  return (votesByTopic[b]?.length || 0) - (votesByTopic[a]?.length || 0);
});

// Topic color mapping
const TOPIC_COLORS: Record<string, string> = {
  'Immigration': 'bg-orange-100 text-orange-800',
  'Armed Forces and National Security': 'bg-slate-100 text-slate-800',
  'Health': 'bg-pink-100 text-pink-800',
  'Taxation': 'bg-emerald-100 text-emerald-800',
  'Economics and Public Finance': 'bg-green-100 text-green-800',
  'Education': 'bg-violet-100 text-violet-800',
  'Energy': 'bg-amber-100 text-amber-800',
  'Environmental Protection': 'bg-teal-100 text-teal-800',
  'Crime and Law Enforcement': 'bg-red-100 text-red-800',
  'International Affairs': 'bg-sky-100 text-sky-800',
  'Transportation and Public Works': 'bg-cyan-100 text-cyan-800',
  'Nominations': 'bg-indigo-100 text-indigo-800',
  'Procedural': 'bg-gray-100 text-gray-600',
  'Other': 'bg-gray-100 text-gray-600',
};

// Stage display order
const stageOrder = [...BILL_STAGES, 'Other'] as const;
---

<Layout title={member.name} description={`${member.name} - ${member.party} ${member.chamber === 'Senate' ? 'Senator' : 'Representative'} from ${formatState(member.state)}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back link -->
    <a href={`${base}members/`} class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">
      &larr; All Members
    </a>

    <!-- Profile Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex flex-col sm:flex-row items-start gap-6">
        <img
          src={member.imageUrl}
          alt={member.name}
          class="w-32 h-40 object-cover rounded-lg bg-gray-200 shadow-sm"
          onerror="this.style.display='none'"
        />
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-gray-900">{member.name}</h1>
          <div class="flex items-center gap-3 mt-2">
            <PartyBadge party={member.party} />
            <ChamberBadge chamber={member.chamber} />
          </div>
          <p class="text-lg text-gray-600 mt-2">
            {formatState(member.state)}{districtLabel}
          </p>

          {/* Contact & Links */}
          <div class="flex flex-wrap gap-4 mt-4 text-sm">
            {member.website && (
              <a href={member.website} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                Official Website
              </a>
            )}
            {member.phone && (
              <span class="text-gray-600">
                Phone: {member.phone}
              </span>
            )}
            {member.url && (
              <a href={member.url} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                Congress.gov
              </a>
            )}
          </div>

          {/* Social Media */}
          {member.socialMedia && (
            <div class="flex gap-4 mt-3 text-sm">
              {member.socialMedia.twitter && (
                <a href={`https://twitter.com/${member.socialMedia.twitter}`} target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-500">
                  @{member.socialMedia.twitter}
                </a>
              )}
              {member.socialMedia.facebook && (
                <a href={`https://facebook.com/${member.socialMedia.facebook}`} target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-600">
                  Facebook
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-blue-600">{sponsoredBills.length}</div>
        <div class="text-xs text-gray-500 mt-1">Bills Sponsored</div>
      </div>
      {voteStats.total > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
          <div class="text-2xl font-bold text-emerald-600">{voteStats.total}</div>
          <div class="text-xs text-gray-500 mt-1">Votes Cast</div>
        </div>
      )}
      {partyAlignment.pct != null && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
          <div class="text-2xl font-bold text-indigo-600">{partyAlignment.pct}%</div>
          <div class="text-xs text-gray-500 mt-1">Party Alignment</div>
        </div>
      )}
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-green-600">{billsByStage['Signed into Law']?.length || 0}</div>
        <div class="text-xs text-gray-500 mt-1">Signed into Law</div>
      </div>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-yellow-600">{billsByStage['In Committee']?.length || 0}</div>
        <div class="text-xs text-gray-500 mt-1">In Committee</div>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Bio -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Details</h2>
        <dl class="space-y-2 text-sm">
          {member.birthDate && (
            <div class="flex justify-between">
              <dt class="text-gray-500">Born</dt>
              <dd class="text-gray-900">{member.birthDate}</dd>
            </div>
          )}
          {member.gender && (
            <div class="flex justify-between">
              <dt class="text-gray-500">Gender</dt>
              <dd class="text-gray-900">{member.gender === 'M' ? 'Male' : member.gender === 'F' ? 'Female' : member.gender}</dd>
            </div>
          )}
          {member.officeAddress && (
            <div>
              <dt class="text-gray-500">Office</dt>
              <dd class="text-gray-900 mt-0.5">{member.officeAddress}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Service History -->
      {member.terms && member.terms.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Service History</h2>
          <div class="space-y-2 text-sm">
            {member.terms.slice().reverse().map((term) => (
              <div class="flex items-center gap-2 py-1 border-b border-gray-100 last:border-0">
                <span class={`inline-block w-2 h-2 rounded-full ${term.chamber === 'Senate' ? 'bg-amber-500' : 'bg-emerald-500'}`}></span>
                <span class="text-gray-900">{term.chamber}</span>
                <span class="text-gray-400 flex-1"></span>
                <span class="text-gray-500">{term.startDate}{term.endDate ? ` - ${term.endDate}` : ' - Present'}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Sponsored Bills by Stage -->
    {sponsoredBills.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Sponsored Legislation</h2>

        {/* Stage pipeline visualization */}
        <div class="flex flex-wrap gap-2 mb-4">
          {stageOrder.map(s => {
            const count = billsByStage[s]?.length || 0;
            if (count === 0) return null;
            const sc = STAGE_COLORS[s as keyof typeof STAGE_COLORS] || STAGE_COLORS['Other'];
            return (
              <span class={`inline-flex items-center gap-1.5 rounded-full text-xs px-3 py-1.5 font-medium ${sc.bg} ${sc.text}`}>
                <span class={`w-2 h-2 rounded-full ${sc.dot}`}></span>
                {s}: {count}
              </span>
            );
          })}
        </div>

        {/* Bills grouped by stage */}
        <div class="space-y-6">
          {stageOrder.map(s => {
            const bills = billsByStage[s];
            if (!bills || bills.length === 0) return null;
            const sc = STAGE_COLORS[s as keyof typeof STAGE_COLORS] || STAGE_COLORS['Other'];
            return (
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class={`w-2.5 h-2.5 rounded-full ${sc.dot}`}></span>
                  <h3 class="text-sm font-semibold text-gray-700">{s}</h3>
                  <span class="text-xs text-gray-400">({bills.length})</span>
                </div>
                <div class="space-y-1 pl-4 border-l-2 border-gray-100">
                  {bills.slice(0, 10).map((b: any) => {
                    const local = localBillExists(b.billId);
                    const href = local ? `${base}bills/${b.billId}/` : (b.url || `${base}bills/`);
                    return (
                    <a href={href} class="flex items-start gap-3 py-2 hover:bg-gray-50 -mx-2 px-2 rounded" target={local ? undefined : '_blank'} rel={local ? undefined : 'noopener'}>
                      <span class="font-mono text-sm font-semibold text-blue-700 whitespace-nowrap">{b.type} {b.number}</span>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm text-gray-900 line-clamp-1">{b.title}</p>
                        <p class="text-xs text-gray-400">{b.introducedDate}{b.latestActionDate ? ` · Last action: ${b.latestActionDate}` : ''}{local ? '' : ' · Congress.gov'}</p>
                      </div>
                    </a>
                    );
                  })}
                  {bills.length > 10 && (
                    <p class="text-xs text-gray-400 pl-2">...and {bills.length - 10} more</p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <a href={`${base}bills/`} class="text-blue-600 hover:underline text-sm mt-4 inline-block">View all bills &rarr;</a>
      </div>
    )}

    <!-- Voting Record -->
    {memberVotes.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Voting Record</h2>

        {/* Vote stats summary */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
          <div class="text-center p-3 bg-gray-50 rounded-lg">
            <div class="text-xl font-bold text-gray-900">{voteStats.total}</div>
            <div class="text-xs text-gray-500">Total Votes</div>
          </div>
          <div class="text-center p-3 bg-green-50 rounded-lg">
            <div class="text-xl font-bold text-green-600">{voteStats.yea}</div>
            <div class="text-xs text-gray-500">Voted Yea</div>
          </div>
          <div class="text-center p-3 bg-red-50 rounded-lg">
            <div class="text-xl font-bold text-red-600">{voteStats.nay}</div>
            <div class="text-xs text-gray-500">Voted Nay</div>
          </div>
          {partyAlignment.pct != null ? (
            <div class="text-center p-3 bg-indigo-50 rounded-lg">
              <div class="text-xl font-bold text-indigo-600">{partyAlignment.pct}%</div>
              <div class="text-xs text-gray-500">With Party ({partyAlignment.withParty}/{partyAlignment.comparable})</div>
            </div>
          ) : (
            <div class="text-center p-3 bg-yellow-50 rounded-lg">
              <div class="text-xl font-bold text-yellow-600">{voteStats.notVoting + voteStats.present}</div>
              <div class="text-xs text-gray-500">Not Voting / Present</div>
            </div>
          )}
        </div>

        {partyAlignment.pct != null && (
          <div class="mb-6 p-3 bg-indigo-50/60 border border-indigo-100 rounded-lg">
            <div class="flex items-center justify-between gap-3 mb-2">
              <span class="text-sm font-medium text-indigo-900">Votes with party majority</span>
              <span class="text-sm font-semibold text-indigo-800">{partyAlignment.pct}%</span>
            </div>
            <div class="h-2.5 bg-white rounded-full overflow-hidden flex">
              <div class="bg-indigo-500 h-full" style={`width: ${partyAlignment.pct}%`}></div>
              <div class="bg-amber-400 h-full" style={`width: ${100 - (partyAlignment.pct || 0)}%`}></div>
            </div>
            <div class="flex justify-between text-[10px] text-indigo-700/70 mt-1">
              <span>{partyAlignment.withParty} with party</span>
              <span>{partyAlignment.againstParty} against</span>
            </div>
          </div>
        )}

        {/* Yea/Nay ratio bar */}
        {(voteStats.yea + voteStats.nay) > 0 && (
          <div class="mb-6">
            <div class="flex rounded-full overflow-hidden h-3">
              <div class="bg-green-500" style={`width: ${(voteStats.yea / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
              <div class="bg-red-500" style={`width: ${(voteStats.nay / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
              <div class="bg-yellow-400" style={`width: ${((voteStats.notVoting + voteStats.present) / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
            </div>
            <div class="flex justify-between text-[10px] text-gray-400 mt-1">
              <span>Yea {((voteStats.yea / voteStats.total) * 100).toFixed(0)}%</span>
              <span>Nay {((voteStats.nay / voteStats.total) * 100).toFixed(0)}%</span>
            </div>
          </div>
        )}

        {/* Topic breakdown chips */}
        {topicOrder.length > 1 && (
          <div class="mb-6">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Votes by Policy Area</h3>
            <div class="flex flex-wrap gap-2">
              {topicOrder.map(topic => {
                const votes = votesByTopic[topic] || [];
                const topicYea = votes.filter((v: any) => ['yea', 'aye'].includes((v.voteCast || '').toLowerCase())).length;
                const topicNay = votes.filter((v: any) => ['nay', 'no'].includes((v.voteCast || '').toLowerCase())).length;
                const colorClass = TOPIC_COLORS[topic] || 'bg-gray-100 text-gray-700';
                return (
                  <div class={`inline-flex items-center gap-1 rounded-lg text-xs px-3 py-2 font-medium ${colorClass}`}>
                    <span>{topic}</span>
                    <span class="opacity-60">({votes.length})</span>
                    <span class="ml-1 text-[10px] opacity-70">
                      {topicYea}Y/{topicNay}N
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Votes grouped by topic */}
        <div class="space-y-6">
          {topicOrder.map(topic => {
            const votes = votesByTopic[topic] || [];
            if (votes.length === 0) return null;
            const colorClass = TOPIC_COLORS[topic] || 'bg-gray-100 text-gray-700';
            const topicYea = votes.filter((v: any) => ['yea', 'aye'].includes((v.voteCast || '').toLowerCase())).length;
            const topicNay = votes.filter((v: any) => ['nay', 'no'].includes((v.voteCast || '').toLowerCase())).length;

            return (
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class={`inline-flex items-center rounded-full text-xs px-2 py-0.5 font-medium ${colorClass}`}>
                    {topic}
                  </span>
                  <span class="text-xs text-gray-400">{votes.length} votes</span>
                  <span class="text-xs text-green-600">{topicYea} Yea</span>
                  <span class="text-xs text-red-600">{topicNay} Nay</span>
                  {/* Mini ratio bar */}
                  {(topicYea + topicNay) > 0 && (
                    <div class="flex-1 max-w-[100px] h-1.5 bg-gray-100 rounded-full overflow-hidden flex">
                      <div class="bg-green-500 h-full" style={`width: ${(topicYea / (topicYea + topicNay) * 100).toFixed(0)}%`}></div>
                      <div class="bg-red-500 h-full" style={`width: ${(topicNay / (topicYea + topicNay) * 100).toFixed(0)}%`}></div>
                    </div>
                  )}
                </div>
                <div class="space-y-0.5 pl-3 border-l-2 border-gray-100">
                  {votes.slice(0, 10).map((v: any) => (
                    <MemberVoteRow vote={v} base={base} billLink={billLink} />
                  ))}
                  {votes.length > 10 && (
                    <details class="group">
                      <summary class="cursor-pointer text-[10px] text-blue-600 hover:text-blue-800 pl-2 py-1 select-none">
                        Show {votes.length - 10} more votes on this topic
                      </summary>
                      <div class="space-y-0.5 pt-1">
                        {votes.slice(10).map((v: any) => (
                          <MemberVoteRow vote={v} base={base} billLink={billLink} />
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <a href={`${base}votes/`} class="text-blue-600 hover:underline text-sm mt-4 inline-block">View all votes &rarr;</a>
      </div>
    )}

    {/* Message when no votes found */}
    {memberVotes.length === 0 && (
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mt-6 text-sm text-gray-600">
        No voting record data available yet. Run the data fetch workflow to populate vote data.
      </div>
    )}

    <!-- Committee Assignments (standalone, shows even without finance data) -->
    {memberCommittees.length > 0 && stockTrades.length === 0 && ptrFilings.length === 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Committee Assignments</h2>
        <div class="flex flex-wrap gap-1.5">
          {memberCommittees.map((c: string) => {
            const code = committeeLinks[c];
            return code ? (
              <a href={`${base}committees/${code}/`} class="inline-flex items-center text-xs px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors">
                {c}
              </a>
            ) : (
              <span class="inline-flex items-center text-xs px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700">
                {c}
              </span>
            );
          })}
        </div>
      </div>
    )}

    {stockTrades.length === 0 && ptrFilings.length === 0 && (
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mt-6 text-sm text-gray-600">
        No STOCK Act trades or disclosure filings matched this member in the last two years.
        Many members file only annual disclosures or have no reportable stock activity.
        Sources checked: CongressWatch, Kadoa (House/Senate PTRs), and official Clerk/eFD indexes.
      </div>
    )}

    <!-- Financial Transparency & Potential Conflicts -->
    {(stockTrades.length > 0 || ptrFilings.length > 0) && (
      <div class="space-y-6 mt-6">
        {/* Conflict Alert Banner */}
        {conflictFlags.length > 0 && (
          <div class={`rounded-lg border-2 p-5 ${conflictFlags.some((f: any) => f.severity === 'high') ? 'border-red-300 bg-red-50' : 'border-amber-300 bg-amber-50'}`}>
            <div class="flex items-start gap-3">
              <div class={`flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-lg font-bold ${conflictFlags.some((f: any) => f.severity === 'high') ? 'bg-red-200 text-red-700' : 'bg-amber-200 text-amber-700'}`}>
                !
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-gray-900 text-sm">
                  {conflictFlags.filter((f: any) => f.severity === 'high').length > 0
                    ? `${conflictFlags.filter((f: any) => f.severity === 'high').length} Potential Conflict(s) of Interest Detected`
                    : `${conflictFlags.length} Financial Activity Flag(s)`}
                </h3>
                <div class="mt-2 space-y-2">
                  {conflictFlags.map((flag: any, i: number) => (
                    <div class={`text-xs p-2.5 rounded ${flag.severity === 'high' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'}`}>
                      <div class="flex items-center gap-2">
                        <span class={`inline-flex items-center rounded text-[10px] px-1.5 py-0.5 font-semibold uppercase ${flag.severity === 'high' ? 'bg-red-200 text-red-900' : 'bg-amber-200 text-amber-900'}`}>
                          {flag.type === 'committee_overlap' ? 'Committee Overlap' : 'Trade Timing'}
                        </span>
                        <span class="font-medium">{flag.sector}</span>
                      </div>
                      <p class="mt-1">{flag.description}</p>
                      {flag.relatedCommittees && (
                        <div class="mt-1 flex flex-wrap gap-1">
                          {flag.relatedCommittees.map((c: string) => (
                            <span class="inline-flex text-[10px] px-1.5 py-0.5 rounded bg-white/50">{c}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Financial Overview Card */}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Financial Disclosures & Trading</h2>

          {ptrFilings.length > 0 && (
            <div class={stockTrades.length > 0 ? 'mb-5' : ''}>
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Official disclosure filings</h3>
              <p class="text-xs text-gray-500 mb-3">
                Periodic transaction reports (PTRs) and annual financial disclosures from the House Clerk and Senate eFD system.
              </p>
              <div class="space-y-0.5">
                {ptrFilings.slice(0, 10).map((f: any) => (
                  <MemberFilingRow filing={f} />
                ))}
                {ptrFilings.length > 10 && (
                  <details class="group">
                    <summary class="cursor-pointer text-[10px] text-blue-600 hover:text-blue-800 pl-1 py-1 select-none">
                      Show {ptrFilings.length - 10} more filings
                    </summary>
                    <div class="space-y-0.5 pt-1 border-l-2 border-gray-100 pl-2">
                      {ptrFilings.slice(10).map((f: any) => (
                        <MemberFilingRow filing={f} />
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </div>
          )}

          {stockTrades.length > 0 && (
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Recent stock trades</h3>
              <ExpandableTradeList trades={stockTrades} previewCount={10} moreLabel="trades" />
            </div>
          )}

          {/* Stats Row */}
          {stockTrades.length > 0 && (() => {
            const purchases = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('purchase')).length;
            const sales = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('sale')).length;
            const tickers = [...new Set(stockTrades.map((t: any) => t.ticker).filter(Boolean))];
            return (
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
                <div class="text-center p-3 bg-gray-50 rounded-lg">
                  <div class="text-xl font-bold text-gray-900">{stockTrades.length}</div>
                  <div class="text-[10px] text-gray-500">Total Trades</div>
                </div>
                <div class="text-center p-3 bg-green-50 rounded-lg">
                  <div class="text-xl font-bold text-green-600">{purchases}</div>
                  <div class="text-[10px] text-gray-500">Purchases</div>
                </div>
                <div class="text-center p-3 bg-red-50 rounded-lg">
                  <div class="text-xl font-bold text-red-600">{sales}</div>
                  <div class="text-[10px] text-gray-500">Sales</div>
                </div>
                <div class="text-center p-3 bg-blue-50 rounded-lg">
                  <div class="text-xl font-bold text-blue-600">{tickers.length}</div>
                  <div class="text-[10px] text-gray-500">Unique Stocks</div>
                </div>
              </div>
            );
          })()}

          {/* Sector Breakdown with expandable trade lists */}
          {sectorTradeOrder.length > 0 && (
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Trading by Sector</h3>
              <div class="space-y-2">
                {sectorTradeOrder.map((sector) => {
                  const trades = tradesBySector[sector] || [];
                  const purchases = trades.filter((t: any) => (t.type || '').toLowerCase().includes('purchase')).length;
                  const sales = trades.filter((t: any) => (t.type || '').toLowerCase().includes('sale')).length;
                  const isOverlap = financeProfile?.committeeSectors?.includes(sector);
                  return (
                    <details class={`rounded-lg border ${isOverlap ? 'border-red-200 bg-red-50/40' : 'border-gray-200 bg-gray-50/50'}`}>
                      <summary class="cursor-pointer list-none px-3 py-2.5 select-none">
                        <div class="flex items-center gap-3">
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                              <span class={`text-sm font-medium ${isOverlap ? 'text-red-800' : 'text-gray-800'}`}>{sector}</span>
                              <span class="text-xs text-gray-500">({trades.length} trades)</span>
                              {isOverlap && (
                                <span class="inline-flex items-center text-[9px] px-1.5 py-0.5 rounded bg-red-200 text-red-800 font-semibold uppercase">
                                  Committee Overlap
                                </span>
                              )}
                            </div>
                            <div class="flex gap-3 mt-1 text-xs text-gray-500">
                              <span class="text-green-600">{purchases} buy</span>
                              <span class="text-red-600">{sales} sell</span>
                            </div>
                          </div>
                          <span class="text-[10px] text-blue-600 shrink-0">Expand trades</span>
                        </div>
                      </summary>
                      <div class="px-3 pb-3 border-t border-gray-200/80">
                        <ExpandableTradeList trades={trades} previewCount={8} moreLabel={`${sector} trades`} highlightSector={isOverlap} />
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          )}

          {/* Committee Assignments (for context) */}
          {memberCommittees.length > 0 && (
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Committee Assignments</h3>
              <div class="flex flex-wrap gap-1.5">
                {memberCommittees.map((c: string) => {
                  const sectors = [] as string[];
                  const cLower = c.toLowerCase();
                  if (cLower.includes('armed') || cLower.includes('defense') || cLower.includes('intelligence') || cLower.includes('homeland')) sectors.push('Defense');
                  if (cLower.includes('financial') || cLower.includes('banking')) sectors.push('Finance');
                  if (cLower.includes('energy')) sectors.push('Energy');
                  if (cLower.includes('health')) sectors.push('Healthcare');
                  if (cLower.includes('technology') || cLower.includes('science') || cLower.includes('cyber')) sectors.push('Technology');
                  const hasTrades = sectors.some(s => sectorBreakdown.some((sb: any) => sb.sector === s));
                  const code = committeeLinks[c];
                  const Tag = code ? 'a' : 'span';
                  return (
                    <a href={code ? `${base}committees/${code}/` : '#'} class={`inline-flex items-center text-xs px-2.5 py-1 rounded-lg ${hasTrades ? 'bg-red-50 text-red-700 border border-red-200 font-medium' : 'bg-gray-100 text-gray-600'} ${code ? 'hover:opacity-80' : ''}`}>
                      {c}
                      {hasTrades && <span class="ml-1 text-red-400">*</span>}
                    </a>
                  );
                })}
              </div>
              <p class="text-[10px] text-gray-400 mt-1">* has stock trades in related sector</p>
            </div>
          )}

          {/* Top Tickers — expandable trade lists with quote links */}
          {topTickers.length > 0 && (
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Most Traded Stocks</h3>
              <div class="space-y-2">
                {topTickers.map(([ticker, trades]) => {
                  const sector = trades[0]?.sector;
                  const isOverlap = sector && financeProfile?.committeeSectors?.includes(sector);
                  const quoteUrl = tickerQuoteUrl(ticker);
                  return (
                    <details class={`rounded-lg border ${isOverlap ? 'border-red-200 bg-red-50/30' : 'border-gray-200'}`}>
                      <summary class="cursor-pointer list-none px-3 py-2 select-none">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="font-mono text-sm font-semibold text-blue-700">{ticker}</span>
                          <span class="text-xs text-gray-500">({trades.length} trades)</span>
                          {isOverlap && <span class="text-red-500 text-[10px] font-medium">committee overlap</span>}
                          <span class="text-[10px] text-blue-600 ml-auto">Expand trades</span>
                        </div>
                      </summary>
                      <div class="px-3 pb-3 border-t border-gray-100">
                        {quoteUrl && (
                          <a href={quoteUrl} target="_blank" rel="noopener" class="inline-block text-[10px] text-blue-600 hover:underline mb-2">
                            View {ticker} quote
                          </a>
                        )}
                        <ExpandableTradeList trades={trades} previewCount={5} moreLabel={`${ticker} trades`} highlightSector={!!isOverlap} />
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          )}

          {stockTrades.length > 0 && (
            <details class="group mb-2">
              <summary class="cursor-pointer text-sm font-medium text-blue-600 hover:text-blue-800 select-none">
                View full transaction table ({stockTrades.length})
              </summary>
              <div class="overflow-x-auto mt-3">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="border-b border-gray-200 text-gray-500">
                      <th class="text-left py-2 font-medium">Date</th>
                      <th class="text-left py-2 font-medium">Ticker</th>
                      <th class="text-left py-2 font-medium">Asset</th>
                      <th class="text-left py-2 font-medium">Type</th>
                      <th class="text-right py-2 font-medium">Amount</th>
                      <th class="text-right py-2 font-medium">Link</th>
                    </tr>
                  </thead>
                  <tbody>
                    {stockTrades.map((t: any) => {
                      const quoteUrl = tickerQuoteUrl(t.ticker);
                      const disclosureUrl = t.url || null;
                      const typeColor = (t.type || '').toLowerCase().includes('purchase')
                        ? 'text-green-700 bg-green-50'
                        : (t.type || '').toLowerCase().includes('sale')
                        ? 'text-red-700 bg-red-50'
                        : 'text-gray-700 bg-gray-50';
                      return (
                        <tr class="border-b border-gray-50 hover:bg-gray-50">
                          <td class="py-1.5 text-gray-500 whitespace-nowrap">{t.transactionDate}</td>
                          <td class="py-1.5 font-mono font-semibold">
                            {quoteUrl ? (
                              <a href={quoteUrl} target="_blank" rel="noopener" class="text-blue-700 hover:underline">{t.ticker || '—'}</a>
                            ) : (
                              <span class="text-blue-700">{t.ticker || '—'}</span>
                            )}
                          </td>
                          <td class="py-1.5 text-gray-700 max-w-[180px] truncate">{t.assetDescription}</td>
                          <td class="py-1.5">
                            <span class={`inline-flex rounded text-[10px] px-1.5 py-0.5 font-medium ${typeColor}`}>{t.type}</span>
                          </td>
                          <td class="py-1.5 text-right text-gray-600 whitespace-nowrap">{t.amount}</td>
                          <td class="py-1.5 text-right whitespace-nowrap">
                            {disclosureUrl ? (
                              <a href={disclosureUrl} target="_blank" rel="noopener" class="text-blue-600 hover:underline">Filing</a>
                            ) : (
                              <span class="text-gray-300">—</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          <p class="text-[10px] text-gray-400 mt-3 border-t border-gray-100 pt-3">
            Sources: CongressWatch, Kadoa congress-trading-monitor, House Clerk, Senate eFD{stockTrades.length > 0 ? ', and Stock Watcher when available' : ''}.
            Red highlights indicate trades in sectors related to this member's committee assignments — this does not necessarily indicate wrongdoing.
          </p>
        </div>
      </div>
    )}
  </div>
</Layout>
