---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import PartyBadge from '../../components/shared/PartyBadge.astro';
import ChamberBadge from '../../components/shared/ChamberBadge.astro';
import MemberVoteRow from '../../components/shared/MemberVoteRow.astro';
import MemberFilingRow from '../../components/shared/MemberFilingRow.astro';
import ExpandableTradeList from '../../components/shared/ExpandableTradeList.astro';
import TradeTimingExplorer from '../../components/interactive/TradeTimingExplorer';
import MemberPortfolioChart from '../../components/interactive/MemberPortfolioChart';
import { tickerQuoteUrl, tradeDisclosureUrl } from '../../../shared/finance-sources.mjs';
import { buildTradeContext, isPurchaseType, isSaleType } from '../../../shared/trade-timing.mjs';
import { createTimingAttacher } from '../../../shared/timing-precompute.mjs';
import { loadDataJSON } from '../../../shared/data-loader.mjs';
import { buildPortfolioSeries, BENCHMARK_LABEL } from '../../../shared/portfolio-series.mjs';
import { createPriceCacheReader, decodePriceSeries, BENCHMARK_TICKER } from '../../../shared/price-cache.mjs';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import { formatState, formatDate, getBillStage, STAGE_COLORS, BILL_STAGES } from '../../lib/utils';
import type { MemberDetail } from '../../lib/types';
import { partitionFinanceTrades } from '../../../scripts/fetch-finances.mjs';
import { scoreMemberPartyAlignment } from '../../lib/party-alignment';
import MemberPolicyStance from '../../components/interactive/MemberPolicyStance';
import { memberPolicyProfile } from '../../lib/policy-areas';
import type { MemberPolicyProfile, StanceMetric } from '../../lib/policy-areas';
import { loadPolicyIndex, loadRecountedBreakdowns } from '../../../shared/policy-data.mjs';
import { enrichMemberVotes, summariesByVoteId } from '../../../shared/vote-member-index.mjs';

export function getStaticPaths() {
  const membersDir = join(process.cwd(), 'data', 'members');
  const paths: { params: { bioguideId: string } }[] = [];

  if (existsSync(membersDir)) {
    const files = readdirSync(membersDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const bioguideId = file.replace('.json', '');
      paths.push({ params: { bioguideId } });
    }
  }

  return paths;
}

const { bioguideId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'members', `${bioguideId}.json`);
const member: MemberDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const districtLabel = member.chamber === 'House' && member.district
  ? `, District ${member.district}`
  : '';

function localBillExists(id: string) {
  return existsSync(join(process.cwd(), 'data', 'bills', `${id}.json`));
}

function billLink(billId: string) {
  const local = localBillExists(billId);
  return {
    local,
    href: `${base}bills/${billId}/`,
  };
}

function withStage(bills: any[]) {
  return bills.map((b: any) => ({ ...b, stage: getBillStage(b.latestAction) }));
}

// Prefer the member's own sponsored-legislation list (filled by fetch-members).
// Overlay the 500 recently-updated bills when we have a richer local record.
let sponsoredBills: any[] = [];
let billsByStage: Record<string, any[]> = {};
try {
  const stored = Array.isArray(member.sponsoredBills) ? member.sponsoredBills : [];
  let indexById: Record<string, any> = {};
  const billsIndexPath = join(process.cwd(), 'data', 'bills', 'index.json');
  if (existsSync(billsIndexPath)) {
    const billsIndex = JSON.parse(readFileSync(billsIndexPath, 'utf-8'));
    for (const b of billsIndex.bills || []) {
      if (b.billId) indexById[b.billId] = b;
    }
  }
  if (stored.length > 0) {
    sponsoredBills = withStage(stored.map((b: any) => indexById[b.billId] ? { ...b, ...indexById[b.billId] } : b));
  } else {
    sponsoredBills = withStage(
      Object.values(indexById).filter((b: any) => b.sponsor?.bioguideId === bioguideId)
    );
  }

  for (const b of sponsoredBills) {
    if (!billsByStage[b.stage]) billsByStage[b.stage] = [];
    billsByStage[b.stage].push(b);
  }
} catch {}

// Cross-link: find votes for this specific member
let memberVotes: any[] = [];
let voteStats = { total: 0, yea: 0, nay: 0, notVoting: 0, present: 0 };
try {
  const byMemberPath = join(process.cwd(), 'data', 'votes', 'by-member.json');
  const votesIndexPath = join(process.cwd(), 'data', 'votes', 'index.json');
  if (existsSync(byMemberPath) && existsSync(votesIndexPath)) {
    const byMemberData = JSON.parse(readFileSync(byMemberPath, 'utf-8'));
    const votesIndex = JSON.parse(readFileSync(votesIndexPath, 'utf-8'));
    const summaryById = summariesByVoteId(votesIndex.votes || []);
    const myVotes = enrichMemberVotes(byMemberData.members?.[bioguideId] || [], summaryById);
    memberVotes = myVotes.sort((a: any, b: any) => {
      if (a.date !== b.date) return b.date.localeCompare(a.date);
      return b.rollCallNumber - a.rollCallNumber;
    });
    voteStats.total = memberVotes.length;
    for (const v of memberVotes) {
      const cast = (v.voteCast || '').toLowerCase();
      if (cast === 'yea' || cast === 'aye') voteStats.yea++;
      else if (cast === 'nay' || cast === 'no') voteStats.nay++;
      else if (cast === 'not voting') voteStats.notVoting++;
      else if (cast === 'present') voteStats.present++;
    }
  }
} catch {}

// Party alignment: join this member's votes to each roll call's party breakdown
let partyAlignment: { comparable: number; withParty: number; againstParty: number; pct: number | null } = {
  comparable: 0,
  withParty: 0,
  againstParty: 0,
  pct: null,
};
try {
  // Recounted from the individual casts: the stored partyBreakdown files every
  // House member under `democratic`, which leaves House members unscored.
  if (memberVotes.length > 0) {
    partyAlignment = scoreMemberPartyAlignment(memberVotes, loadRecountedBreakdowns(), member.party);
  }
} catch {}

// Where this member stands by policy area, next to their own party and the other one.
const policyProfiles: Record<StanceMetric, MemberPolicyProfile> | null = (() => {
  try {
    const index = loadPolicyIndex();
    const support = memberPolicyProfile(index, bioguideId, { metric: 'support' });
    const lean = memberPolicyProfile(index, bioguideId, { metric: 'lean' });
    return support && lean && support.areas.length > 0 ? { support, lean } : null;
  } catch {
    return null;
  }
})();
const policySummary = policyProfiles?.support.summary ?? null;

// Cross-link: committee assignments (from member data or committees index)
let memberCommittees: string[] = [];
let committeeLinks: Record<string, string> = {};
try {
  const committeesPath = join(process.cwd(), 'data', 'committees', 'index.json');
  if (existsSync(committeesPath)) {
    const committeesData = JSON.parse(readFileSync(committeesPath, 'utf-8'));
    // Build name -> systemCode lookup
    for (const c of committeesData.committees || []) {
      if (c.name && c.systemCode) committeeLinks[c.name] = c.systemCode;
    }
  }
  // First try from member's own data
  if (member.committees && member.committees.length > 0) {
    memberCommittees = member.committees;
  }
} catch {}

// Cross-link: financial data (stock trades + conflict analysis)
let financeProfile: any = null;
let stockTrades: any[] = [];
let ptrFilings: any[] = [];
let conflictFlags: any[] = [];
let sectorBreakdown: any[] = [];
try {
  const financePath = join(process.cwd(), 'data', 'finances', 'by-member.json');
  if (existsSync(financePath)) {
    const financeData = JSON.parse(readFileSync(financePath, 'utf-8'));
    financeProfile = financeData.members?.[bioguideId];
    if (financeProfile) {
      const partitioned = partitionFinanceTrades(financeProfile.trades || []);
      stockTrades = partitioned.tickerTrades;
      ptrFilings = partitioned.filings;
      conflictFlags = financeProfile.flags || [];
      sectorBreakdown = financeProfile.summary?.topSectors || [];
      // Override committees with finance-provided ones if available (more accurate)
      if (financeProfile.committees && financeProfile.committees.length > 0) {
        memberCommittees = financeProfile.committees;
      }
    }
  }
} catch {}

const tradesBySector: Record<string, any[]> = {};
for (const t of stockTrades) {
  const sector = t.sector || 'Other';
  if (!tradesBySector[sector]) tradesBySector[sector] = [];
  tradesBySector[sector].push(t);
}
const sectorTradeOrder = Object.keys(tradesBySector).sort(
  (a, b) => (tradesBySector[b]?.length || 0) - (tradesBySector[a]?.length || 0)
);

const tradesByTicker: Record<string, any[]> = {};
for (const t of stockTrades) {
  if (!t.ticker || t.ticker === '--') continue;
  if (!tradesByTicker[t.ticker]) tradesByTicker[t.ticker] = [];
  tradesByTicker[t.ticker].push(t);
}
const topTickers = Object.entries(tradesByTicker)
  .sort(([, a], [, b]) => b.length - a.length)
  .slice(0, 15);

const TIMING_TRADE_LIMIT = 8;

// Trades whose sector overlaps a committee this member sits on. Newest first so
// the panel opens on current activity rather than whatever the source happened
// to list first; scripts/enrich-trade-timing.mjs precomputes every one of them.
const overlapTimingTrades = financeProfile
  ? (() => {
      const attachTiming = createTimingAttacher(loadDataJSON);
      return stockTrades
        .filter((t: any) => financeProfile.committeeSectors?.includes(t.sector))
        .filter((t: any) => isPurchaseType(t.type) || isSaleType(t.type))
        .filter((t: any) => t.transactionDate)
        .sort((a: any, b: any) => b.transactionDate.localeCompare(a.transactionDate))
        .slice(0, TIMING_TRADE_LIMIT)
        .map((t: any) =>
          attachTiming({
            ...t,
            bioguideId,
            memberName: member.name,
            context: buildTradeContext(t, financeProfile, {
              bioguideId,
              memberName: member.name,
              sponsoredBills,
            }),
          }),
        );
    })()
  : [];

// Portfolio counterfactual: mirror the disclosed purchases against the index and
// against not investing. Prices come from the build-time cache, never the browser.
let memberPortfolio: any = null;
if (financeProfile && stockTrades.length > 0) {
  const readPriceCache = createPriceCacheReader(loadDataJSON);
  const decoded = new Map<string, any>();
  const getSeries = (ticker: string) => {
    if (!decoded.has(ticker)) decoded.set(ticker, decodePriceSeries(readPriceCache(ticker)));
    const rows = decoded.get(ticker);
    return rows?.length ? rows : null;
  };

  const overlapSectors = new Set(financeProfile.committeeSectors || []);
  const tradesForPortfolio = stockTrades.map((t: any) => ({
    ...t,
    committeeOverlap: t.sector != null && overlapSectors.has(t.sector),
  }));

  const built = buildPortfolioSeries(tradesForPortfolio, getSeries, {
    benchmarkTicker: BENCHMARK_TICKER,
  });
  if (built.ok) memberPortfolio = built;
}

// Group votes by topic for categorized display
let votesByTopic: Record<string, any[]> = {};
const topicOrder: string[] = [];
for (const v of memberVotes) {
  const topic = v.topic || 'Other';
  if (!votesByTopic[topic]) {
    votesByTopic[topic] = [];
    topicOrder.push(topic);
  }
  votesByTopic[topic].push(v);
}
// Sort topics by vote count descending, but keep "Procedural" and "Other" last
topicOrder.sort((a, b) => {
  if (a === 'Procedural' || a === 'Other') return 1;
  if (b === 'Procedural' || b === 'Other') return -1;
  return (votesByTopic[b]?.length || 0) - (votesByTopic[a]?.length || 0);
});

// Stage display order
const stageOrder = [...BILL_STAGES, 'Other'] as const;

const hasFinanceCard = stockTrades.length > 0 || ptrFilings.length > 0;
const highSeverityFlags = conflictFlags.filter((f: any) => f.severity === 'high').length;
const pageSections = [
  { id: 'profile', label: 'Profile' },
  { id: 'details', label: 'Details & Service History' },
  { id: 'sponsored-legislation', label: 'Sponsored Legislation', when: sponsoredBills.length, count: sponsoredBills.length },
  { id: 'policy-stances', label: 'Policy Stances', when: policyProfiles && policySummary },
  { id: 'voting-record', label: 'Voting Record', when: memberVotes.length, count: voteStats.total },
  { id: 'committee-assignments', label: 'Committee Assignments', when: !hasFinanceCard && memberCommittees.length, count: memberCommittees.length },
  { id: 'conflict-flags', label: 'Conflict Flags', when: conflictFlags.length, count: conflictFlags.length },
  { id: 'portfolio', label: 'Portfolio vs. the Market', when: memberPortfolio },
  { id: 'trade-timing', label: 'Trade Timing', when: overlapTimingTrades.length, count: overlapTimingTrades.length },
  { id: 'financial-disclosures', label: 'Financial Disclosures', when: hasFinanceCard },
  { id: 'disclosure-filings', label: 'Disclosure filings', when: ptrFilings.length, count: ptrFilings.length, depth: 1 },
  { id: 'recent-trades', label: 'Recent stock trades', when: stockTrades.length, count: stockTrades.length, depth: 1 },
  { id: 'trading-by-sector', label: 'Trading by sector', when: sectorTradeOrder.length, count: sectorTradeOrder.length, depth: 1 },
  { id: 'finance-committees', label: 'Committee assignments', when: hasFinanceCard && memberCommittees.length, count: memberCommittees.length, depth: 1 },
  { id: 'most-traded-stocks', label: 'Most traded stocks', when: topTickers.length, count: topTickers.length, depth: 1 },
];
---

<Layout title={member.name} description={`${member.name} - ${member.party} ${member.chamber === 'Senate' ? 'Senator' : 'Representative'} from ${formatState(member.state)}`}>
  <div class="max-w-measure mx-auto px-10 pt-8 pb-16">
    <PageIndex sections={pageSections} />

    <a href={`${base}members/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3 hover:text-accent">
      &larr; All members
    </a>

    <!-- Profile Header: identity + ledger rail -->
    <div id="profile" data-page-section class="mt-5 grid grid-cols-1 lg:grid-cols-[112px_minmax(0,1fr)_260px] gap-8 items-start pb-6 border-b border-ink">
      <img
        src={member.imageUrl}
        alt=""
        class="w-[112px] h-36 object-cover rounded-[1px] bg-rule grayscale contrast-[1.05]"
        onerror="this.style.display='none'"
      />
      <div>
        <p class="eyebrow mb-[10px]">
          {member.chamber === 'Senate' ? 'Senator' : 'Representative'} &middot; {formatState(member.state)}{districtLabel}
        </p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.02] font-normal tracking-[-0.02em] mb-[14px]">{member.name}</h1>
        <div class="flex flex-wrap items-center gap-[10px] mb-4">
          <PartyBadge party={member.party} />
          <ChamberBadge chamber={member.chamber} />
        </div>
        <div class="flex flex-wrap gap-5 text-[13.5px]">
          {member.website && (
            <a href={member.website} target="_blank" rel="noopener" class="text-ink border-b border-rule hover:text-accent">
              Official website
            </a>
          )}
          {member.url && (
            <a href={member.url} target="_blank" rel="noopener" class="text-ink border-b border-rule hover:text-accent">
              Congress.gov
            </a>
          )}
          {member.phone && (
            <span class="font-mono text-[12.5px] text-ink-2">{member.phone}</span>
          )}
          {member.socialMedia?.twitter && (
            <a href={`https://twitter.com/${member.socialMedia.twitter}`} target="_blank" rel="noopener" class="text-ink-2 hover:text-accent">
              @{member.socialMedia.twitter}
            </a>
          )}
          {member.socialMedia?.facebook && (
            <a href={`https://facebook.com/${member.socialMedia.facebook}`} target="_blank" rel="noopener" class="text-ink-2 hover:text-accent">
              Facebook
            </a>
          )}
        </div>
      </div>
      <div class="lg:border-l border-rule lg:pl-6">
        <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule">
          <span class="field-label">Bills sponsored</span>
          <span class="font-serif text-[22px] leading-none font-medium tabular">{sponsoredBills.length}</span>
        </div>
        {voteStats.total > 0 && (
          <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule">
            <span class="field-label">Votes cast</span>
            <span class="font-serif text-[22px] leading-none font-medium tabular">{voteStats.total}</span>
          </div>
        )}
        {partyAlignment.pct != null && (
          <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule">
            <span class="field-label">Party alignment</span>
            <span class="font-serif text-[22px] leading-none font-medium tabular">{partyAlignment.pct}%</span>
          </div>
        )}
        <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule">
          <span class="field-label">Signed into law</span>
          <span class="font-serif text-[22px] leading-none font-medium tabular">{billsByStage['Signed into Law']?.length || 0}</span>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule">
          <span class="field-label">In committee</span>
          <span class="font-serif text-[22px] leading-none font-medium tabular">{billsByStage['In Committee']?.length || 0}</span>
        </div>
      </div>
    </div>

    {conflictFlags.length > 0 && (
      <div class="flex items-start gap-3 pt-4">
        <span class="shrink-0 mt-[2px] font-mono text-[10px] tracking-[0.08em] uppercase text-accent border border-accent rounded px-[7px] py-[3px] whitespace-nowrap">
          {conflictFlags.length} {conflictFlags.length === 1 ? 'flag' : 'flags'}
        </span>
        <p class="text-[13.5px] leading-[1.6] text-ink-2 max-w-[78ch] text-pretty">
          {highSeverityFlags > 0
            ? `${highSeverityFlags} potential conflict${highSeverityFlags === 1 ? '' : 's'} of interest flagged below.`
            : 'Financial activity flagged for review below.'} Overlap between a trade and a committee assignment is a reason to look closer, not a finding of wrongdoing.
        </p>
      </div>
    )}

    <!-- Details & Service History -->
    <div id="details" data-page-section class="grid grid-cols-1 md:grid-cols-2 gap-x-12 pt-8">
      <div>
        <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Details</h2>
        <dl>
          {member.birthDate && (
            <div class="flex justify-between py-[10px] border-b border-rule">
              <dt class="text-[13px] text-ink-3">Born</dt>
              <dd class="text-[13px] font-mono tabular">{member.birthDate}</dd>
            </div>
          )}
          {member.gender && (
            <div class="flex justify-between py-[10px] border-b border-rule">
              <dt class="text-[13px] text-ink-3">Gender</dt>
              <dd class="text-[13px]">{member.gender === 'M' ? 'Male' : member.gender === 'F' ? 'Female' : member.gender}</dd>
            </div>
          )}
          {member.officeAddress && (
            <div class="py-[10px] border-b border-rule">
              <dt class="text-[13px] text-ink-3">Office</dt>
              <dd class="text-[13px] mt-[3px]">{member.officeAddress}</dd>
            </div>
          )}
        </dl>
      </div>

      {member.terms && member.terms.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-4">Service history</h2>
          <div>
            {member.terms.slice().reverse().map((term) => (
              <div class="flex items-center gap-3 py-[10px] border-b border-rule last:border-0">
                <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3 w-[52px] shrink-0">{term.chamber}</span>
                <span class="font-mono text-[12px] text-ink-2 tabular">{term.startDate}{term.endDate ? ` – ${term.endDate}` : ' – Present'}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Sponsored Legislation -->
    {sponsoredBills.length > 0 && (
      <div id="sponsored-legislation" data-page-section class="pt-8">
        <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">
          Sponsored legislation <span class="font-mono text-[11px] text-ink-3 tabular">{sponsoredBills.length}</span>
        </h2>

        <div class="flex flex-wrap items-stretch border border-rule bg-card mb-6">
          {stageOrder.map(s => {
            const count = billsByStage[s]?.length || 0;
            if (count === 0) return null;
            const sc = STAGE_COLORS[s as keyof typeof STAGE_COLORS] || STAGE_COLORS['Other'];
            return (
              <div class="flex-1 min-w-[120px] px-4 py-[14px] border-r border-rule last:border-r-0">
                <div class="flex items-center gap-[7px]">
                  <span class={`w-[6px] h-[6px] rounded-full shrink-0 ${sc.dot}`}></span>
                  <span class="font-serif text-2xl leading-none font-medium tabular">{count}</span>
                </div>
                <div class="font-mono text-[10px] tracking-[0.07em] uppercase text-ink-3 mt-2 leading-[1.4]">{s}</div>
              </div>
            );
          })}
        </div>

        <div>
          {stageOrder.map(s => {
            const bills = billsByStage[s];
            if (!bills || bills.length === 0) return null;
            return bills.slice(0, 10).map((b: any) => {
              const local = localBillExists(b.billId);
              const href = local ? `${base}bills/${b.billId}/` : (b.url || `${base}bills/`);
              return (
                <a
                  href={href}
                  class="grid grid-cols-[88px_minmax(0,1fr)_150px] gap-5 items-start py-4 border-b border-rule hover:border-ink-3"
                  target={local ? undefined : '_blank'}
                  rel={local ? undefined : 'noopener'}
                >
                  <span class="font-mono text-[12.5px] font-medium text-accent">{b.type} {b.number}</span>
                  <div class="min-w-0">
                    <h3 class="font-serif text-[18px] leading-[1.3] font-medium line-clamp-1">{b.title}</h3>
                    <p class="font-mono text-[11px] text-ink-3 mt-[6px]">
                      Introduced {b.introducedDate}{b.latestActionDate ? ` · Last action: ${b.latestActionDate}` : ''}{local ? '' : ' · Congress.gov'}
                    </p>
                  </div>
                  <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-2 text-right">{s}</span>
                </a>
              );
            });
          })}
          {sponsoredBills.length > Object.values(billsByStage).reduce((n, arr) => n + Math.min(arr.length, 10), 0) && (
            <p class="font-mono text-[11px] text-ink-3 pt-3">
              {sponsoredBills.length - Object.values(billsByStage).reduce((n, arr) => n + Math.min(arr.length, 10), 0)} more not shown.
            </p>
          )}
        </div>
        <a href={`${base}bills/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline mt-4 inline-block">View all bills &rarr;</a>
      </div>
    )}

    <!-- Policy stances against the member's party -->
    {policyProfiles && policySummary && (
      <div id="policy-stances" data-page-section class="pt-8">
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-ink pt-3 mb-5">
          <div>
            <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">Where they stand by policy area</h2>
            <p class="text-[13px] text-ink-3 mt-[2px]">
              {policySummary.votes} votes across {policySummary.areas} {policySummary.areas === 1 ? 'area' : 'areas'} that split the two parties
            </p>
          </div>
          {policySummary.avgGap != null && (
            <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3 whitespace-nowrap">
              Average distance from own party &middot; {policySummary.avgGap} pts
            </span>
          )}
        </div>

        {(policySummary.mostIndependent || policySummary.mostAligned) && (
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3 mb-6">
            {policySummary.mostIndependent && (
              <div class="border-l-2 border-accent pl-3">
                <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-accent">Furthest from their party</div>
                <div class="text-[13px] text-ink-2 mt-[3px]">
                  <span class="font-semibold text-ink">{policySummary.mostIndependent.label}</span>
                  {' '}&mdash; {Math.round(policySummary.mostIndependent.score)}% against a party average of{' '}
                  {Math.round(policySummary.mostIndependent.ownParty.avg ?? 0)}%
                </div>
              </div>
            )}
            {policySummary.mostAligned && (
              <div class="border-l-2 border-rule pl-3">
                <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3">Closest to their party</div>
                <div class="text-[13px] text-ink-2 mt-[3px]">
                  <span class="font-semibold text-ink">{policySummary.mostAligned.label}</span>
                  {' '}&mdash; {Math.round(policySummary.mostAligned.score)}% against a party average of{' '}
                  {Math.round(policySummary.mostAligned.ownParty.avg ?? 0)}%
                </div>
              </div>
            )}
          </div>
        )}

        <MemberPolicyStance profiles={policyProfiles} baseUrl={base} client:visible />
      </div>
    )}

    <!-- Voting Record -->
    {memberVotes.length > 0 && (
      <div id="voting-record" data-page-section class="pt-8">
        <div class="flex items-baseline justify-between gap-4 border-t border-ink pt-3 mb-5">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">Voting record</h2>
          <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3 whitespace-nowrap">{voteStats.total} roll calls</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-11 mb-7">
          <div>
            <p class="field-label mb-3">How they voted</p>
            <div class="flex h-2 bg-rule">
              <div class="h-full bg-yea" style={`width: ${(voteStats.yea / voteStats.total * 100).toFixed(1)}%`}></div>
              <div class="h-full bg-accent" style={`width: ${(voteStats.nay / voteStats.total * 100).toFixed(1)}%`}></div>
              <div class="h-full bg-ink-3" style={`width: ${((voteStats.notVoting + voteStats.present) / voteStats.total * 100).toFixed(1)}%`}></div>
            </div>
            <div class="grid grid-cols-[14px_minmax(0,1fr)_56px_56px] gap-3 items-baseline py-[10px] border-b border-rule">
              <span class="w-[9px] h-[9px] bg-yea block"></span>
              <span class="text-[13.5px]">Yea</span>
              <span class="font-mono text-[12px] text-right tabular">{voteStats.yea}</span>
              <span class="font-mono text-[12px] text-right text-ink-3 tabular">{((voteStats.yea / voteStats.total) * 100).toFixed(0)}%</span>
            </div>
            <div class="grid grid-cols-[14px_minmax(0,1fr)_56px_56px] gap-3 items-baseline py-[10px] border-b border-rule">
              <span class="w-[9px] h-[9px] bg-accent block"></span>
              <span class="text-[13.5px]">Nay</span>
              <span class="font-mono text-[12px] text-right tabular">{voteStats.nay}</span>
              <span class="font-mono text-[12px] text-right text-ink-3 tabular">{((voteStats.nay / voteStats.total) * 100).toFixed(0)}%</span>
            </div>
            {(voteStats.notVoting + voteStats.present) > 0 && (
              <div class="grid grid-cols-[14px_minmax(0,1fr)_56px_56px] gap-3 items-baseline py-[10px] border-b border-rule">
                <span class="w-[9px] h-[9px] bg-ink-3 block"></span>
                <span class="text-[13.5px]">Not voting / present</span>
                <span class="font-mono text-[12px] text-right tabular">{voteStats.notVoting + voteStats.present}</span>
                <span class="font-mono text-[12px] text-right text-ink-3 tabular">
                  {(((voteStats.notVoting + voteStats.present) / voteStats.total) * 100).toFixed(0)}%
                </span>
              </div>
            )}
          </div>

          {partyAlignment.pct != null ? (
            <div>
              <p class="field-label mb-3">With their party majority</p>
              <div class="flex items-baseline gap-[14px] mb-3">
                <span class="font-serif text-[40px] leading-none font-medium tabular">{partyAlignment.pct}%</span>
                <span class="font-mono text-[11.5px] leading-[1.5] text-ink-3">
                  {partyAlignment.withParty} of {partyAlignment.comparable} comparable votes<br />
                  {partyAlignment.againstParty} against the party majority
                </span>
              </div>
              <div class="flex h-2 bg-rule">
                <div class="h-full bg-ink" style={`width: ${partyAlignment.pct}%`}></div>
                <div class="h-full bg-ink-3" style={`width: ${100 - (partyAlignment.pct || 0)}%`}></div>
              </div>
              <p class="text-[13px] leading-[1.6] text-ink-2 mt-4">
                Comparable votes exclude unanimous roll calls and any vote where their party's majority could not be determined.
              </p>
            </div>
          ) : (
            <div>
              <p class="field-label mb-3">Not voting / present</p>
              <span class="font-serif text-[40px] leading-none font-medium tabular">{voteStats.notVoting + voteStats.present}</span>
            </div>
          )}
        </div>

        {topicOrder.length > 1 && (
          <div class="mb-2">
            <p class="field-label mb-3">Votes by topic</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
              {topicOrder.map(topic => {
                const votes = votesByTopic[topic] || [];
                const topicYea = votes.filter((v: any) => ['yea', 'aye'].includes((v.voteCast || '').toLowerCase())).length;
                const topicNay = votes.filter((v: any) => ['nay', 'no'].includes((v.voteCast || '').toLowerCase())).length;
                const total = topicYea + topicNay;
                const yeaPct = total > 0 ? (topicYea / total) * 100 : 0;
                return (
                  <div class="grid grid-cols-[minmax(0,1fr)_96px_74px] gap-4 items-center py-[9px] border-b border-rule">
                    <span class="text-[13px] truncate">{topic}</span>
                    <span class="flex h-1 bg-rule">
                      <span class="h-full bg-yea" style={`width: ${yeaPct}%`}></span>
                      <span class="h-full bg-accent" style={`width: ${100 - yeaPct}%`}></span>
                    </span>
                    <span class="font-mono text-[11px] text-ink-3 text-right tabular">{topicYea}&ndash;{topicNay}</span>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <div>
          {topicOrder.map(topic => {
            const votes = votesByTopic[topic] || [];
            if (votes.length === 0) return null;
            return (
              <details class="group mt-6">
                <summary class="cursor-pointer select-none font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2 hover:text-accent">
                  {topic} &middot; {votes.length} {votes.length === 1 ? 'vote' : 'votes'}
                </summary>
                <div class="pt-1">
                  {votes.slice(0, 10).map((v: any) => (
                    <MemberVoteRow vote={v} base={base} billLink={billLink} />
                  ))}
                  {votes.length > 10 && (
                    <details class="group">
                      <summary class="cursor-pointer font-mono text-[10px] tracking-[0.06em] uppercase text-accent hover:underline pl-1 py-2 select-none">
                        Show {votes.length - 10} more votes on this topic
                      </summary>
                      <div>
                        {votes.slice(10).map((v: any) => (
                          <MemberVoteRow vote={v} base={base} billLink={billLink} />
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              </details>
            );
          })}
        </div>
        <a href={`${base}votes/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline mt-4 inline-block">View all votes &rarr;</a>
      </div>
    )}

    {memberVotes.length === 0 && (
      <p class="font-mono text-[11px] leading-[1.6] text-ink-3 border-l-2 border-rule pl-3 mt-8">
        No voting record data available yet. Run the data fetch workflow to populate vote data.
      </p>
    )}

    <!-- Committee Assignments (standalone, shows even without finance data) -->
    {memberCommittees.length > 0 && stockTrades.length === 0 && ptrFilings.length === 0 && (
      <div id="committee-assignments" data-page-section class="pt-8">
        <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">Committee assignments</h2>
        <div class="tile-grid grid-cols-1 sm:grid-cols-2">
          {memberCommittees.map((c: string) => {
            const code = committeeLinks[c];
            return code ? (
              <a href={`${base}committees/${code}/`} class="flex items-baseline justify-between gap-4 bg-card px-[18px] py-[14px] hover:bg-rule-2">
                <span class="font-serif text-[17px] font-medium">{c}</span>
              </a>
            ) : (
              <div class="flex items-baseline justify-between gap-4 bg-card px-[18px] py-[14px]">
                <span class="font-serif text-[17px] font-medium text-ink-2">{c}</span>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {stockTrades.length === 0 && ptrFilings.length === 0 && (
      <p class="font-mono text-[11px] leading-[1.6] text-ink-3 border-l-2 border-rule pl-3 mt-8">
        No STOCK Act trades or disclosure filings matched this member in the last two years.
        Many members file only annual disclosures or have no reportable stock activity.
        Sources checked: CongressWatch, Kadoa (House/Senate PTRs), and official Clerk/eFD indexes.
      </p>
    )}

    <!-- Financial Transparency & Potential Conflicts -->
    {(stockTrades.length > 0 || ptrFilings.length > 0) && (
      <div>
        {conflictFlags.length > 0 && (
          <div id="conflict-flags" data-page-section class="pt-8">
            <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">
              {highSeverityFlags > 0
                ? `${highSeverityFlags} potential conflict${highSeverityFlags === 1 ? '' : 's'} of interest`
                : `${conflictFlags.length} financial activity flag${conflictFlags.length === 1 ? '' : 's'}`}
            </h2>
            <div>
              {conflictFlags.map((flag: any) => (
                <div class={`py-4 border-b border-rule last:border-0 border-l-2 pl-4 ${flag.severity === 'high' ? 'border-l-accent' : 'border-l-rule'}`}>
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3">
                      {flag.type === 'committee_overlap' ? 'Committee overlap' : 'Trade timing'}
                    </span>
                    <span class="text-[13px] font-medium">{flag.sector}</span>
                  </div>
                  <p class="text-[13px] leading-[1.55] text-ink-2 mt-[6px]">{flag.description}</p>
                  {flag.relatedCommittees && (
                    <div class="flex flex-wrap gap-2 mt-2">
                      {flag.relatedCommittees.map((c: string) => (
                        <span class="text-[11px] text-ink-3 border border-rule rounded px-[6px] py-[2px]">{c}</span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {memberPortfolio && (
          <div id="portfolio" data-page-section class="pt-8">
            <MemberPortfolioChart
              portfolio={memberPortfolio}
              memberName={member.name}
              benchmarkLabel={BENCHMARK_LABEL}
              client:load
            />
          </div>
        )}

        {overlapTimingTrades.length > 0 && (
          <div id="trade-timing" data-page-section class="pt-8">
            <h3 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-1">Trade timing analysis</h3>
            <p class="text-[13px] text-ink-3 mb-4">
              Compare flagged trades to alternative timing and a do-nothing baseline (cash if no buy, hold if no sell).
            </p>
            <TradeTimingExplorer candidates={overlapTimingTrades} baseUrl={base} client:load />
          </div>
        )}

        <!-- Financial Disclosures & Trading -->
        <div id="financial-disclosures" data-page-section class="pt-8">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">
            Financial disclosures <span class="font-mono text-[11px] text-ink-3 tabular">{stockTrades.length} trades &middot; {ptrFilings.length} filings</span>
          </h2>

          {ptrFilings.length > 0 && (
            <div id="disclosure-filings" data-page-section class="mb-7">
              <h3 class="field-label mb-1">Official disclosure filings</h3>
              <p class="text-[12.5px] text-ink-3 mb-3">
                Periodic transaction reports (PTRs) and annual financial disclosures from the House Clerk and Senate eFD system.
              </p>
              <div>
                {ptrFilings.slice(0, 10).map((f: any) => (
                  <MemberFilingRow filing={f} />
                ))}
                {ptrFilings.length > 10 && (
                  <details class="group">
                    <summary class="cursor-pointer font-mono text-[10px] tracking-[0.06em] uppercase text-accent hover:underline pl-1 py-2 select-none">
                      Show {ptrFilings.length - 10} more filings
                    </summary>
                    <div class="border-l-2 border-rule pl-3">
                      {ptrFilings.slice(10).map((f: any) => (
                        <MemberFilingRow filing={f} />
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </div>
          )}

          {stockTrades.length > 0 && (
            <div id="recent-trades" data-page-section class="mb-7">
              <h3 class="field-label mb-2">Recent stock trades</h3>
              <ExpandableTradeList trades={stockTrades} previewCount={10} moreLabel="trades" />
            </div>
          )}

          {stockTrades.length > 0 && (() => {
            const purchases = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('purchase')).length;
            const sales = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('sale')).length;
            const tickers = [...new Set(stockTrades.map((t: any) => t.ticker).filter(Boolean))];
            return (
              <div class="flex flex-wrap items-stretch border border-rule bg-card mb-7">
                <div class="flex-1 min-w-[110px] px-4 py-3 border-r border-rule">
                  <div class="font-serif text-xl leading-none font-medium tabular">{stockTrades.length}</div>
                  <div class="font-mono text-[10px] text-ink-3 mt-2">Total trades</div>
                </div>
                <div class="flex-1 min-w-[110px] px-4 py-3 border-r border-rule">
                  <div class="font-serif text-xl leading-none font-medium tabular">{purchases}</div>
                  <div class="font-mono text-[10px] text-ink-3 mt-2">Purchases</div>
                </div>
                <div class="flex-1 min-w-[110px] px-4 py-3 border-r border-rule">
                  <div class="font-serif text-xl leading-none font-medium tabular">{sales}</div>
                  <div class="font-mono text-[10px] text-ink-3 mt-2">Sales</div>
                </div>
                <div class="flex-1 min-w-[110px] px-4 py-3">
                  <div class="font-serif text-xl leading-none font-medium tabular">{tickers.length}</div>
                  <div class="font-mono text-[10px] text-ink-3 mt-2">Unique stocks</div>
                </div>
              </div>
            );
          })()}

          {sectorTradeOrder.length > 0 && (
            <div id="trading-by-sector" data-page-section class="mb-7">
              <h3 class="field-label mb-2">Trading by sector</h3>
              <div>
                {sectorTradeOrder.map((sector) => {
                  const trades = tradesBySector[sector] || [];
                  const purchases = trades.filter((t: any) => (t.type || '').toLowerCase().includes('purchase')).length;
                  const sales = trades.filter((t: any) => (t.type || '').toLowerCase().includes('sale')).length;
                  const isOverlap = financeProfile?.committeeSectors?.includes(sector);
                  return (
                    <details class={`border-b border-rule ${isOverlap ? 'border-l-2 border-l-accent pl-3' : ''}`}>
                      <summary class="cursor-pointer list-none py-[10px] select-none">
                        <div class="flex items-center gap-4">
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                              <span class="text-[13.5px] font-medium">{sector}</span>
                              <span class="font-mono text-[11px] text-ink-3">({trades.length} trades)</span>
                              {isOverlap && (
                                <span class="font-mono text-[9.5px] tracking-[0.06em] uppercase text-accent border border-accent rounded px-[6px] py-[1px]">
                                  Committee overlap
                                </span>
                              )}
                            </div>
                            <div class="flex gap-3 mt-1 font-mono text-[11px] text-ink-3">
                              <span>{purchases} buy</span>
                              <span>{sales} sell</span>
                            </div>
                          </div>
                          <span class="font-mono text-[10px] tracking-[0.06em] uppercase text-accent shrink-0">Expand</span>
                        </div>
                      </summary>
                      <div class="pb-3">
                        <ExpandableTradeList trades={trades} previewCount={8} moreLabel={`${sector} trades`} highlightSector={isOverlap} />
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          )}

          {memberCommittees.length > 0 && (
            <div id="finance-committees" data-page-section class="mb-7">
              <h3 class="field-label mb-2">Committee assignments</h3>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {memberCommittees.map((c: string) => {
                  const sectors = [] as string[];
                  const cLower = c.toLowerCase();
                  if (cLower.includes('armed') || cLower.includes('defense') || cLower.includes('intelligence') || cLower.includes('homeland')) sectors.push('Defense');
                  if (cLower.includes('financial') || cLower.includes('banking')) sectors.push('Finance');
                  if (cLower.includes('energy')) sectors.push('Energy');
                  if (cLower.includes('health')) sectors.push('Healthcare');
                  if (cLower.includes('technology') || cLower.includes('science') || cLower.includes('cyber')) sectors.push('Technology');
                  const hasTrades = sectors.some(s => sectorBreakdown.some((sb: any) => sb.sector === s));
                  const code = committeeLinks[c];
                  return (
                    <a
                      href={code ? `${base}committees/${code}/` : undefined}
                      class={`text-[12.5px] ${hasTrades ? 'text-accent font-medium' : 'text-ink-2'} ${code ? 'hover:underline' : ''}`}
                    >
                      {c}{hasTrades && <span class="text-accent">*</span>}
                    </a>
                  );
                })}
              </div>
              <p class="font-mono text-[10px] text-ink-3 mt-2">* has stock trades in related sector</p>
            </div>
          )}

          {topTickers.length > 0 && (
            <div id="most-traded-stocks" data-page-section class="mb-7">
              <h3 class="field-label mb-2">Most traded stocks</h3>
              <div>
                {topTickers.map(([ticker, trades]) => {
                  const sector = trades[0]?.sector;
                  const isOverlap = sector && financeProfile?.committeeSectors?.includes(sector);
                  const quoteUrl = tickerQuoteUrl(ticker);
                  return (
                    <details class={`border-b border-rule ${isOverlap ? 'border-l-2 border-l-accent pl-3' : ''}`}>
                      <summary class="cursor-pointer list-none py-[10px] select-none">
                        <div class="flex items-center gap-2 flex-wrap">
                          {quoteUrl ? (
                            <a href={quoteUrl} target="_blank" rel="noopener" class="font-mono text-[13px] font-medium text-accent hover:underline">{ticker}</a>
                          ) : (
                            <span class="font-mono text-[13px] font-medium text-accent">{ticker}</span>
                          )}
                          <span class="font-mono text-[11px] text-ink-3">({trades.length} trades)</span>
                          {isOverlap && <span class="font-mono text-[10px] uppercase tracking-[0.06em] text-accent">committee overlap</span>}
                          <span class="font-mono text-[10px] tracking-[0.06em] uppercase text-accent ml-auto">Expand</span>
                        </div>
                      </summary>
                      <div class="pb-3">
                        {quoteUrl && (
                          <a href={quoteUrl} target="_blank" rel="noopener" class="inline-block font-mono text-[10.5px] text-accent hover:underline mb-2">
                            View {ticker} quote
                          </a>
                        )}
                        <ExpandableTradeList trades={trades} previewCount={5} moreLabel={`${ticker} trades`} highlightSector={!!isOverlap} />
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          )}

          {stockTrades.length > 0 && (
            <details class="group mb-2">
              <summary class="cursor-pointer font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline select-none">
                View full transaction table ({stockTrades.length})
              </summary>
              <div class="overflow-x-auto mt-3">
                <table class="w-full text-[12px]">
                  <thead>
                    <tr class="border-b border-ink">
                      <th class="text-left py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Date</th>
                      <th class="text-left py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Ticker</th>
                      <th class="text-left py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Asset</th>
                      <th class="text-left py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Type</th>
                      <th class="text-right py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Amount</th>
                      <th class="text-right py-2 font-mono text-[10px] tracking-[0.08em] uppercase text-ink-3 font-normal">Link</th>
                    </tr>
                  </thead>
                  <tbody>
                    {stockTrades.map((t: any) => {
                      const quoteUrl = tickerQuoteUrl(t.ticker);
                      const disclosureUrl = tradeDisclosureUrl(t);
                      return (
                        <tr class="border-b border-rule">
                          <td class="py-[7px] font-mono text-ink-3 whitespace-nowrap tabular">{t.transactionDate}</td>
                          <td class="py-[7px] font-mono font-medium">
                            {quoteUrl ? (
                              <a href={quoteUrl} target="_blank" rel="noopener" class="text-accent hover:underline">{t.ticker || '—'}</a>
                            ) : (
                              <span class="text-accent">{t.ticker || '—'}</span>
                            )}
                          </td>
                          <td class="py-[7px] text-ink-2 max-w-[180px] truncate">{t.assetDescription}</td>
                          <td class="py-[7px] font-mono text-[10.5px] tracking-[0.04em] uppercase text-ink-2">{t.type}</td>
                          <td class="py-[7px] text-right text-ink-2 whitespace-nowrap font-mono tabular">{t.amount}</td>
                          <td class="py-[7px] text-right whitespace-nowrap">
                            {disclosureUrl ? (
                              <a href={disclosureUrl} target="_blank" rel="noopener" class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-accent hover:underline">Filing</a>
                            ) : (
                              <span class="text-ink-3">—</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          <p class="font-mono text-[10.5px] leading-[1.6] text-ink-3 border-l-2 border-rule pl-3 mt-6">
            Sources: CongressWatch, Kadoa congress-trading-monitor, House Clerk, Senate eFD{stockTrades.length > 0 ? ', and Stock Watcher when available' : ''}.
            Red highlights indicate trades in sectors related to this member's committee assignments — this does not necessarily indicate wrongdoing.
          </p>
        </div>
      </div>
    )}
  </div>
</Layout>
