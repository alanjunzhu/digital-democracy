---
import Layout from '../../components/layout/Layout.astro';
import PartyBadge from '../../components/shared/PartyBadge.astro';
import ChamberBadge from '../../components/shared/ChamberBadge.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import { formatState, formatDate, getBillStage, STAGE_COLORS, BILL_STAGES } from '../../lib/utils';
import type { MemberDetail } from '../../lib/types';

export function getStaticPaths() {
  const membersDir = join(process.cwd(), 'data', 'members');
  const paths: { params: { bioguideId: string } }[] = [];

  if (existsSync(membersDir)) {
    const files = readdirSync(membersDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const bioguideId = file.replace('.json', '');
      paths.push({ params: { bioguideId } });
    }
  }

  return paths;
}

const { bioguideId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'members', `${bioguideId}.json`);
const member: MemberDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const districtLabel = member.chamber === 'House' && member.district
  ? `, District ${member.district}`
  : '';

// Cross-link: find bills sponsored by this member, with stage info
let sponsoredBills: any[] = [];
let billsByStage: Record<string, any[]> = {};
try {
  const billsIndex = JSON.parse(readFileSync(join(process.cwd(), 'data', 'bills', 'index.json'), 'utf-8'));
  sponsoredBills = billsIndex.bills
    .filter((b: any) => b.sponsor?.bioguideId === bioguideId)
    .map((b: any) => ({ ...b, stage: getBillStage(b.latestAction) }));

  // Group by stage
  for (const b of sponsoredBills) {
    if (!billsByStage[b.stage]) billsByStage[b.stage] = [];
    billsByStage[b.stage].push(b);
  }
} catch {}

// Cross-link: find votes for this specific member
let memberVotes: any[] = [];
let voteStats = { total: 0, yea: 0, nay: 0, notVoting: 0, present: 0 };
try {
  const byMemberPath = join(process.cwd(), 'data', 'votes', 'by-member.json');
  if (existsSync(byMemberPath)) {
    const byMemberData = JSON.parse(readFileSync(byMemberPath, 'utf-8'));
    const myVotes = byMemberData.members?.[bioguideId] || [];
    memberVotes = myVotes.sort((a: any, b: any) => {
      if (a.date !== b.date) return b.date.localeCompare(a.date);
      return b.rollCallNumber - a.rollCallNumber;
    });
    voteStats.total = memberVotes.length;
    for (const v of memberVotes) {
      const cast = (v.voteCast || '').toLowerCase();
      if (cast === 'yea' || cast === 'aye') voteStats.yea++;
      else if (cast === 'nay' || cast === 'no') voteStats.nay++;
      else if (cast === 'not voting') voteStats.notVoting++;
      else if (cast === 'present') voteStats.present++;
    }
  } else if (member.chamber === 'House') {
    // Fallback to general votes index if by-member doesn't exist yet
    const votesIndex = JSON.parse(readFileSync(join(process.cwd(), 'data', 'votes', 'index.json'), 'utf-8'));
    memberVotes = votesIndex.votes.slice(0, 20);
    voteStats.total = memberVotes.length;
  }
} catch {}

// Cross-link: financial data (stock trades)
let stockTrades: any[] = [];
try {
  const financePath = join(process.cwd(), 'data', 'finances', 'by-member.json');
  if (existsSync(financePath)) {
    const financeData = JSON.parse(readFileSync(financePath, 'utf-8'));
    const memberFinance = financeData.members?.[bioguideId];
    if (memberFinance) {
      stockTrades = memberFinance.trades || [];
      // Sort by date descending
      stockTrades.sort((a: any, b: any) =>
        (b.transactionDate || '').localeCompare(a.transactionDate || '')
      );
    }
  }
} catch {}

// Group votes by topic for categorized display
let votesByTopic: Record<string, any[]> = {};
const topicOrder: string[] = [];
for (const v of memberVotes) {
  const topic = v.topic || 'Other';
  if (!votesByTopic[topic]) {
    votesByTopic[topic] = [];
    topicOrder.push(topic);
  }
  votesByTopic[topic].push(v);
}
// Sort topics by vote count descending, but keep "Procedural" and "Other" last
topicOrder.sort((a, b) => {
  if (a === 'Procedural' || a === 'Other') return 1;
  if (b === 'Procedural' || b === 'Other') return -1;
  return (votesByTopic[b]?.length || 0) - (votesByTopic[a]?.length || 0);
});

// Topic color mapping
const TOPIC_COLORS: Record<string, string> = {
  'Immigration': 'bg-orange-100 text-orange-800',
  'Armed Forces and National Security': 'bg-slate-100 text-slate-800',
  'Health': 'bg-pink-100 text-pink-800',
  'Taxation': 'bg-emerald-100 text-emerald-800',
  'Economics and Public Finance': 'bg-green-100 text-green-800',
  'Education': 'bg-violet-100 text-violet-800',
  'Energy': 'bg-amber-100 text-amber-800',
  'Environmental Protection': 'bg-teal-100 text-teal-800',
  'Crime and Law Enforcement': 'bg-red-100 text-red-800',
  'International Affairs': 'bg-sky-100 text-sky-800',
  'Transportation and Public Works': 'bg-cyan-100 text-cyan-800',
  'Nominations': 'bg-indigo-100 text-indigo-800',
  'Procedural': 'bg-gray-100 text-gray-600',
  'Other': 'bg-gray-100 text-gray-600',
};

// Stage display order
const stageOrder = [...BILL_STAGES, 'Other'] as const;
---

<Layout title={member.name} description={`${member.name} - ${member.party} ${member.chamber === 'Senate' ? 'Senator' : 'Representative'} from ${formatState(member.state)}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back link -->
    <a href={`${base}members/`} class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">
      &larr; All Members
    </a>

    <!-- Profile Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex flex-col sm:flex-row items-start gap-6">
        <img
          src={member.imageUrl}
          alt={member.name}
          class="w-32 h-40 object-cover rounded-lg bg-gray-200 shadow-sm"
          onerror="this.style.display='none'"
        />
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-gray-900">{member.name}</h1>
          <div class="flex items-center gap-3 mt-2">
            <PartyBadge party={member.party} />
            <ChamberBadge chamber={member.chamber} />
          </div>
          <p class="text-lg text-gray-600 mt-2">
            {formatState(member.state)}{districtLabel}
          </p>

          {/* Contact & Links */}
          <div class="flex flex-wrap gap-4 mt-4 text-sm">
            {member.website && (
              <a href={member.website} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                Official Website
              </a>
            )}
            {member.phone && (
              <span class="text-gray-600">
                Phone: {member.phone}
              </span>
            )}
            {member.url && (
              <a href={member.url} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                Congress.gov
              </a>
            )}
          </div>

          {/* Social Media */}
          {member.socialMedia && (
            <div class="flex gap-4 mt-3 text-sm">
              {member.socialMedia.twitter && (
                <a href={`https://twitter.com/${member.socialMedia.twitter}`} target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-500">
                  @{member.socialMedia.twitter}
                </a>
              )}
              {member.socialMedia.facebook && (
                <a href={`https://facebook.com/${member.socialMedia.facebook}`} target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-600">
                  Facebook
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-blue-600">{sponsoredBills.length}</div>
        <div class="text-xs text-gray-500 mt-1">Bills Sponsored</div>
      </div>
      {voteStats.total > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
          <div class="text-2xl font-bold text-emerald-600">{voteStats.total}</div>
          <div class="text-xs text-gray-500 mt-1">Votes Cast</div>
        </div>
      )}
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-green-600">{billsByStage['Signed into Law']?.length || 0}</div>
        <div class="text-xs text-gray-500 mt-1">Signed into Law</div>
      </div>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <div class="text-2xl font-bold text-yellow-600">{billsByStage['In Committee']?.length || 0}</div>
        <div class="text-xs text-gray-500 mt-1">In Committee</div>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Bio -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Details</h2>
        <dl class="space-y-2 text-sm">
          {member.birthDate && (
            <div class="flex justify-between">
              <dt class="text-gray-500">Born</dt>
              <dd class="text-gray-900">{member.birthDate}</dd>
            </div>
          )}
          {member.gender && (
            <div class="flex justify-between">
              <dt class="text-gray-500">Gender</dt>
              <dd class="text-gray-900">{member.gender === 'M' ? 'Male' : member.gender === 'F' ? 'Female' : member.gender}</dd>
            </div>
          )}
          {member.officeAddress && (
            <div>
              <dt class="text-gray-500">Office</dt>
              <dd class="text-gray-900 mt-0.5">{member.officeAddress}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Service History -->
      {member.terms && member.terms.length > 0 && (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Service History</h2>
          <div class="space-y-2 text-sm">
            {member.terms.slice().reverse().map((term) => (
              <div class="flex items-center gap-2 py-1 border-b border-gray-100 last:border-0">
                <span class={`inline-block w-2 h-2 rounded-full ${term.chamber === 'Senate' ? 'bg-amber-500' : 'bg-emerald-500'}`}></span>
                <span class="text-gray-900">{term.chamber}</span>
                <span class="text-gray-400 flex-1"></span>
                <span class="text-gray-500">{term.startDate}{term.endDate ? ` - ${term.endDate}` : ' - Present'}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Sponsored Bills by Stage -->
    {sponsoredBills.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Sponsored Legislation</h2>

        {/* Stage pipeline visualization */}
        <div class="flex flex-wrap gap-2 mb-4">
          {stageOrder.map(s => {
            const count = billsByStage[s]?.length || 0;
            if (count === 0) return null;
            const sc = STAGE_COLORS[s as keyof typeof STAGE_COLORS] || STAGE_COLORS['Other'];
            return (
              <span class={`inline-flex items-center gap-1.5 rounded-full text-xs px-3 py-1.5 font-medium ${sc.bg} ${sc.text}`}>
                <span class={`w-2 h-2 rounded-full ${sc.dot}`}></span>
                {s}: {count}
              </span>
            );
          })}
        </div>

        {/* Bills grouped by stage */}
        <div class="space-y-6">
          {stageOrder.map(s => {
            const bills = billsByStage[s];
            if (!bills || bills.length === 0) return null;
            const sc = STAGE_COLORS[s as keyof typeof STAGE_COLORS] || STAGE_COLORS['Other'];
            return (
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class={`w-2.5 h-2.5 rounded-full ${sc.dot}`}></span>
                  <h3 class="text-sm font-semibold text-gray-700">{s}</h3>
                  <span class="text-xs text-gray-400">({bills.length})</span>
                </div>
                <div class="space-y-1 pl-4 border-l-2 border-gray-100">
                  {bills.slice(0, 10).map((b: any) => (
                    <a href={`${base}bills/${b.billId}/`} class="flex items-start gap-3 py-2 hover:bg-gray-50 -mx-2 px-2 rounded">
                      <span class="font-mono text-sm font-semibold text-blue-700 whitespace-nowrap">{b.type} {b.number}</span>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm text-gray-900 line-clamp-1">{b.title}</p>
                        <p class="text-xs text-gray-400">{b.introducedDate}{b.latestActionDate ? ` · Last action: ${b.latestActionDate}` : ''}</p>
                      </div>
                    </a>
                  ))}
                  {bills.length > 10 && (
                    <p class="text-xs text-gray-400 pl-2">...and {bills.length - 10} more</p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <a href={`${base}bills/`} class="text-blue-600 hover:underline text-sm mt-4 inline-block">View all bills &rarr;</a>
      </div>
    )}

    <!-- Voting Record -->
    {memberVotes.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Voting Record</h2>

        {/* Vote stats summary */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
          <div class="text-center p-3 bg-gray-50 rounded-lg">
            <div class="text-xl font-bold text-gray-900">{voteStats.total}</div>
            <div class="text-xs text-gray-500">Total Votes</div>
          </div>
          <div class="text-center p-3 bg-green-50 rounded-lg">
            <div class="text-xl font-bold text-green-600">{voteStats.yea}</div>
            <div class="text-xs text-gray-500">Voted Yea</div>
          </div>
          <div class="text-center p-3 bg-red-50 rounded-lg">
            <div class="text-xl font-bold text-red-600">{voteStats.nay}</div>
            <div class="text-xs text-gray-500">Voted Nay</div>
          </div>
          <div class="text-center p-3 bg-yellow-50 rounded-lg">
            <div class="text-xl font-bold text-yellow-600">{voteStats.notVoting + voteStats.present}</div>
            <div class="text-xs text-gray-500">Not Voting / Present</div>
          </div>
        </div>

        {/* Yea/Nay ratio bar */}
        {(voteStats.yea + voteStats.nay) > 0 && (
          <div class="mb-6">
            <div class="flex rounded-full overflow-hidden h-3">
              <div class="bg-green-500" style={`width: ${(voteStats.yea / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
              <div class="bg-red-500" style={`width: ${(voteStats.nay / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
              <div class="bg-yellow-400" style={`width: ${((voteStats.notVoting + voteStats.present) / (voteStats.yea + voteStats.nay + voteStats.notVoting + voteStats.present) * 100).toFixed(1)}%`}></div>
            </div>
            <div class="flex justify-between text-[10px] text-gray-400 mt-1">
              <span>Yea {((voteStats.yea / voteStats.total) * 100).toFixed(0)}%</span>
              <span>Nay {((voteStats.nay / voteStats.total) * 100).toFixed(0)}%</span>
            </div>
          </div>
        )}

        {/* Topic breakdown chips */}
        {topicOrder.length > 1 && (
          <div class="mb-6">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Votes by Policy Area</h3>
            <div class="flex flex-wrap gap-2">
              {topicOrder.map(topic => {
                const votes = votesByTopic[topic] || [];
                const topicYea = votes.filter((v: any) => ['yea', 'aye'].includes((v.voteCast || '').toLowerCase())).length;
                const topicNay = votes.filter((v: any) => ['nay', 'no'].includes((v.voteCast || '').toLowerCase())).length;
                const colorClass = TOPIC_COLORS[topic] || 'bg-gray-100 text-gray-700';
                return (
                  <div class={`inline-flex items-center gap-1 rounded-lg text-xs px-3 py-2 font-medium ${colorClass}`}>
                    <span>{topic}</span>
                    <span class="opacity-60">({votes.length})</span>
                    <span class="ml-1 text-[10px] opacity-70">
                      {topicYea}Y/{topicNay}N
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Votes grouped by topic */}
        <div class="space-y-6">
          {topicOrder.map(topic => {
            const votes = votesByTopic[topic] || [];
            if (votes.length === 0) return null;
            const colorClass = TOPIC_COLORS[topic] || 'bg-gray-100 text-gray-700';
            const topicYea = votes.filter((v: any) => ['yea', 'aye'].includes((v.voteCast || '').toLowerCase())).length;
            const topicNay = votes.filter((v: any) => ['nay', 'no'].includes((v.voteCast || '').toLowerCase())).length;

            return (
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class={`inline-flex items-center rounded-full text-xs px-2 py-0.5 font-medium ${colorClass}`}>
                    {topic}
                  </span>
                  <span class="text-xs text-gray-400">{votes.length} votes</span>
                  <span class="text-xs text-green-600">{topicYea} Yea</span>
                  <span class="text-xs text-red-600">{topicNay} Nay</span>
                  {/* Mini ratio bar */}
                  {(topicYea + topicNay) > 0 && (
                    <div class="flex-1 max-w-[100px] h-1.5 bg-gray-100 rounded-full overflow-hidden flex">
                      <div class="bg-green-500 h-full" style={`width: ${(topicYea / (topicYea + topicNay) * 100).toFixed(0)}%`}></div>
                      <div class="bg-red-500 h-full" style={`width: ${(topicNay / (topicYea + topicNay) * 100).toFixed(0)}%`}></div>
                    </div>
                  )}
                </div>
                <div class="space-y-0.5 pl-3 border-l-2 border-gray-100">
                  {votes.slice(0, 10).map((v: any) => {
                    const castLower = (v.voteCast || '').toLowerCase();
                    const castColor = (castLower === 'yea' || castLower === 'aye')
                      ? 'bg-green-100 text-green-800'
                      : (castLower === 'nay' || castLower === 'no')
                      ? 'bg-red-100 text-red-800'
                      : 'bg-yellow-100 text-yellow-800';
                    return (
                      <a href={`${base}votes/${v.voteId}/`} class="flex items-start gap-2 py-2 hover:bg-gray-50 -mx-2 px-2 rounded">
                        <div class="flex flex-col items-center min-w-[2.5rem]">
                          <span class="font-mono text-[10px] text-gray-500">#{v.rollCallNumber}</span>
                          <span class="text-[9px] text-gray-400">{v.date}</span>
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="text-xs text-gray-900 line-clamp-1">{v.question}</p>
                          <div class="flex items-center gap-2 mt-0.5">
                            {v.billId && (
                              <span class="text-[10px] text-blue-600 font-mono">{v.billId}</span>
                            )}
                            {v.result && (
                              <span class={`text-[10px] ${v.result === 'Passed' || v.result === 'Agreed to' ? 'text-green-600' : 'text-red-600'}`}>
                                {v.result}
                              </span>
                            )}
                          </div>
                        </div>
                        {v.voteCast && (
                          <span class={`inline-flex items-center rounded-full text-[10px] px-2 py-0.5 font-semibold whitespace-nowrap ${castColor}`}>
                            {v.voteCast}
                          </span>
                        )}
                      </a>
                    );
                  })}
                  {votes.length > 10 && (
                    <p class="text-[10px] text-gray-400 pl-2 py-1">...and {votes.length - 10} more votes on this topic</p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <a href={`${base}votes/`} class="text-blue-600 hover:underline text-sm mt-4 inline-block">View all votes &rarr;</a>
      </div>
    )}

    {/* Message when no votes found */}
    {memberVotes.length === 0 && (
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mt-6 text-sm text-gray-600">
        No voting record data available yet. Run the data fetch workflow to populate vote data.
      </div>
    )}

    <!-- Stock Trading Activity -->
    {stockTrades.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">
          Stock Trading Activity
          <span class="text-sm font-normal text-gray-500 ml-2">({stockTrades.length} transactions)</span>
        </h2>

        {/* Trade summary */}
        {(() => {
          const purchases = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('purchase')).length;
          const sales = stockTrades.filter((t: any) => (t.type || '').toLowerCase().includes('sale')).length;
          const tickers = [...new Set(stockTrades.map((t: any) => t.ticker).filter(Boolean))];
          return (
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="text-center p-3 bg-green-50 rounded-lg">
                <div class="text-xl font-bold text-green-600">{purchases}</div>
                <div class="text-xs text-gray-500">Purchases</div>
              </div>
              <div class="text-center p-3 bg-red-50 rounded-lg">
                <div class="text-xl font-bold text-red-600">{sales}</div>
                <div class="text-xs text-gray-500">Sales</div>
              </div>
              <div class="text-center p-3 bg-blue-50 rounded-lg">
                <div class="text-xl font-bold text-blue-600">{tickers.length}</div>
                <div class="text-xs text-gray-500">Unique Stocks</div>
              </div>
            </div>
          );
        })()}

        {/* Top tickers */}
        {(() => {
          const tickerCount = {} as any;
          for (const t of stockTrades) {
            if (t.ticker) tickerCount[t.ticker] = (tickerCount[t.ticker] || 0) + 1;
          }
          const topTickers = Object.entries(tickerCount)
            .sort(([, a], [, b]) => (b as number) - (a as number))
            .slice(0, 10);
          return topTickers.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mb-4">
              {topTickers.map(([ticker, count]) => (
                <span class="inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-blue-50 text-blue-700 font-mono">
                  {ticker} <span class="text-blue-400">({count})</span>
                </span>
              ))}
            </div>
          );
        })()}

        {/* Trade list */}
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500">
                <th class="text-left py-2 font-medium">Date</th>
                <th class="text-left py-2 font-medium">Ticker</th>
                <th class="text-left py-2 font-medium">Asset</th>
                <th class="text-left py-2 font-medium">Type</th>
                <th class="text-right py-2 font-medium">Amount</th>
              </tr>
            </thead>
            <tbody>
              {stockTrades.slice(0, 25).map((t: any) => {
                const typeColor = (t.type || '').toLowerCase().includes('purchase')
                  ? 'text-green-700 bg-green-50'
                  : (t.type || '').toLowerCase().includes('sale')
                  ? 'text-red-700 bg-red-50'
                  : 'text-gray-700 bg-gray-50';
                return (
                  <tr class="border-b border-gray-50 hover:bg-gray-50">
                    <td class="py-1.5 text-gray-500 whitespace-nowrap">{t.transactionDate}</td>
                    <td class="py-1.5 font-mono font-semibold text-blue-700">{t.ticker || '—'}</td>
                    <td class="py-1.5 text-gray-700 max-w-[200px] truncate">{t.assetDescription}</td>
                    <td class="py-1.5">
                      <span class={`inline-flex rounded text-[10px] px-1.5 py-0.5 font-medium ${typeColor}`}>
                        {t.type}
                      </span>
                    </td>
                    <td class="py-1.5 text-right text-gray-600 whitespace-nowrap">{t.amount}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {stockTrades.length > 25 && (
            <p class="text-xs text-gray-400 mt-2">Showing 25 of {stockTrades.length} transactions</p>
          )}
        </div>

        <p class="text-[10px] text-gray-400 mt-3">
          Source: House/Senate Stock Watcher. Data from financial disclosure reports filed with Congress.
        </p>
      </div>
    )}
  </div>
</Layout>
