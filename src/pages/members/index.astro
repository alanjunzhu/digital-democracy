---
import Layout from '../../components/layout/Layout.astro';
import MemberFilter from '../../components/interactive/MemberFilter';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import { buildMemberFinanceIndex } from '../../../shared/member-finance-index.mjs';

let membersData = { total: 0, members: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'members', 'index.json');
  membersData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

// Which members have a trading record, resolved once here rather than per card.
let financeIndex: Record<string, any> = {};
try {
  const financePath = join(process.cwd(), 'data', 'finances', 'by-member.json');
  if (existsSync(financePath)) {
    const pricesDir = join(process.cwd(), 'data', 'prices');
    const cachedTickers = existsSync(pricesDir)
      ? new Set(readdirSync(pricesDir).map((f) => f.replace(/\.json$/, '')))
      : null;
    financeIndex = buildMemberFinanceIndex(
      JSON.parse(readFileSync(financePath, 'utf-8')),
      cachedTickers,
    );
  }
} catch {}

const base = import.meta.env.BASE_URL;

const members: any[] = membersData.members;
const senateCount = members.filter((m: any) => m.chamber === 'Senate').length;
const houseCount = members.filter((m: any) => m.chamber === 'House').length;
const demCount = members.filter((m: any) => m.party === 'Democratic').length;
const repCount = members.filter((m: any) => m.party === 'Republican').length;
const indCount = members.filter((m: any) => m.party === 'Independent').length;
---

<Layout title="Members of Congress" description="Browse all current members of the US Congress. Filter by chamber, party, and state.">
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 lg:gap-10 items-end pb-[18px] border-b border-ink">
      <div>
        <p class="eyebrow mb-3">Directory</p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">
          Members of Congress
        </h1>
      </div>
      <div class="flex flex-wrap gap-8 pb-1">
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{membersData.total}</div>
          <div class="field-label mt-[2px]">Serving</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{senateCount}</div>
          <div class="field-label mt-[2px]">Senate</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{houseCount}</div>
          <div class="field-label mt-[2px]">House</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">
            {demCount}<span class="text-ink-3 text-[18px]"> / </span>{repCount}<span
              class="text-ink-3 text-[18px]"
            >
              /
            </span>{indCount}
          </div>
          <div class="field-label mt-[2px]">D / R / I</div>
        </div>
      </div>
    </div>

    {membersData.members.length > 0 ? (
      <MemberFilter
        members={membersData.members}
        financeIndex={financeIndex}
        baseUrl={base}
        client:load
      />
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No member data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the data fetch script to populate member data.</p>
      </div>
    )}
  </div>
</Layout>
