---
import Layout from '../components/layout/Layout.astro';
import PartyBadge from '../components/shared/PartyBadge.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

let membersData = { total: 0, members: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'members', 'index.json');
  membersData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

let billsData = { total: 0, bills: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'bills', 'index.json');
  billsData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

let votesData: any = { total: 0, votes: [], houseTotal: 0, senateTotal: 0 };
try {
  const dataPath = join(process.cwd(), 'data', 'votes', 'index.json');
  votesData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

const senators = membersData.members.filter((m: any) => m.chamber === 'Senate');
const representatives = membersData.members.filter((m: any) => m.chamber === 'House');
const democrats = membersData.members.filter((m: any) => m.party === 'Democratic');
const republicans = membersData.members.filter((m: any) => m.party === 'Republican');
const independents = membersData.members.filter((m: any) => m.party === 'Independent');
const base = import.meta.env.BASE_URL;

const stats = [
  { label: 'Members serving', value: membersData.total },
  { label: 'Senators', value: senators.length },
  { label: 'Representatives', value: representatives.length },
  { label: 'Roll call votes', value: votesData.total },
];

const nf = new Intl.NumberFormat('en-US');
---

<Layout title="Home">
  <!-- Lede + stat ledger -->
  <section class="max-w-measure mx-auto px-10 pt-14 pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-12 lg:gap-[72px] items-end">
      <div>
        <p class="eyebrow mb-[18px]">Transparency record</p>
        <h1
          class="font-serif text-[44px] md:text-[60px] leading-[1.02] font-normal tracking-[-0.022em] mb-5 text-balance"
        >
          Everything Congress does in public, on one page.
        </h1>
        <p class="text-[17px] leading-[1.6] text-ink-2 max-w-[56ch] mb-[26px] text-pretty">
          Members, bills, roll calls, committee referrals and STOCK Act filings — assembled from
          official sources for the {membersData.congress}th Congress, updated automatically, free to
          read and to fork.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`${base}members/`}
            class="inline-flex items-center px-5 py-[11px] bg-ink text-paper text-[14px] font-semibold rounded hover:bg-accent hover:text-white"
          >
            Browse members
          </a>
          <a
            href={`${base}bills/`}
            class="inline-flex items-center px-[19px] py-[10px] border border-ink text-[14px] font-semibold rounded hover:bg-ink hover:text-paper"
          >
            Browse bills
          </a>
          <a
            href={`${base}finances/`}
            class="inline-flex items-center gap-[6px] px-1 py-[10px] text-[14px] font-medium text-ink-2 hover:text-accent"
          >
            Trading dashboard &rarr;
          </a>
        </div>
      </div>
      <div class="border-t border-ink pt-[14px]">
        {stats.map(s => (
          <div class="flex items-baseline justify-between gap-4 py-[11px] border-b border-rule">
            <span class="text-[13px] font-medium text-ink-2">{s.label}</span>
            <span class="font-serif text-[30px] leading-none font-medium tracking-[-0.01em] tabular">
              {nf.format(s.value)}
            </span>
          </div>
        ))}
        <p class="font-mono text-[11px] leading-[1.5] text-ink-3 mt-3">
          {democrats.length} D &middot; {republicans.length} R &middot; {independents.length} I
        </p>
      </div>
    </div>
  </section>

  <!-- Members strip -->
  {membersData.members.length > 0 && (
    <section class="max-w-measure mx-auto px-10 pb-2">
      <div class="flex items-baseline justify-between gap-6 border-t border-ink pt-3 mb-5">
        <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">Members of Congress</h2>
        <a
          href={`${base}members/`}
          class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-3 hover:text-accent whitespace-nowrap"
        >
          All {nf.format(membersData.total)} &rarr;
        </a>
      </div>
      <div class="tile-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {membersData.members.slice(0, 8).map((m: any) => (
          <a
            href={`${base}members/${m.bioguideId}/`}
            class="group flex items-start gap-3 bg-card px-4 py-[14px] hover:bg-rule-2"
          >
            <img
              src={m.imageUrl}
              alt=""
              class="w-10 h-[52px] object-cover rounded-[1px] bg-rule grayscale contrast-[1.05] shrink-0"
              loading="lazy"
            />
            <div class="flex-1 min-w-0">
              <h3 class="font-serif text-[17px] leading-[1.2] font-medium group-hover:text-accent text-pretty">
                {m.name}
              </h3>
              <p class="font-mono text-[11px] text-ink-3 mt-[5px] truncate">{m.state}</p>
              <div class="flex items-center gap-[6px] mt-[7px]">
                <PartyBadge party={m.party} size="sm" />
                <span class="font-mono text-[10px] tracking-[0.06em] uppercase text-ink-3">
                  {m.chamber}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recent bills · recent roll calls -->
  <section class="max-w-measure mx-auto px-10 pt-11">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
      {billsData.bills.length > 0 && (
        <div>
          <div class="flex items-baseline justify-between gap-6 border-t border-ink pt-3 mb-[6px]">
            <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">Recent bills</h2>
            <a
              href={`${base}bills/`}
              class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-3 hover:text-accent whitespace-nowrap"
            >
              All {nf.format(billsData.total)} &rarr;
            </a>
          </div>
          {billsData.bills.slice(0, 5).map((b: any) => (
            <a
              href={`${base}bills/${b.billId}/`}
              class="grid grid-cols-[78px_minmax(0,1fr)] gap-4 py-[15px] border-b border-rule hover:border-ink-3"
            >
              <span class="font-mono text-[12px] font-medium text-accent pt-[2px]">
                {b.type} {b.number}
              </span>
              <div>
                <h3 class="font-serif text-[18px] leading-[1.28] font-medium line-clamp-2">
                  {b.title}
                </h3>
                <p class="text-[12.5px] leading-[1.45] text-ink-3 mt-[6px]">
                  {b.sponsor?.name && `Sponsor: ${b.sponsor.name}`}
                  {b.introducedDate && ` · Introduced ${b.introducedDate}`}
                </p>
              </div>
            </a>
          ))}
        </div>
      )}

      {votesData.votes.length > 0 && (
        <div>
          <div class="flex items-baseline justify-between gap-6 border-t border-ink pt-3 mb-[6px]">
            <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">Recent roll calls</h2>
            <a
              href={`${base}votes/`}
              class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-3 hover:text-accent whitespace-nowrap"
            >
              All {nf.format(votesData.total)} &rarr;
            </a>
          </div>
          {votesData.votes.slice(0, 5).map((v: any) => {
            const agreed = v.result === 'Passed' || v.result === 'Agreed to';
            const total = v.totalYea + v.totalNay;
            const yeaPct = total > 0 ? Math.round((v.totalYea / total) * 100) : 50;
            return (
              <a href={`${base}votes/${v.voteId}/`} class="block py-[15px] border-b border-rule hover:border-ink-3">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-serif text-[18px] leading-[1.28] font-medium line-clamp-2">
                    {v.question}
                  </h3>
                  <span
                    class:list={[
                      'font-mono text-[11px] font-semibold tracking-[0.04em] uppercase whitespace-nowrap',
                      agreed ? 'text-yea' : 'text-accent',
                    ]}
                  >
                    {agreed ? 'Agreed' : 'Rejected'}
                  </span>
                </div>
                <div class="flex items-center gap-3 mt-[10px]">
                  <div class="flex w-[150px] h-1 bg-rule shrink-0">
                    <div class="h-full bg-yea" style={`width: ${yeaPct}%`}></div>
                    <div class="h-full bg-accent" style={`width: ${100 - yeaPct}%`}></div>
                  </div>
                  <span class="font-mono text-[11.5px] text-ink-2 tabular">
                    {v.totalYea}&ndash;{v.totalNay}
                  </span>
                  <span class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3">
                    {v.chamber}
                  </span>
                  {v.date && <span class="font-mono text-[11px] text-ink-3 ml-auto">{v.date}</span>}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- About + caveat -->
  <section class="max-w-measure mx-auto px-10 pt-14 pb-16">
    <div class="border-t border-ink pt-3 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] gap-8 lg:gap-14">
      <h2 class="font-serif text-2xl font-medium tracking-[-0.01em]">About this project</h2>
      <div>
        <p class="text-[15px] leading-[1.65] text-ink-2 max-w-prose mb-[14px] text-pretty">
          Congress Tracker is a free, open-source tool for following what happens in the US Congress.
          Everything on it comes from official public sources — the
          <a href="https://api.congress.gov" class="text-ink border-b border-rule" target="_blank" rel="noopener">Congress.gov API</a>,
          the
          <a href="https://github.com/unitedstates/congress-legislators" class="text-ink border-b border-rule" target="_blank" rel="noopener">unitedstates project</a>,
          House and Senate clerk records, and STOCK Act disclosures.
        </p>
        <p class="text-[15px] leading-[1.65] text-ink-2 max-w-prose mb-[14px] text-pretty">
          The site is a static build: scheduled jobs fetch and commit the data, and a push rebuilds
          the pages. No servers to maintain.
        </p>
        <p class="font-mono text-[11.5px] leading-[1.6] text-ink-3 max-w-[70ch] border-l-2 border-accent pl-3">
          Dollar figures in the financial sections are estimates — disclosures report amounts as
          ranges, and every trade is modelled at the midpoint. A flagged overlap between a trade and
          a committee is a reason to look closer, not a finding of wrongdoing.
        </p>
      </div>
    </div>
  </section>
</Layout>
