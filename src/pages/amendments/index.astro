---
import Layout from '../../components/layout/Layout.astro';
import AmendmentFilter from '../../components/interactive/AmendmentFilter';
import { readFileSync } from 'fs';
import { join } from 'path';
import type { AmendmentsIndex } from '../../lib/types';

let data: AmendmentsIndex = { lastUpdated: '', congress: 119, total: 0, amendments: [] };
try {
  data = JSON.parse(readFileSync(join(process.cwd(), 'data', 'amendments', 'index.json'), 'utf-8'));
} catch {}

const amendments = data.amendments || [];
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Amendments"
  description="Amendments offered to legislation in the 119th Congress, with the bill each one changes and the roll call taken on it."
>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 lg:gap-10 items-end pb-[18px] border-b border-ink">
      <div>
        <p class="eyebrow mb-3">Legislation</p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">
          Amendments
        </h1>
      </div>
      {/* The right column states what the page is and how to read it, rather
          than repeating counts the chip band below already carries. */}
      <p class="font-mono text-[12px] leading-[1.7] text-ink-3 lg:text-right m-0">
        {amendments.length} amendments indexed<br />
        Disposition is read from the latest recorded action
      </p>
    </div>

    {amendments.length > 0 ? (
      <>
        <AmendmentFilter amendments={amendments} baseUrl={base} client:load />
        <p class="mt-[26px] font-mono text-[11.5px] leading-[1.6] text-ink-3 max-w-[70ch] border-l-2 border-accent pl-3">
          Disposition is inferred from the wording of the latest action, not from a
          status field. An amendment that fell with the one it was attached to reads
          as rejected; one that was never called up stays pending.
        </p>
      </>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No amendment data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the data fetch script to populate amendment data.</p>
      </div>
    )}
  </div>
</Layout>
