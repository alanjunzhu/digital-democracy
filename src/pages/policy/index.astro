---
import Layout from '../../components/layout/Layout.astro';
import PolicyStanceChart from '../../components/interactive/PolicyStanceChart';
import type { PolicyIndex } from '../../lib/policy-areas';
import { loadPolicyIndex } from '../../../shared/policy-data.mjs';
import { loadDataJSON } from '../../../shared/data-loader.mjs';

const votesIndex = loadDataJSON('votes/index.json') || { congress: 119 };

const index: PolicyIndex = loadPolicyIndex();
const { coverage } = index;
const widestGap = [...index.areas]
  .map(area => ({
    area,
    gap: area.partyStand.democratic != null && area.partyStand.republican != null
      ? Math.abs(area.partyStand.republican - area.partyStand.democratic)
      : -1,
  }))
  .sort((a, b) => b.gap - a.gap)[0];

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Policy Areas"
  description="Where every senator and representative stands across policy areas, and how the two parties line up, in one chart."
>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="pb-5 border-b border-ink">
      <p class="eyebrow mb-3">Analysis</p>
      <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">Policy areas</h1>
      <p class="text-[14px] leading-[1.6] text-ink-2 max-w-prose mt-3">
        Where members stand across {index.areas.length} policy areas of the {votesIndex.congress || 119}th Congress,
        scored on {coverage.contested} roll calls that split the two parties.
      </p>
    </div>

    {index.areas.length > 0 ? (
      <>
        <div class="flex flex-wrap items-stretch border border-rule bg-card mt-6 mb-8">
          <div class="flex-1 min-w-[150px] px-5 py-4 border-r border-rule">
            <div class="field-label">Roll calls classified</div>
            <div class="font-serif text-2xl font-medium tabular mt-2">{coverage.classified}</div>
            <div class="text-[11.5px] text-ink-3 mt-1">of {coverage.total} in this Congress</div>
          </div>
          <div class="flex-1 min-w-[150px] px-5 py-4 border-r border-rule">
            <div class="field-label">Splitting the parties</div>
            <div class="font-serif text-2xl font-medium tabular mt-2">{coverage.contested}</div>
            <div class="text-[11.5px] text-ink-3 mt-1">party majorities on opposite sides</div>
          </div>
          <div class="flex-1 min-w-[150px] px-5 py-4 border-r border-rule">
            <div class="field-label">Members scored</div>
            <div class="font-serif text-2xl font-medium tabular mt-2">{index.members.length}</div>
            <div class="text-[11.5px] text-ink-3 mt-1">at least {index.minMemberVotes} votes in an area</div>
          </div>
          <div class="flex-1 min-w-[150px] px-5 py-4">
            <div class="field-label">Widest party gap</div>
            <div class="font-serif text-2xl font-medium tabular mt-2">{widestGap && widestGap.gap >= 0 ? `${Math.round(widestGap.gap)} pts` : '—'}</div>
            <div class="text-[11.5px] text-ink-3 mt-1">{widestGap?.area.label}</div>
          </div>
        </div>

        <PolicyStanceChart index={index} baseUrl={base} client:load />

        <div class="mt-10 pt-3 border-t border-ink">
          <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] mb-4">How these scores are built</h2>
          <div class="space-y-3 text-[14px] leading-[1.65] text-ink-2 max-w-prose">
            <p>
              Every roll call is sorted into a policy area from the vote's own topic, the policy area of the
              bill it names, or the wording of the question. {coverage.procedural} votes are floor mechanics
              (cloture, the previous question, motions to table) and {coverage.unclassified} carry no subject
              wording at all — House questions are usually just "On Passage" — so neither group is scored.
            </p>
            <p>
              Only <strong class="text-ink font-semibold">contested</strong> roll calls count: those where a majority of Democrats voted one way and a
              majority of Republicans the other. Lopsided votes say nothing about where a member stands.
              <strong class="text-ink font-semibold"> Support</strong> is the share of an area's contested measures a member voted for.
              <strong class="text-ink font-semibold"> Party-line lean</strong> runs from &minus;100 (always with the Democratic majority) to +100 (always with
              the Republican one). The two chambers vote on different measures, so compare within a chamber.
            </p>
            <p>
              An area appears once it has at least {index.minAreaVotes} contested roll calls; a member is plotted in an
              area once they cast at least {index.minMemberVotes} votes in it.
            </p>
          </div>
        </div>
      </>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No vote data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the vote fetch script to populate roll calls.</p>
      </div>
    )}
  </div>
</Layout>
