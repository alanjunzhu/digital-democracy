---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { BillSummary, CommitteeDetail, CommitteeSummary } from '../../lib/types';
import { getCommitteeWebUrl } from '../../../shared/congress-urls.mjs';
import { getBillsByCommittee, mergeCommitteeBills } from '../../lib/committee-bills';
import { buildCommitteeMemberIndex, getCommitteeMembers } from '../../../shared/committee-members.mjs';
import MemberCard from '../../components/members/MemberCard.astro';

export function getStaticPaths() {
  const committeesDir = join(process.cwd(), 'data', 'committees');
  const paths: { params: { committeeId: string } }[] = [];

  if (existsSync(committeesDir)) {
    const files = readdirSync(committeesDir);
    for (const file of files) {
      if (file === 'index.json') continue;
      if (!file.endsWith('.json')) continue;
      const committeeId = file.replace('.json', '');
      paths.push({ params: { committeeId } });
    }
  }

  return paths;
}

const { committeeId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'committees', `${committeeId}.json`);
const committee: CommitteeDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const loadJSON = (relativePath: string) => {
  const fullPath = join(process.cwd(), 'data', relativePath);
  if (!existsSync(fullPath)) return null;
  try {
    return JSON.parse(readFileSync(fullPath, 'utf-8'));
  } catch {
    return null;
  }
};

const committeesData = loadJSON('committees/index.json') || {};
const committeeIndex: CommitteeSummary[] = committeesData.committees || [];
const knownCommitteeCodes = new Set(committeeIndex.map(c => c.systemCode));

// Subcommittees have no congress.gov profile of their own; their legislation is
// listed under the parent committee there.
const parentCode = committee.parent?.systemCode;
const parent = parentCode ? committeeIndex.find(c => c.systemCode === parentCode) || null : null;
// Derived rather than read from the record, so committee data written before
// the URL format was corrected still links to a real page.
const congressGovUrl =
  getCommitteeWebUrl(committee.chamber, committee.systemCode, committee.name) ||
  (parent ? getCommitteeWebUrl(parent.chamber, parent.systemCode, parent.name) : null);

// Bill titles live in the bills index; committee records only store refs.
const billsIndex: BillSummary[] = loadJSON('bills/index.json')?.bills || [];
const billsById = new Map(billsIndex.map(b => [b.billId, b]));
const referredBills = mergeCommitteeBills(
  committee.bills,
  getBillsByCommittee().get(committee.systemCode)
).map(ref => ({
  ...ref,
  title: billsById.get(ref.billId)?.title || '',
  hasPage: billsById.has(ref.billId),
}));

const financeData = loadJSON('finances/by-member.json');
const membersIndex = loadJSON('members/index.json')?.members || [];
const committeeMemberIndex = financeData
  ? buildCommitteeMemberIndex(financeData, membersIndex)
  : {};
const committeeMembers = getCommitteeMembers(committeeMemberIndex, committee.name);

const chamberColor = (ch: string) => {
  if (ch === 'Senate') return 'bg-amber-100 text-amber-800';
  if (ch === 'House') return 'bg-emerald-100 text-emerald-800';
  return 'bg-blue-100 text-blue-800';
};

const pageSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'committee-members', label: 'Committee Members', count: committeeMembers.length },
  { id: 'legislation', label: 'Legislation', count: referredBills.length },
  {
    id: 'subcommittees',
    label: 'Subcommittees',
    when: committee.subcommittees?.length,
    count: committee.subcommittees?.length,
  },
];
---

<Layout title={committee.name} description={`${committee.name} — ${committee.chamber} Committee`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageIndex sections={pageSections} />

    <!-- Back link -->
    <a href={`${base}committees/`} class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">
      &larr; All Committees
    </a>

    <!-- Committee Header -->
    <div id="overview" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center gap-3 mb-3">
        <span class={`inline-flex items-center font-medium rounded-full text-xs px-2 py-0.5 ${chamberColor(committee.chamber)}`}>
          {committee.chamber}
        </span>
        {committee.committeeType && (
          <span class="text-sm text-gray-400">{committee.committeeType}</span>
        )}
        <span class="font-mono text-xs text-gray-400">{committee.systemCode}</span>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{committee.name}</h1>

      {parent && (
        <p class="text-sm text-gray-500 mb-3">
          Subcommittee of{' '}
          <a href={`${base}committees/${parent.systemCode}/`} class="text-blue-600 hover:underline">{parent.name}</a>
        </p>
      )}

      <div class="flex flex-wrap gap-4 text-sm">
        {congressGovUrl && (
          <a href={congressGovUrl} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
            {committee.isSubcommittee && parent ? 'Parent committee on Congress.gov' : 'View on Congress.gov'}
          </a>
        )}
        {committee.officialWebsite && (
          <a href={committee.officialWebsite} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
            Official website
          </a>
        )}
      </div>
    </div>

    <!-- Committee Members -->
    <div id="committee-members" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">
        Committee Members ({committeeMembers.length})
      </h2>
      <p class="text-xs text-gray-400 mb-4">
        Current membership from official committee rosters.
      </p>
      {committeeMembers.length === 0 ? (
        <p class="text-sm text-gray-500">
          No member roster matched this committee yet.
        </p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {committeeMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      )}
    </div>

    <!-- Legislation -->
    <div id="legislation" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">
        Legislation ({referredBills.length})
      </h2>
      <p class="text-xs text-gray-400 mb-3">
        Measures referred to this committee in the {committeesData.congress ?? 119}th Congress, most recent activity first.
      </p>
      {referredBills.length === 0 ? (
        <p class="text-sm text-gray-500">
          No legislation from this Congress has been recorded for this committee yet.
        </p>
      ) : (
        <div class="divide-y divide-gray-100">
          {referredBills.map(bill => (
            <div class="flex items-start gap-3 py-2">
              {bill.hasPage ? (
                <a href={`${base}bills/${bill.billId}/`} class="font-mono text-sm font-semibold text-blue-700 hover:underline whitespace-nowrap">
                  {bill.type} {bill.number}
                </a>
              ) : bill.url ? (
                <a href={bill.url} target="_blank" rel="noopener" class="font-mono text-sm font-semibold text-blue-700 hover:underline whitespace-nowrap">
                  {bill.type} {bill.number}
                </a>
              ) : (
                <span class="font-mono text-sm font-semibold text-gray-700 whitespace-nowrap">
                  {bill.type} {bill.number}
                </span>
              )}
              <div class="flex-1 min-w-0">
                {bill.title && <p class="text-sm text-gray-900 line-clamp-2">{bill.title}</p>}
                <div class="flex flex-wrap items-center gap-2 mt-0.5 text-xs text-gray-500">
                  {bill.relationshipType && <span>{bill.relationshipType}</span>}
                  {bill.actionDate && <span class="text-gray-400">{bill.actionDate}</span>}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Subcommittees -->
    {committee.subcommittees && committee.subcommittees.length > 0 && (
      <div id="subcommittees" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">
          Subcommittees ({committee.subcommittees.length})
        </h2>
        <div class="space-y-2">
          {committee.subcommittees.map(sc => knownCommitteeCodes.has(sc.systemCode) ? (
            <a
              href={`${base}committees/${sc.systemCode}/`}
              class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0 hover:bg-gray-50 -mx-2 px-2 rounded"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              <span class="text-sm text-blue-700 hover:underline">{sc.name}</span>
              <span class="font-mono text-xs text-gray-400">{sc.systemCode}</span>
            </a>
          ) : (
            <div class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              <span class="text-sm text-gray-700">{sc.name}</span>
              <span class="font-mono text-xs text-gray-400">{sc.systemCode}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
