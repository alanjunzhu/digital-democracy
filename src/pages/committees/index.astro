---
import Layout from '../../components/layout/Layout.astro';
import CommitteeFilter from '../../components/interactive/CommitteeFilter';
import { readFileSync } from 'fs';
import { join } from 'path';

let committeesData = { total: 0, committees: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'committees', 'index.json');
  committeesData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

const base = import.meta.env.BASE_URL;
---

<Layout title="Committees" description="Browse all committees of the US Congress. Filter by chamber.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Committees</h1>
      <p class="text-gray-500 mt-1">
        {committeesData.congress}th Congress &middot; {committeesData.total} committees
      </p>
    </div>

    {committeesData.committees.length > 0 ? (
      <CommitteeFilter committees={committeesData.committees} baseUrl={base} client:load />
    ) : (
      <div class="text-center py-16 text-gray-500">
        <p class="text-lg">No committee data available yet.</p>
        <p class="mt-2 text-sm">Run the data fetch script to populate committee data.</p>
      </div>
    )}
  </div>
</Layout>
