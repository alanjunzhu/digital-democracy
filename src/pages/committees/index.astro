---
import Layout from '../../components/layout/Layout.astro';
import CommitteeFilter from '../../components/interactive/CommitteeFilter';
import { readFileSync } from 'fs';
import { join } from 'path';

let committeesData = { total: 0, committees: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'committees', 'index.json');
  committeesData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

const base = import.meta.env.BASE_URL;

const committees: any[] = committeesData.committees;
const houseCount = committees.filter((c: any) => c.chamber === 'House').length;
const senateCount = committees.filter((c: any) => c.chamber === 'Senate').length;
const jointCount = committees.filter((c: any) => c.chamber === 'Joint').length;
---

<Layout title="Committees" description="Browse all committees of the US Congress. Filter by chamber.">
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 lg:gap-10 items-end pb-[18px] border-b border-ink">
      <div>
        <p class="eyebrow mb-3">Where bills go</p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">
          Committees
        </h1>
      </div>
      <div class="flex flex-wrap gap-8 pb-1">
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{houseCount}</div>
          <div class="field-label mt-[2px]">House</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{senateCount}</div>
          <div class="field-label mt-[2px]">Senate</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{jointCount}</div>
          <div class="field-label mt-[2px]">Joint</div>
        </div>
      </div>
    </div>

    {committeesData.committees.length > 0 ? (
      <CommitteeFilter committees={committeesData.committees} baseUrl={base} client:load />
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No committee data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the data fetch script to populate committee data.</p>
      </div>
    )}
  </div>
</Layout>
