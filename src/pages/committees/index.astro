---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Committees" description="Browse committees of the US Congress.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Committees</h1>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
      <p class="text-gray-500 text-lg">Committee tracking coming soon.</p>
      <p class="text-gray-400 text-sm mt-2">This section will list all congressional committees and their members.</p>
    </div>
  </div>
</Layout>
