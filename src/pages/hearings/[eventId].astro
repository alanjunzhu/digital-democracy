---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { HearingDetail } from '../../lib/types';
import { isUpcoming, meetingLabel, meetingStatusDot, meetingStatusText } from '../../lib/utils';

export function getStaticPaths() {
  const dir = join(process.cwd(), 'data', 'hearings');
  const paths: { params: { eventId: string } }[] = [];

  if (existsSync(dir)) {
    for (const file of readdirSync(dir)) {
      if (file === 'index.json' || !file.endsWith('.json')) continue;
      paths.push({ params: { eventId: file.replace('.json', '') } });
    }
  }

  return paths;
}

const { eventId } = Astro.params;
const meeting: HearingDetail = JSON.parse(
  readFileSync(join(process.cwd(), 'data', 'hearings', `${eventId}.json`), 'utf-8'),
);
const base = import.meta.env.BASE_URL;

const builtAt = Date.now();
const ahead = isUpcoming(meeting, builtAt);
const statusLabel = meetingLabel(meeting, builtAt);

const when = (() => {
  if (!meeting.date) return { day: '', time: '' };
  const d = new Date(meeting.date);
  if (Number.isNaN(d.getTime())) return { day: meeting.date.slice(0, 10), time: '' };
  return {
    day: d.toLocaleDateString('en-GB', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }),
    time: d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }),
  };
})();

// Link a committee only where a page for it was actually built.
const committeesDir = join(process.cwd(), 'data', 'committees');
const committees = (meeting.committees || []).map(c => ({
  ...c,
  isLocal: existsSync(join(committeesDir, `${c.systemCode}.json`)),
}));

const billsDir = join(process.cwd(), 'data', 'bills');
const relatedBills = (meeting.relatedBillIds || []).map(id => {
  const path = join(billsDir, `${id}.json`);
  let title = '';
  if (existsSync(path)) {
    try {
      title = JSON.parse(readFileSync(path, 'utf-8')).title || '';
    } catch {}
  }
  return { id, title, isLocal: Boolean(title) || existsSync(path) };
});

const witnesses = meeting.witnesses || [];
const documents = meeting.meetingDocuments || [];
const videos = meeting.videos || [];
const location = meeting.location;
const heading = meeting.title || meeting.type || 'Committee meeting';

const pageSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'committees', label: 'Committees', when: committees.length, count: committees.length },
  { id: 'legislation', label: 'Legislation', when: relatedBills.length, count: relatedBills.length },
  { id: 'witnesses', label: 'Witnesses', when: witnesses.length, count: witnesses.length },
  { id: 'documents', label: 'Documents', when: documents.length || videos.length, count: documents.length + videos.length },
];
---

<Layout title={heading} description={`${meeting.type || 'Committee meeting'} — ${meetingLabel(meeting, Date.now())}`}>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <PageIndex sections={pageSections} />

    <a href={`${base}hearings/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3 hover:text-accent">
      &larr; All committee meetings
    </a>

    <div id="overview" data-page-section class="mt-4 pb-5 border-b border-ink">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        {meeting.type && (
          <span class="font-mono text-[13px] font-medium text-accent">{meeting.type}</span>
        )}
        <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">
          {meeting.chamber === 'NoChamber' ? 'Joint' : meeting.chamber}
        </span>
        <span class={`inline-flex items-center gap-[7px] font-mono text-[10.5px] tracking-[0.06em] uppercase border border-ink-3 rounded px-2 py-1 ${meetingStatusText(statusLabel)}`}>
          <span class={`w-[5px] h-[5px] rounded-full shrink-0 ${meetingStatusDot(statusLabel)}`} />
          {statusLabel}
        </span>
      </div>

      <h1 class="font-serif text-[28px] md:text-[34px] leading-[1.15] font-normal tracking-[-0.015em] max-w-prose text-pretty">
        {heading}
      </h1>

      <div class="flex flex-wrap gap-x-10 gap-y-3 mt-5">
        <div>
          <div class="field-label">{ahead ? 'Scheduled for' : 'Held'}</div>
          <div class="font-mono text-[13px] tabular mt-[3px]">
            {when.day || 'No date listed'}{when.time ? ` · ${when.time}` : ''}
          </div>
        </div>
        {location && (location.room || location.building) && (
          <div>
            <div class="field-label">Location</div>
            <div class="font-mono text-[13px] mt-[3px]">
              {[location.room, location.building, location.address].filter(Boolean).join(', ')}
            </div>
          </div>
        )}
        {meeting.url && (
          <div>
            <div class="field-label">Source</div>
            <a
              href={meeting.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[13px] text-accent underline underline-offset-[3px] mt-[3px] inline-block"
            >
              congress.gov
            </a>
          </div>
        )}
      </div>

      {/* Stated on every scheduled meeting, because this is the page a reader
          would otherwise act on. A past meeting needs no such warning. */}
      {ahead && (
        <p class="mt-5 max-w-prose font-mono text-[11px] leading-[1.6] text-ink-3 border-l-2 border-rule pl-3">
          This page was built from a scheduled fetch, not a live feed. The committee
          can cancel or move a meeting after the build, so confirm with the committee
          before relying on this time.
        </p>
      )}
    </div>

    {committees.length > 0 && (
      <section id="committees" data-page-section class="pt-8">
        <h2 class="font-serif text-[22px] font-medium pb-[10px] border-b border-ink">Committees</h2>
        {committees.map(c => (
          c.isLocal ? (
            <a
              href={`${base}committees/${c.systemCode}/`}
              class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule hover:border-ink-3"
            >
              <span class="font-mono text-[11.5px] uppercase text-ink-3">{c.systemCode}</span>
              <span class="font-serif text-[17px] font-medium">{c.name}</span>
            </a>
          ) : (
            <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule">
              <span class="font-mono text-[11.5px] uppercase text-ink-3">{c.systemCode}</span>
              <span class="font-serif text-[17px] font-medium text-ink-2">{c.name}</span>
            </div>
          )
        ))}
      </section>
    )}

    {relatedBills.length > 0 && (
      <section id="legislation" data-page-section class="pt-8">
        <h2 class="font-serif text-[22px] font-medium pb-[10px] border-b border-ink">Legislation at issue</h2>
        {relatedBills.map(b => (
          b.isLocal ? (
            <a
              href={`${base}bills/${b.id}/`}
              class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule hover:border-ink-3"
            >
              <span class="font-mono text-[12.5px] font-medium text-accent">{b.id.toUpperCase()}</span>
              <span class="text-[14px] leading-[1.45] text-ink-2">{b.title || 'Untitled'}</span>
            </a>
          ) : (
            <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule">
              <span class="font-mono text-[12.5px] font-medium text-ink-2">{b.id.toUpperCase()}</span>
              <span class="font-mono text-[11px] text-ink-3">Not in the tracked set of bills.</span>
            </div>
          )
        ))}
      </section>
    )}

    {witnesses.length > 0 && (
      <section id="witnesses" data-page-section class="pt-8">
        <h2 class="font-serif text-[22px] font-medium pb-[10px] border-b border-ink">
          Witnesses <span class="font-mono text-[11px] text-ink-3 tabular">{witnesses.length}</span>
        </h2>
        {witnesses.map(w => (
          <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule">
            <span class="font-serif text-[17px] font-medium">{w.name}</span>
            <span class="text-[13.5px] leading-[1.45] text-ink-2">
              {[w.position, w.organization].filter(Boolean).join(', ')}
            </span>
          </div>
        ))}
      </section>
    )}

    {(documents.length > 0 || videos.length > 0) && (
      <section id="documents" data-page-section class="pt-8">
        <h2 class="font-serif text-[22px] font-medium pb-[10px] border-b border-ink">Documents and video</h2>
        {documents.map(d => (
          <a
            href={d.url}
            target="_blank"
            rel="noopener noreferrer"
            class="grid grid-cols-[90px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule hover:border-ink-3"
          >
            <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">{d.format || 'Doc'}</span>
            <span class="text-[14px] text-accent underline underline-offset-[3px]">{d.name || d.url}</span>
          </a>
        ))}
        {videos.map(v => (
          <a
            href={v.url}
            target="_blank"
            rel="noopener noreferrer"
            class="grid grid-cols-[90px_minmax(0,1fr)] gap-5 items-baseline py-[14px] border-b border-rule hover:border-ink-3"
          >
            <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">Video</span>
            <span class="text-[14px] text-accent underline underline-offset-[3px]">{v.name || v.url}</span>
          </a>
        ))}
      </section>
    )}
  </div>
</Layout>
