---
import Layout from '../../components/layout/Layout.astro';
import HearingFilter from '../../components/interactive/HearingFilter';
import { readFileSync } from 'fs';
import { join } from 'path';
import type { HearingsIndex } from '../../lib/types';
import { compareMeetings } from '../../lib/utils';

let data: HearingsIndex = { lastUpdated: '', congress: 119, total: 0, hearings: [] };
try {
  data = JSON.parse(readFileSync(join(process.cwd(), 'data', 'hearings', 'index.json'), 'utf-8'));
} catch {}

// Frozen here and handed to the island, so the ledger, the filter and the
// caveat below all agree on where "now" was when this page was built.
const builtAt = Date.now();
const hearings = [...(data.hearings || [])].sort((a, b) => compareMeetings(a, b, builtAt));
const base = import.meta.env.BASE_URL;

const buildDate = new Date(builtAt).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<Layout
  title="Hearings"
  description="Committee hearings and markups scheduled in the 119th Congress, with status, room, witnesses and the bills at issue."
>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 lg:gap-10 items-end pb-[18px] border-b border-ink">
      <div>
        <p class="eyebrow mb-3">Committees</p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">
          Hearings
        </h1>
      </div>
      <p class="font-mono text-[12px] leading-[1.7] text-ink-3 lg:text-right m-0">
        {hearings.length} meetings indexed<br />
        A meeting whose date has passed reads Held, whatever the source still says
      </p>
    </div>

    {hearings.length > 0 ? (
      <>
        <HearingFilter hearings={hearings} baseUrl={base} builtAt={builtAt} client:load />
        <p class="mt-[26px] font-mono text-[11.5px] leading-[1.6] text-ink-3 max-w-[70ch] border-l-2 border-accent pl-3">
          A schedule is only as fresh as the last build. A meeting called off after
          {' '}{buildDate} still reads as it did then, so the status is stated on every
          row rather than implied by the row being here at all.
        </p>
      </>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No meeting data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the data fetch script to populate the schedule.</p>
      </div>
    )}
  </div>
</Layout>
