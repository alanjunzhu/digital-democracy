---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Votes" description="Browse roll call votes in the US Congress.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Votes</h1>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
      <p class="text-gray-500 text-lg">Vote tracking coming soon.</p>
      <p class="text-gray-400 text-sm mt-2">This section will show roll call votes with member-by-member breakdowns.</p>
    </div>
  </div>
</Layout>
