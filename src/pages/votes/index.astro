---
import Layout from '../../components/layout/Layout.astro';
import VoteFilter from '../../components/interactive/VoteFilter';
import { readFileSync } from 'fs';
import { join } from 'path';

let votesData: any = { total: 0, houseTotal: 0, senateTotal: 0, votes: [], lastUpdated: '', congress: 119 };
try {
  const dataPath = join(process.cwd(), 'data', 'votes', 'index.json');
  votesData = JSON.parse(readFileSync(dataPath, 'utf-8'));
} catch {}

const base = import.meta.env.BASE_URL;
---

<Layout title="Votes" description="Browse roll call votes from both House and Senate with party breakdowns.">
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 lg:gap-10 items-end pb-[18px] border-b border-ink">
      <div>
        <p class="eyebrow mb-3">The record</p>
        <h1 class="font-serif text-[36px] md:text-[44px] leading-[1.05] font-normal tracking-[-0.02em]">
          Roll call votes
        </h1>
      </div>
      <div class="flex flex-wrap gap-8 pb-1">
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{votesData.total}</div>
          <div class="field-label mt-[2px]">Recorded</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{votesData.houseTotal || 0}</div>
          <div class="field-label mt-[2px]">House</div>
        </div>
        <div>
          <div class="font-serif text-[26px] font-medium tabular">{votesData.senateTotal || 0}</div>
          <div class="field-label mt-[2px]">Senate</div>
        </div>
      </div>
    </div>

    {votesData.votes.length > 0 ? (
      <VoteFilter votes={votesData.votes} baseUrl={base} client:load />
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-2xl font-medium">No vote data available yet.</p>
        <p class="mt-2 text-[13.5px] text-ink-3">Run the data fetch script to populate vote data.</p>
      </div>
    )}
  </div>
</Layout>
