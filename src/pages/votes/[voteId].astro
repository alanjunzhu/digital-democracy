---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { VoteDetail } from '../../lib/types';

export function getStaticPaths() {
  const votesDir = join(process.cwd(), 'data', 'votes');
  const paths: { params: { voteId: string } }[] = [];

  if (existsSync(votesDir)) {
    const files = readdirSync(votesDir);
    for (const file of files) {
      if (file === 'index.json' || file === 'by-member.json') continue;
      if (!file.endsWith('.json')) continue;
      const voteId = file.replace('.json', '');
      paths.push({ params: { voteId } });
    }
  }

  return paths;
}

const { voteId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'votes', `${voteId}.json`);
const vote: VoteDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const totalVotes = vote.totalYea + vote.totalNay;
const yeaPct = totalVotes > 0 ? Math.round((vote.totalYea / totalVotes) * 100) : 0;
const nayPct = 100 - yeaPct;

const resultColor = (r: string) => {
  if (r === 'Passed' || r === 'Agreed to') return 'bg-green-100 text-green-800';
  if (r === 'Failed' || r === 'Rejected') return 'bg-red-100 text-red-800';
  return 'bg-gray-100 text-gray-800';
};

const partyRows = [
  { label: 'Democrats', color: 'text-blue-700', data: vote.partyBreakdown.democratic },
  { label: 'Republicans', color: 'text-red-700', data: vote.partyBreakdown.republican },
  { label: 'Independents', color: 'text-purple-700', data: vote.partyBreakdown.independent },
];

// Group member votes by position
const memberVotes = vote.memberVotes || [];
const yeaVotes = memberVotes.filter(mv => ['yea', 'aye'].includes(mv.voteCast.toLowerCase()));
const nayVotes = memberVotes.filter(mv => ['nay', 'no'].includes(mv.voteCast.toLowerCase()));
const otherVotes = memberVotes.filter(mv => !['yea', 'aye', 'nay', 'no'].includes(mv.voteCast.toLowerCase()));

const partyColor = (p: string) => {
  if (p === 'D' || p === 'Democratic') return 'text-blue-700';
  if (p === 'R' || p === 'Republican') return 'text-red-700';
  return 'text-purple-700';
};

const pageSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'vote-tally', label: 'Vote Tally' },
  { id: 'individual-votes', label: 'Individual Votes', when: memberVotes.length, count: memberVotes.length },
  { id: 'yea-votes', label: 'Yea', when: yeaVotes.length, count: yeaVotes.length, depth: 1 },
  { id: 'nay-votes', label: 'Nay', when: nayVotes.length, count: nayVotes.length, depth: 1 },
  { id: 'other-votes', label: 'Not Voting / Present', when: otherVotes.length, count: otherVotes.length, depth: 1 },
];
---

<Layout title={`Roll Call #${vote.rollCallNumber}`} description={vote.question}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <PageIndex sections={pageSections} />

    <!-- Back link -->
    <a href={`${base}votes/`} class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">
      &larr; All Votes
    </a>

    <!-- Vote Header -->
    <div id="overview" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center gap-3 mb-3">
        <span class="font-mono text-lg font-bold text-gray-700">Roll Call #{vote.rollCallNumber}</span>
        <span class={`inline-flex items-center font-semibold rounded-full text-sm px-2.5 py-0.5 ${resultColor(vote.result)}`}>
          {vote.result}
        </span>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-3">{vote.question}</h1>

      {vote.description && vote.description !== vote.question && (
        <p class="text-gray-600 mb-3">{vote.description}</p>
      )}

      <div class="flex flex-wrap gap-6 text-sm text-gray-600">
        {vote.date && (
          <div><span class="text-gray-400">Date:</span> {vote.date}</div>
        )}
        {vote.voteType && (
          <div><span class="text-gray-400">Type:</span> {vote.voteType}</div>
        )}
        {vote.billId && (
          <div>
            <span class="text-gray-400">Bill:</span>{' '}
            {existsSync(join(process.cwd(), 'data', 'bills', `${vote.billId}.json`)) ? (
              <a href={`${base}bills/${vote.billId}/`} class="text-blue-600 hover:underline">
                {vote.billId.toUpperCase()}
              </a>
            ) : (
              <span class="font-mono">{vote.billId.toUpperCase()}</span>
            )}
          </div>
        )}
      </div>

      <div class="mt-3">
        <a href={vote.url} target="_blank" rel="noopener" class="text-blue-600 hover:underline text-sm">
          {vote.chamber === 'Senate' ? 'View on Senate.gov' : 'View on Clerk.house.gov'}
        </a>
      </div>
    </div>

    <!-- Vote Tally -->
    <div id="vote-tally" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Vote Tally</h2>

      <!-- Overall bar -->
      <div class="mb-6">
        <div class="flex justify-between text-sm font-semibold mb-1">
          <span class="text-green-700">Yea: {vote.totalYea}</span>
          <span class="text-red-700">Nay: {vote.totalNay}</span>
        </div>
        <div class="h-6 bg-gray-100 rounded-full overflow-hidden flex">
          <div class="bg-green-500 h-full flex items-center justify-center text-xs text-white font-bold" style={`width: ${yeaPct}%`}>
            {yeaPct > 10 ? `${yeaPct}%` : ''}
          </div>
          <div class="bg-red-500 h-full flex items-center justify-center text-xs text-white font-bold" style={`width: ${nayPct}%`}>
            {nayPct > 10 ? `${nayPct}%` : ''}
          </div>
        </div>
      </div>

      <!-- Party breakdown table -->
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 text-gray-500 font-medium">Party</th>
            <th class="text-center py-2 text-green-700 font-medium">Yea</th>
            <th class="text-center py-2 text-red-700 font-medium">Nay</th>
            <th class="text-center py-2 text-gray-500 font-medium">Not Voting</th>
          </tr>
        </thead>
        <tbody>
          {partyRows.map(row => (
            (row.data.yea + row.data.nay + row.data.notVoting > 0) && (
              <tr class="border-b border-gray-100">
                <td class={`py-2 font-semibold ${row.color}`}>{row.label}</td>
                <td class="py-2 text-center">{row.data.yea}</td>
                <td class="py-2 text-center">{row.data.nay}</td>
                <td class="py-2 text-center text-gray-400">{row.data.notVoting}</td>
              </tr>
            )
          ))}
          <tr class="font-bold">
            <td class="py-2">Total</td>
            <td class="py-2 text-center text-green-700">{vote.totalYea}</td>
            <td class="py-2 text-center text-red-700">{vote.totalNay}</td>
            <td class="py-2 text-center text-gray-400">
              {partyRows.reduce((sum, r) => sum + r.data.notVoting, 0)}
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Individual Member Votes -->
    {memberVotes.length > 0 && (
      <div id="individual-votes" data-page-section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Individual Votes ({memberVotes.length} members)</h2>

        {/* Yea votes */}
        {yeaVotes.length > 0 && (
          <div id="yea-votes" data-page-section class="mb-6">
            <h3 class="text-sm font-semibold text-green-700 mb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
              Yea ({yeaVotes.length})
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {yeaVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class={`inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-green-50 hover:bg-green-100 transition-colors ${partyColor(mv.party)}`}
                >
                  {mv.name} ({mv.party}-{mv.state})
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Nay votes */}
        {nayVotes.length > 0 && (
          <div id="nay-votes" data-page-section class="mb-6">
            <h3 class="text-sm font-semibold text-red-700 mb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
              Nay ({nayVotes.length})
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {nayVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class={`inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-red-50 hover:bg-red-100 transition-colors ${partyColor(mv.party)}`}
                >
                  {mv.name} ({mv.party}-{mv.state})
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Not Voting / Present */}
        {otherVotes.length > 0 && (
          <div id="other-votes" data-page-section>
            <h3 class="text-sm font-semibold text-gray-500 mb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-gray-400"></span>
              Not Voting / Present ({otherVotes.length})
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {otherVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class={`inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-gray-50 hover:bg-gray-100 transition-colors ${partyColor(mv.party)}`}
                >
                  {mv.name} ({mv.party}-{mv.state}) - {mv.voteCast}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>
