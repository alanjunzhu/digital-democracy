---
import Layout from '../../components/layout/Layout.astro';
import PageIndex from '../../components/layout/PageIndex.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';
import type { VoteDetail } from '../../lib/types';
import { getVoteOutcome } from '../../lib/utils';

export function getStaticPaths() {
  const votesDir = join(process.cwd(), 'data', 'votes');
  const paths: { params: { voteId: string } }[] = [];

  if (existsSync(votesDir)) {
    const files = readdirSync(votesDir);
    for (const file of files) {
      if (file === 'index.json' || file === 'by-member.json') continue;
      if (!file.endsWith('.json')) continue;
      const voteId = file.replace('.json', '');
      paths.push({ params: { voteId } });
    }
  }

  return paths;
}

const { voteId } = Astro.params;
const dataPath = join(process.cwd(), 'data', 'votes', `${voteId}.json`);
const vote: VoteDetail = JSON.parse(readFileSync(dataPath, 'utf-8'));
const base = import.meta.env.BASE_URL;

const totalVotes = vote.totalYea + vote.totalNay;
const yeaPct = totalVotes > 0 ? Math.round((vote.totalYea / totalVotes) * 100) : 0;
const nayPct = 100 - yeaPct;
const outcome = getVoteOutcome(vote.result);
const agreed = outcome === 'agreed';
const rejected = outcome === 'rejected';

const partyRows = [
  { label: 'Democrats', mark: 'D', tone: 'text-dem', data: vote.partyBreakdown.democratic },
  { label: 'Republicans', mark: 'R', tone: 'text-rep', data: vote.partyBreakdown.republican },
  { label: 'Independents', mark: 'I', tone: 'text-ind', data: vote.partyBreakdown.independent },
];
const notVotingTotal = partyRows.reduce((sum, r) => sum + r.data.notVoting, 0);

// Group member votes by position
const memberVotes = vote.memberVotes || [];
const yeaVotes = memberVotes.filter(mv => ['yea', 'aye'].includes(mv.voteCast.toLowerCase()));
const nayVotes = memberVotes.filter(mv => ['nay', 'no'].includes(mv.voteCast.toLowerCase()));
const otherVotes = memberVotes.filter(mv => !['yea', 'aye', 'nay', 'no'].includes(mv.voteCast.toLowerCase()));

const partyTone = (p: string) => {
  if (p === 'D' || p === 'Democratic') return 'text-dem';
  if (p === 'R' || p === 'Republican') return 'text-rep';
  return 'text-ind';
};

const pageSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'vote-tally', label: 'Vote Tally' },
  { id: 'individual-votes', label: 'Individual Votes', when: memberVotes.length, count: memberVotes.length },
  { id: 'yea-votes', label: 'Yea', when: yeaVotes.length, count: yeaVotes.length, depth: 1 },
  { id: 'nay-votes', label: 'Nay', when: nayVotes.length, count: nayVotes.length, depth: 1 },
  { id: 'other-votes', label: 'Not Voting / Present', when: otherVotes.length, count: otherVotes.length, depth: 1 },
];
---

<Layout title={`Roll Call #${vote.rollCallNumber}`} description={vote.question}>
  <div class="max-w-measure mx-auto px-10 pt-11 pb-16">
    <PageIndex sections={pageSections} />

    <a href={`${base}votes/`} class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3 hover:text-accent">
      &larr; All votes
    </a>

    <!-- Header -->
    <div id="overview" data-page-section class="mt-4 pb-5 border-b border-ink">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="font-mono text-[13px] font-medium text-ink-2 tabular">Roll call #{vote.rollCallNumber}</span>
        <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">{vote.chamber}</span>
      </div>
      <h1 class="font-serif text-[32px] leading-[1.15] font-medium text-pretty mb-3">{vote.question}</h1>

      {vote.description && vote.description !== vote.question && (
        <p class="text-[14.5px] leading-[1.6] text-ink-2 max-w-prose mb-4">{vote.description}</p>
      )}

      <div class="flex flex-wrap gap-x-8 gap-y-2 text-[13px] text-ink-2">
        {vote.date && (
          <div><span class="text-ink-3">Date</span> <span class="font-mono tabular">{vote.date}</span></div>
        )}
        {vote.voteType && (
          <div><span class="text-ink-3">Type</span> {vote.voteType}</div>
        )}
        {vote.billId && (
          <div>
            <span class="text-ink-3">Bill</span>{' '}
            {existsSync(join(process.cwd(), 'data', 'bills', `${vote.billId}.json`)) ? (
              <a href={`${base}bills/${vote.billId}/`} class="font-mono font-medium text-accent hover:underline">
                {vote.billId.toUpperCase()}
              </a>
            ) : (
              <span class="font-mono">{vote.billId.toUpperCase()}</span>
            )}
          </div>
        )}
      </div>

      <div class="mt-3">
        <a href={vote.url} target="_blank" rel="noopener" class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent hover:underline">
          {vote.chamber === 'Senate' ? 'View on Senate.gov' : 'View on Clerk.house.gov'}
        </a>
      </div>
    </div>

    <!-- Outcome -->
    <div id="vote-tally" data-page-section class="pt-8">
      <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">Outcome</h2>

      <div class="flex items-baseline justify-between gap-4 mb-2">
        <span class={`font-mono text-[13px] font-semibold tracking-[0.05em] uppercase ${agreed ? 'text-yea' : rejected ? 'text-accent' : 'text-ink-3'}`}>
          {agreed ? 'Agreed' : rejected ? 'Rejected' : vote.result}
        </span>
        <span class="font-serif text-[26px] font-medium tabular">{vote.totalYea}&ndash;{vote.totalNay}</span>
      </div>
      <div class="flex h-1 bg-rule">
        <div class="h-full bg-yea" style={`width: ${yeaPct}%`}></div>
        <div class="h-full bg-accent" style={`width: ${nayPct}%`}></div>
      </div>
      <p class="font-mono text-[10.5px] text-ink-3 mt-2">{vote.result}</p>

      <!-- Party breakdown -->
      <div class="grid grid-cols-4 gap-4 mt-8 pb-3 border-b border-ink">
        <span class="field-label">Party</span>
        <span class="field-label text-center">Yea</span>
        <span class="field-label text-center">Nay</span>
        <span class="field-label text-center">Not voting</span>
      </div>
      {partyRows.map(row => (
        (row.data.yea + row.data.nay + row.data.notVoting > 0) && (
          <div class="grid grid-cols-4 gap-4 py-[10px] border-b border-rule items-center">
            <span class="text-[13.5px]"><span class={`font-mono font-semibold mr-2 ${row.tone}`}>{row.mark}</span>{row.label}</span>
            <span class="text-center font-mono text-[13px] tabular">{row.data.yea}</span>
            <span class="text-center font-mono text-[13px] tabular">{row.data.nay}</span>
            <span class="text-center font-mono text-[13px] text-ink-3 tabular">{row.data.notVoting}</span>
          </div>
        )
      ))}
      <div class="grid grid-cols-4 gap-4 py-[10px] font-semibold">
        <span class="text-[13.5px]">Total</span>
        <span class="text-center font-mono text-[13px] text-yea tabular">{vote.totalYea}</span>
        <span class="text-center font-mono text-[13px] text-accent tabular">{vote.totalNay}</span>
        <span class="text-center font-mono text-[13px] text-ink-3 tabular">{notVotingTotal}</span>
      </div>
    </div>

    <!-- Individual Member Votes -->
    {memberVotes.length > 0 && (
      <div id="individual-votes" data-page-section class="pt-8">
        <h2 class="font-serif text-2xl font-medium tracking-[-0.01em] border-t border-ink pt-3 mb-5">
          Individual votes <span class="font-mono text-[11px] text-ink-3 tabular">{memberVotes.length}</span>
        </h2>

        {yeaVotes.length > 0 && (
          <div id="yea-votes" data-page-section class="mb-7">
            <h3 class="font-mono text-[11px] tracking-[0.1em] uppercase text-yea mb-3">
              Yea &middot; {yeaVotes.length}
            </h3>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {yeaVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class={`text-[12.5px] hover:underline ${partyTone(mv.party)}`}
                >
                  {mv.name} <span class="text-ink-3">({mv.party}-{mv.state})</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {nayVotes.length > 0 && (
          <div id="nay-votes" data-page-section class="mb-7">
            <h3 class="font-mono text-[11px] tracking-[0.1em] uppercase text-accent mb-3">
              Nay &middot; {nayVotes.length}
            </h3>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {nayVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class={`text-[12.5px] hover:underline ${partyTone(mv.party)}`}
                >
                  {mv.name} <span class="text-ink-3">({mv.party}-{mv.state})</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {otherVotes.length > 0 && (
          <div id="other-votes" data-page-section>
            <h3 class="font-mono text-[11px] tracking-[0.1em] uppercase text-ink-3 mb-3">
              Not voting / present &middot; {otherVotes.length}
            </h3>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {otherVotes.map(mv => (
                <a
                  href={`${base}members/${mv.bioguideId}/`}
                  class="text-[12.5px] text-ink-2 hover:underline"
                >
                  {mv.name} <span class="text-ink-3">({mv.party}-{mv.state}) &middot; {mv.voteCast}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>
