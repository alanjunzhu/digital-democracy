---
import PartyBadge from '../shared/PartyBadge.astro';
import ChamberBadge from '../shared/ChamberBadge.astro';
import type { MemberSummary } from '../../lib/types';
import { formatState } from '../../lib/utils';

interface Props {
  member: MemberSummary;
}

const { member } = Astro.props;
const base = import.meta.env.BASE_URL;
const districtLabel = member.chamber === 'House' && member.district
  ? `District ${member.district}`
  : '';
---

<a
  href={`${base}members/${member.bioguideId}/`}
  class="group flex items-start gap-3 bg-card px-4 py-[14px] hover:bg-rule-2"
>
  <!-- Frame holds the slot so a missing portrait leaves an empty plate rather
       than letting the text reflow into the gap. -->
  <div class="w-10 h-[52px] bg-rule rounded-[1px] overflow-hidden shrink-0">
    <img
      src={member.imageUrl}
      alt=""
      class="w-full h-full object-cover grayscale contrast-[1.05]"
      loading="lazy"
      onerror="this.style.display='none'"
    />
  </div>
  <div class="flex-1 min-w-0">
    <h3 class="font-serif text-[17px] leading-[1.2] font-medium group-hover:text-accent">
      {member.name}
    </h3>
    <p class="font-mono text-[11px] text-ink-3 mt-[5px]">
      {formatState(member.state)}{districtLabel ? `, ${districtLabel}` : ''}
    </p>
    <div class="flex items-center gap-[6px] mt-[7px]">
      <PartyBadge party={member.party} size="sm" />
      <ChamberBadge chamber={member.chamber} size="sm" />
    </div>
  </div>
</a>
