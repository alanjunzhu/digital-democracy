---
import { tradeDisclosureUrl, tickerQuoteUrl } from '../../../shared/finance-sources.mjs';

interface Props {
  trade: {
    transactionDate?: string;
    disclosureDate?: string;
    ticker?: string;
    assetDescription?: string;
    type?: string;
    amount?: string;
    owner?: string;
    sector?: string;
    url?: string;
    source?: string;
  };
  highlightSector?: boolean;
}

const { trade: t, highlightSector = false } = Astro.props;
const disclosureUrl = tradeDisclosureUrl(t);
const quoteUrl = tickerQuoteUrl(t.ticker);
const typeLower = (t.type || '').toLowerCase();
const typeColor = typeLower.includes('purchase')
  ? 'text-green-700 bg-green-50'
  : typeLower.includes('sale')
  ? 'text-red-700 bg-red-50'
  : 'text-gray-700 bg-gray-50';
---

<div class={`flex items-start gap-3 py-2.5 border-b border-gray-50 last:border-0 ${highlightSector ? 'bg-red-50/40 -mx-2 px-2 rounded' : ''}`}>
  <div class="flex-1 min-w-0 space-y-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="text-xs text-gray-500 whitespace-nowrap">{t.transactionDate || t.disclosureDate || '—'}</span>
      {t.ticker && t.ticker !== '--' ? (
        quoteUrl ? (
          <a href={quoteUrl} target="_blank" rel="noopener" class="font-mono text-xs font-semibold text-blue-700 hover:underline">
            {t.ticker}
          </a>
        ) : (
          <span class="font-mono text-xs font-semibold text-blue-700">{t.ticker}</span>
        )
      ) : null}
      {t.type && (
        <span class={`inline-flex rounded text-[10px] px-1.5 py-0.5 font-medium ${typeColor}`}>{t.type}</span>
      )}
      {t.amount && <span class="text-xs text-gray-600">{t.amount}</span>}
    </div>
    {t.assetDescription && (
      <p class="text-xs text-gray-800 line-clamp-2">{t.assetDescription}</p>
    )}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-[10px] text-gray-400">
      {t.owner && <span>Owner: {t.owner}</span>}
      {t.disclosureDate && t.disclosureDate !== t.transactionDate && (
        <span>Filed: {t.disclosureDate}</span>
      )}
      {t.sector && <span>Sector: {t.sector}</span>}
      {t.source && <span>Source: {t.source}</span>}
    </div>
  </div>
  {disclosureUrl ? (
    <a
      href={disclosureUrl}
      target="_blank"
      rel="noopener"
      class="shrink-0 text-[10px] text-blue-600 hover:underline whitespace-nowrap"
    >
      View filing
    </a>
  ) : (
    <span class="shrink-0 text-[10px] text-gray-300 whitespace-nowrap">No link</span>
  )}
</div>
