---
interface Props {
  filing: {
    disclosureDate?: string;
    transactionDate?: string;
    type?: string;
    url?: string;
    source?: string;
  };
}

const { filing: f } = Astro.props;
---

<div class="flex items-center justify-between gap-3 py-[10px] border-b border-rule last:border-0">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-[10px] gap-y-[2px]">
      <span class="font-mono text-[12px] text-ink tabular">
        {f.disclosureDate || f.transactionDate || '—'}
      </span>
      <span class="text-[12.5px] text-ink-2">{f.type || 'Filing'}</span>
      {f.source && <span class="font-mono text-[10px] text-ink-3">({f.source})</span>}
    </div>
  </div>
  {f.url ? (
    <a
      href={f.url}
      target="_blank"
      rel="noopener"
      class="font-mono text-[10px] tracking-[0.06em] uppercase text-accent hover:underline whitespace-nowrap"
    >
      View PDF
    </a>
  ) : (
    <span class="font-mono text-[10px] tracking-[0.06em] uppercase text-ink-3 whitespace-nowrap">
      No PDF link
    </span>
  )}
</div>
