---
interface Props {
  vote: {
    voteId: string;
    rollCallNumber?: number;
    date?: string;
    question?: string;
    billId?: string | null;
    result?: string;
    voteCast?: string;
  };
  base: string;
  billLink: (billId: string) => { href: string; local: boolean };
}

const { vote: v, base, billLink } = Astro.props;
const castLower = (v.voteCast || '').toLowerCase();
const castTone =
  castLower === 'yea' || castLower === 'aye'
    ? 'text-yea border-yea'
    : castLower === 'nay' || castLower === 'no'
      ? 'text-accent border-accent'
      : 'text-ink-3 border-rule';
const bill = v.billId ? billLink(v.billId) : null;
---

<a
  href={`${base}votes/${v.voteId}/`}
  class="flex items-start gap-3 py-3 border-b border-rule hover:border-ink-3"
>
  <div class="flex flex-col min-w-[4.5rem] shrink-0">
    <span class="font-mono text-[11.5px] font-medium text-accent tabular">#{v.rollCallNumber}</span>
    <span class="font-mono text-[10px] text-ink-3 mt-[3px] tabular">{v.date}</span>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-[13px] leading-[1.4] text-ink line-clamp-2">{v.question}</p>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-[5px]">
      {bill && (
        bill.local ? (
          <a href={bill.href} class="font-mono text-[10.5px] text-accent">{v.billId}</a>
        ) : (
          <span class="font-mono text-[10.5px] text-ink-3">{v.billId}</span>
        )
      )}
      {v.result && (
        <span class="font-mono text-[10.5px] tracking-[0.06em] uppercase text-ink-3">
          {v.result}
        </span>
      )}
    </div>
  </div>
  {v.voteCast && (
    <span
      class:list={[
        'shrink-0 inline-flex items-center rounded border px-2 py-[3px] font-mono text-[10px] tracking-[0.06em] uppercase whitespace-nowrap',
        castTone,
      ]}
    >
      {v.voteCast}
    </span>
  )}
</a>
