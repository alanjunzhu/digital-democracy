---
interface Props {
  party: string;
  size?: 'sm' | 'md';
}

const { party, size = 'md' } = Astro.props;

const tone: Record<string, string> = {
  Democratic: 'bg-dem-soft text-dem',
  Republican: 'bg-rep-soft text-rep',
  Independent: 'bg-ind-soft text-ind',
};

const label = party === 'Democratic' ? 'D' : party === 'Republican' ? 'R' : 'I';
const toneClass = tone[party] || 'bg-rule-2 text-ink-2';
const sizeClass = size === 'sm' ? 'w-[15px] h-[15px] text-[9px]' : 'w-[17px] h-[17px] text-[10px]';
---

<span
  class:list={[
    'inline-flex items-center justify-center rounded font-mono font-semibold shrink-0',
    toneClass,
    sizeClass,
  ]}
  title={party}
>
  {label}
</span>
