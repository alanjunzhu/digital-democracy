---
import MemberTradeRow from './MemberTradeRow.astro';

interface Props {
  trades: any[];
  previewCount?: number;
  moreLabel?: string;
  highlightSector?: boolean;
}

const {
  trades,
  previewCount = 10,
  moreLabel = 'transactions',
  highlightSector = false,
} = Astro.props;

const preview = trades.slice(0, previewCount);
const rest = trades.slice(previewCount);
---

<div class="space-y-0.5">
  {preview.map((trade) => (
    <MemberTradeRow trade={trade} highlightSector={highlightSector} />
  ))}
  {rest.length > 0 && (
    <details class="group">
      <summary class="cursor-pointer font-mono text-[10px] tracking-[0.06em] uppercase text-accent hover:underline pl-1 py-2 select-none">
        Show {rest.length} more {moreLabel}
      </summary>
      <div class="space-y-0.5 pt-1 border-l-2 border-rule pl-3">
        {rest.map((trade) => (
          <MemberTradeRow trade={trade} highlightSector={highlightSector} />
        ))}
      </div>
    </details>
  )}
</div>
