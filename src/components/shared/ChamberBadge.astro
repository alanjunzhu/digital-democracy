---
interface Props {
  chamber: 'Senate' | 'House';
  size?: 'sm' | 'md';
}

const { chamber, size = 'md' } = Astro.props;
const sizeClass = size === 'sm' ? 'text-[10px]' : 'text-[10.5px]';
---

<span class:list={['font-mono tracking-[0.06em] uppercase text-ink-3', sizeClass]}>
  {chamber}
</span>
