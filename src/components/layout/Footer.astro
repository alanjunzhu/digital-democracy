---
const year = new Date().getFullYear();
---

<footer class="bg-footer-bg text-footer-fg mt-auto">
  <div class="max-w-measure mx-auto p-10">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,1fr))] gap-12">
      <div>
        <h3 class="font-serif text-[21px] font-medium mb-[10px]">Congress Tracker</h3>
        <p class="text-[13.5px] leading-[1.6] opacity-60 max-w-[44ch]">
          An open-source tool for tracking US Congress activity. Built with data from
          Congress.gov and other public sources.
        </p>
      </div>
      <div>
        <h3 class="font-mono text-[11px] tracking-[0.1em] uppercase font-medium opacity-55 mb-3">
          Data sources
        </h3>
        <ul class="flex flex-col gap-2 text-[13.5px]">
          <li>
            <a
              href="https://api.congress.gov"
              class="opacity-85 hover:opacity-100 hover:text-footer-fg"
              target="_blank"
              rel="noopener">Congress.gov API</a
            >
          </li>
          <li>
            <a
              href="https://github.com/unitedstates/congress-legislators"
              class="opacity-85 hover:opacity-100 hover:text-footer-fg"
              target="_blank"
              rel="noopener">unitedstates/congress-legislators</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-[11px] tracking-[0.1em] uppercase font-medium opacity-55 mb-3">
          Links
        </h3>
        <ul class="flex flex-col gap-2 text-[13.5px]">
          <li>
            <a
              href="https://github.com/alanjunzhu/digital-democracy"
              class="opacity-85 hover:opacity-100 hover:text-footer-fg"
              target="_blank"
              rel="noopener">Source code</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div
      class="border-t border-white/[0.14] mt-9 pt-4 flex flex-wrap justify-between gap-6 font-mono text-[11px] tracking-[0.04em] opacity-50"
    >
      <span>&copy; {year} Congress Tracker</span>
      <span>Data is public domain</span>
    </div>
  </div>
</footer>
