---
import membersIndex from '../../../data/members/index.json';

const base = import.meta.env.BASE_URL;
const navItems = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}members/`, label: 'Members' },
  { href: `${base}bills/`, label: 'Bills' },
  { href: `${base}votes/`, label: 'Votes' },
  { href: `${base}committees/`, label: 'Committees' },
  { href: `${base}policy/`, label: 'Policy' },
  { href: `${base}finances/`, label: 'Finances' },
  { href: `${base}analytics/`, label: 'Analytics' },
];

const current = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '');
  return target === '' || target === base.replace(/\/+$/, '')
    ? current === target
    : current === target || current.startsWith(`${target}/`);
};

const updated = new Date(membersIndex.lastUpdated).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<div class="border-b border-rule bg-paper">
  <div
    class="max-w-measure mx-auto px-10 h-[34px] flex items-center justify-between gap-6"
  >
    <span class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3">
      {membersIndex.congress}th Congress &middot; Public records, updated {updated}
    </span>
    <div class="flex items-center gap-[18px]">
      <a
        href="https://github.com/alanjunzhu/digital-democracy"
        target="_blank"
        rel="noopener"
        class="font-mono text-[11px] tracking-[0.06em] uppercase text-ink-3">Source</a
      >
      <button
        id="theme-toggle"
        type="button"
        class="appearance-none bg-transparent border border-rule rounded px-[9px] py-[3px] font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2 cursor-pointer hover:border-ink-3 hover:text-ink"
        aria-label="Toggle color theme"><span data-theme-label>Dark</span></button
      >
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-paper border-b border-ink">
  <div
    class="max-w-measure mx-auto px-10 flex items-baseline justify-between gap-10 h-[66px]"
  >
    <a
      href={base}
      class="font-serif text-[27px] font-medium tracking-[-0.015em] text-ink whitespace-nowrap"
      >Congress Tracker</a
    >
    <nav class="hidden md:flex items-baseline gap-[22px] pb-[2px]">
      {
        navItems.map(item => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-[13px] pb-[2px]',
              isActive(item.href)
                ? 'font-semibold text-ink border-b-2 border-accent'
                : 'font-medium text-ink-2 hover:text-accent',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-ink-2 hover:text-ink"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
  <nav id="mobile-menu" class="md:hidden hidden px-10 pb-4">
    {
      navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'block py-2 text-[13px]',
            isActive(item.href) ? 'font-semibold text-ink' : 'font-medium text-ink-2 hover:text-accent',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const label = toggle?.querySelector('[data-theme-label]');

  const paint = () => {
    if (label) {
      label.textContent = root.getAttribute('data-cd-theme') === 'dark' ? 'Light' : 'Dark';
    }
  };

  paint();

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-cd-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-cd-theme', next);
    try {
      localStorage.setItem('ct:theme', next);
    } catch {}
    paint();
  });
</script>
