---
import { buildPageIndex } from '../../../shared/page-index.mjs';

interface Props {
  /**
   * Every section the page can render, in the order it renders them. `when`
   * carries the same condition that puts the section on the page, so a member
   * with no trades gets no trading links.
   */
  sections: Array<{
    id?: string;
    label: string;
    when?: unknown;
    count?: number | null;
    depth?: number;
  }>;
  title?: string;
}

const { sections, title = 'On this page' } = Astro.props;
const entries = buildPageIndex(sections);
---

{entries.length > 0 && (
  <div
    data-page-index
    class="fixed left-3 bottom-6 sm:top-24 sm:bottom-auto z-40 flex flex-col-reverse sm:flex-col items-start gap-2 print:hidden"
  >
    <button
      type="button"
      data-page-index-toggle
      aria-expanded="false"
      aria-controls="page-index-panel"
      title={`${title} (${entries.length} sections)`}
      class="inline-flex items-center gap-[7px] rounded border border-rule bg-paper px-[9px] py-[4px] font-mono text-[10px] tracking-[0.1em] uppercase text-ink-3 hover:border-ink-3 hover:text-ink focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--navy)]"
    >
      <span data-page-index-rule class="inline-block h-px w-3 bg-ink-3" aria-hidden="true"></span>
      <span>Contents</span>
      <span class="tabular text-ink-3">{entries.length}</span>
    </button>

    <nav
      id="page-index-panel"
      data-page-index-panel
      aria-label={title}
      class="hidden w-[232px] max-w-[calc(100vw-1.5rem)] max-h-[min(70vh,34rem)] overflow-y-auto border border-rule bg-card"
    >
      <p class="field-label border-b border-ink px-3 py-[9px]">{title}</p>
      <ol>
        {entries.map(entry => (
          <li>
            <a
              href={`#${entry.id}`}
              data-page-index-link={entry.id}
              class:list={[
                'flex items-baseline gap-3 border-b border-rule px-3 py-[9px] hover:bg-rule-2',
                entry.depth === 1 ? 'pl-6 text-[11.5px] text-ink-3' : 'text-[12.5px] text-ink-2',
              ]}
            >
              <span class="flex-1 leading-snug">{entry.label}</span>
              {entry.count != null && (
                <span class="shrink-0 font-mono text-[10px] text-ink-3 tabular">{entry.count}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
)}

<style>
  /* The rule grows into an open bracket when the panel is showing — the only
     motion in the system, and it stays within the hairline vocabulary. */
  [data-page-index-rule] {
    transition: width 0.2s ease;
  }
  [data-page-index-toggle]:hover [data-page-index-rule],
  [data-page-index-toggle][aria-expanded='true'] [data-page-index-rule] {
    width: 1.25rem;
  }
  [data-page-index-toggle][aria-expanded='true'] {
    border-color: var(--ink);
    color: var(--ink);
  }
  /* Current section is marked the way a caveat note is: a rule in the margin. */
  [data-page-index-link][aria-current='true'] {
    background-color: var(--rule-2);
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--red);
  }
  [data-page-index-panel] li:last-child a {
    border-bottom: none;
  }
</style>

<script>
  const root = document.querySelector('[data-page-index]');
  const toggle = root?.querySelector('[data-page-index-toggle]');
  const panel = root?.querySelector('[data-page-index-panel]');

  if (root && toggle instanceof HTMLElement && panel instanceof HTMLElement) {
    const STORAGE_KEY = 'page-index:open';
    // left-3 offset + the panel's own width + room to breathe.
    const PANEL_CLEARANCE = 256;
    const links = Array.from(panel.querySelectorAll('[data-page-index-link]')) as HTMLAnchorElement[];
    const targets = links
      .map(link => {
        const id = link.getAttribute('data-page-index-link') || '';
        return { link, section: document.getElementById(id) };
      })
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry.section !== null);

    function readPreference() {
      try {
        return window.localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    }

    function writePreference(open: boolean) {
      try {
        window.localStorage.setItem(STORAGE_KEY, open ? 'open' : 'closed');
      } catch {
        /* private browsing: the panel just forgets between pages */
      }
    }

    // Docked only when the page's gutter can hold the panel beside the text;
    // on anything narrower it opens over the content, so it stays shut until
    // someone asks for it.
    function fitsBesideContent() {
      const content = document.querySelector('main')?.firstElementChild;
      if (!(content instanceof HTMLElement)) return false;
      const gutter =
        content.getBoundingClientRect().left +
        parseFloat(window.getComputedStyle(content).paddingLeft || '0');
      return gutter >= PANEL_CLEARANCE;
    }

    function isOpen() {
      return toggle.getAttribute('aria-expanded') === 'true';
    }

    function setOpen(open: boolean) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.classList.toggle('hidden', !open);
    }

    let docked = fitsBesideContent();
    setOpen(docked && readPreference() !== 'closed');

    toggle.addEventListener('click', () => {
      const open = !isOpen();
      setOpen(open);
      if (docked) writePreference(open);
    });

    for (const { link } of targets) {
      link.addEventListener('click', () => {
        if (!docked) setOpen(false);
      });
    }

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && isOpen() && !docked) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', event => {
      if (!isOpen() || docked) return;
      const target = event.target;
      if (target instanceof Node && !root.contains(target)) setOpen(false);
    });

    // The section under the sticky header is the one being read.
    function markCurrent() {
      let current = targets[0];
      for (const entry of targets) {
        if (entry.section.getBoundingClientRect().top <= 96) current = entry;
      }
      const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
      if (atBottom) current = targets[targets.length - 1];

      for (const { link } of targets) {
        if (link === current?.link) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    }

    let queued = false;
    function scheduleMark() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        markCurrent();
      });
    }

    window.addEventListener('resize', () => {
      const nowDocked = fitsBesideContent();
      if (nowDocked !== docked) {
        docked = nowDocked;
        setOpen(docked && readPreference() !== 'closed');
      }
      scheduleMark();
    });

    if (targets.length > 0) {
      markCurrent();
      window.addEventListener('scroll', scheduleMark, { passive: true });
    }
  }
</script>
